{
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|0": "Squeak! Hello! I",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|1": "am a kith, a...",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|2": "Er, no. Not quite.",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|3": "The name's PIP!",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|4": "I built the BOX",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|5": "NET! And now I'm",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|6": "stuck in fur and",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|7": "whiskers. Stop",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|8": "grinning, please.",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|9": "A lab trial went",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|10": "sideways and my",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|11": "body got blended",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|12": "with a kith's!",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|13": "Will you lend me",
"text/BillsHouse.asm|_BillsHouseBillImNotAPokemonText|14": "a hand, friend?",
"text/BillsHouse.asm|_BillsHouseBillUseSeparationSystemText|0": "I'll hop into the",
"text/BillsHouse.asm|_BillsHouseBillUseSeparationSystemText|1": "pod. Then you run",
"text/BillsHouse.asm|_BillsHouseBillUseSeparationSystemText|2": "the SPLITTER app",
"text/BillsHouse.asm|_BillsHouseBillUseSeparationSystemText|3": "on my computer",
"text/BillsHouse.asm|_BillsHouseBillUseSeparationSystemText|4": "over there!",
"text/BillsHouse.asm|_BillsHouseBillNoYouGottaHelpText|0": "Aw, don't leave a",
"text/BillsHouse.asm|_BillsHouseBillNoYouGottaHelpText|1": "fella stuck with",
"text/BillsHouse.asm|_BillsHouseBillNoYouGottaHelpText|2": "a tail forever!",
"text/BillsHouse.asm|_BillsHouseBillNoYouGottaHelpText|3": "Pretty please?",
"text/BillsHouse.asm|_BillsHouseBillNoYouGottaHelpText|4": "With seeds on top?",
"text/BillsHouse.asm|_BillsHouseBillNoYouGottaHelpText|5": "...Yes? Great!",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|0": "PIP: I'm me again!",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|1": "Fingers! Thumbs!",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|2": "You're a hero!",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|3": "Hey, want a tour",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|4": "of my rare kith",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|5": "archive? It's...",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|6": "No? Not even a",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|7": "peek? Oh, fine.",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|8": "Well, I can't let",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|9": "you leave with",
"text/BillsHouse.asm|_BillsHouseBillThankYouText|10": "nothing. Take it!",
"text/BillsHouse.asm|_SSTicketReceivedText|0": "<PLAYER> got",
"text/BillsHouse.asm|_SSTicketReceivedText|1": "a @",
"text/BillsHouse.asm|_SSTicketNoRoomText|0": "Bag's bulging,",
"text/BillsHouse.asm|_SSTicketNoRoomText|1": "pal. Clear room!",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|0": "The S.S.WREN is",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|1": "moored down in",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|2": "PORTSALT, packed",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|3": "with TAMERS from",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|4": "all over the map.",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|5": "I got a fancy",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|6": "invite, but a",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|7": "ballroom gives me",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|8": "hives. Take my",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|9": "pass and have fun",
"text/BillsHouse.asm|_BillsHouseBillWhyDontYouGoInsteadOfMeText|10": "in my place!",
"text/BillsHouse.asm|_BillsHouseBillCheckOutMyRarePokemonText|0": "PIP: Psst! My",
"text/BillsHouse.asm|_BillsHouseBillCheckOutMyRarePokemonText|1": "computer's got a",
"text/BillsHouse.asm|_BillsHouseBillCheckOutMyRarePokemonText|2": "folder of rare",
"text/BillsHouse.asm|_BillsHouseBillCheckOutMyRarePokemonText|3": "kith. Have a look!"
}