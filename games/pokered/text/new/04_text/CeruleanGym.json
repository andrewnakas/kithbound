{
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|0": "Hey, drip-dry!",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|1": "Haven't seen you.",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|2": "Real TAMERS pick",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|3": "a style and live",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|4": "by it, start to",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|5": "finish, you know?",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|6": "So what's yours?",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|7": "How do you build",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|8": "your team?",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|9": "Mine's simple:",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|10": "dive in hard with",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|11": "TIDE kith and",
"text/CeruleanGym.asm|_CeruleanGymMistyPreBattleText|12": "never let up!",
"text/CeruleanGym.asm|_CeruleanGymMistyTM11ExplanationText|0": "SC11 holds the",
"text/CeruleanGym.asm|_CeruleanGymMistyTM11ExplanationText|1": "skill FOAM RAY!",
"text/CeruleanGym.asm|_CeruleanGymMistyTM11ExplanationText|2": "Best on kith that",
"text/CeruleanGym.asm|_CeruleanGymMistyTM11ExplanationText|3": "love the water!",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|0": "With a DEW BADGE,",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|1": "kith at L30 and",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|2": "under listen up!",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|3": "Even ones that",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|4": "came from swaps!",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|5": "Oh, and kith can",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|6": "CHOP outside of",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|7": "battle now!",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|8": "Slice thin trees",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|9": "out of your way",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|10": "to find new paths!",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|11": "Here, take my",
"text/CeruleanGym.asm|_CeruleanGymMistyCascadeBadgeInfoText|12": "pet SC too!",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedTM11Text|0": "<PLAYER> got",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedTM11Text|1": "SC11!@",
"text/CeruleanGym.asm|_CeruleanGymMistyTM11NoRoomText|0": "Your bag's soaked",
"text/CeruleanGym.asm|_CeruleanGymMistyTM11NoRoomText|1": "full! Free a slot!",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedCascadeBadgeText|0": "Pfft!",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedCascadeBadgeText|1": "I got swamped!",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedCascadeBadgeText|2": "Okay, fair's fair!",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedCascadeBadgeText|3": "Here's the DEW",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedCascadeBadgeText|4": "BADGE. You earned",
"text/CeruleanGym.asm|_CeruleanGymMistyReceivedCascadeBadgeText|5": "every drop of it!@",
"text/CeruleanGym.asm|_CeruleanGymBattleText1|0": "Skip MAREN for",
"text/CeruleanGym.asm|_CeruleanGymBattleText1|1": "now. Try me first!",
"text/CeruleanGym.asm|_CeruleanGymBattleText1|2": "I'm plenty!",
"text/CeruleanGym.asm|_CeruleanGymEndBattleText1|0": "Totally",
"text/CeruleanGym.asm|_CeruleanGymEndBattleText1|1": "swamped!",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText1|0": "Battle lots of",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText1|1": "TAMERS. That's how",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText1|2": "you learn where",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText1|3": "you really stand.",
"text/CeruleanGym.asm|_CeruleanGymBattleText2|0": "Sploosh!",
"text/CeruleanGym.asm|_CeruleanGymBattleText2|1": "Lane one, me!",
"text/CeruleanGym.asm|_CeruleanGymBattleText2|2": "Ready, set, go!",
"text/CeruleanGym.asm|_CeruleanGymEndBattleText2|0": "Belly",
"text/CeruleanGym.asm|_CeruleanGymEndBattleText2|1": "flop!",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText2|0": "MAREN trains in",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText2|1": "the pool all day!",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText2|2": "Some newbie won't",
"text/CeruleanGym.asm|_CeruleanGymAfterBattleText2|3": "sink her!",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|0": "Hey there, future",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|1": "champ!",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|2": "Lean in close!",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|3": "MAREN fights with",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|4": "TIDE kith, and she",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|5": "hits like a wave!",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|6": "LEAF kith soak up",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|7": "TIDE moves like a",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|8": "thirsty garden!",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|9": "VOLT kith fry her",
"text/CeruleanGym.asm|_CeruleanGymGymGuideChampInMakingText|10": "team fast, too!",
"text/CeruleanGym.asm|_CeruleanGymGymGuideBeatMistyText|0": "MAREN's beaten!",
"text/CeruleanGym.asm|_CeruleanGymGymGuideBeatMistyText|1": "Told you, right?",
"text/CeruleanGym.asm|_CeruleanGymGymGuideBeatMistyText|2": "Stick with me,",
"text/CeruleanGym.asm|_CeruleanGymGymGuideBeatMistyText|3": "pal. We're a fine",
"text/CeruleanGym.asm|_CeruleanGymGymGuideBeatMistyText|4": "pair, us two!"
}