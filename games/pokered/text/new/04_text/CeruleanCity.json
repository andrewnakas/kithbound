{
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|0": "<RIVAL>: Well,",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|2": "Look who finally",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|3": "crawled up from",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|4": "the sticks!",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|5": "My team's stacked",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|6": "now. Tough ones,",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|7": "clever ones, all",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|8": "top tier kith!",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|9": "Come on, show me",
"text/CeruleanCity.asm|_CeruleanCityRivalPreBattleText|10": "your scrawny crew,",
"text/CeruleanCity.asm|_CeruleanCityRivalDefeatedText|0": "Okay, okay!",
"text/CeruleanCity.asm|_CeruleanCityRivalDefeatedText|1": "Ease off! You",
"text/CeruleanCity.asm|_CeruleanCityRivalDefeatedText|2": "made your point!",
"text/CeruleanCity.asm|_CeruleanCityRivalVictoryText|0": "Hah!",
"text/CeruleanCity.asm|_CeruleanCityRivalVictoryText|1": "Too slow, too",
"text/CeruleanCity.asm|_CeruleanCityRivalVictoryText|2": "small, too you!",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|0": "<RIVAL>: Bet you",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|1": "can't guess this.",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|2": "I dropped by PIP's",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|3": "place and made him",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|4": "open his rare kith",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|5": "files!",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|6": "My KITHLOG got",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|7": "a whole lot",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|8": "fatter for it!",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|9": "Everybody knows",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|10": "PIP. He's nuts for",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|11": "kith, big time!",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|12": "He's the brain",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|13": "who built the BOX",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|14": "NET, you know!",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|15": "You stash kith in",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|16": "his BOX NET too,",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|17": "so say thanks!",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|18": "Anyway, I'm off.",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|19": "Can't wait around",
"text/CeruleanCity.asm|_CeruleanCityRivalIWentToBillsText|20": "for dawdlers!",
"text/CeruleanCity.asm|_CeruleanCityRocketText|0": "Whoa! Back off!",
"text/CeruleanCity.asm|_CeruleanCityRocketText|1": "This lawn isn't",
"text/CeruleanCity.asm|_CeruleanCityRocketText|2": "yours! Wait, me?",
"text/CeruleanCity.asm|_CeruleanCityRocketText|3": "I'm just admiring",
"text/CeruleanCity.asm|_CeruleanCityRocketText|4": "the hedges! Can't",
"text/CeruleanCity.asm|_CeruleanCityRocketText|5": "a guy do that?",
"text/CeruleanCity.asm|_CeruleanCityRocketReceivedTM28Text|0": "<PLAYER> got back",
"text/CeruleanCity.asm|_CeruleanCityRocketReceivedTM28Text|1": "SC28!@",
"text/CeruleanCity.asm|_CeruleanCityRocketIBetterGetMovingText|0": "Gotta scram!",
"text/CeruleanCity.asm|_CeruleanCityRocketIBetterGetMovingText|1": "See ya never!@",
"text/CeruleanCity.asm|_CeruleanCityRocketTM28NoRoomText|0": "Your bag's full!",
"text/CeruleanCity.asm|_CeruleanCityRocketTM28NoRoomText|1": "Clear a space!",
"text/CeruleanCity.asm|_CeruleanCityRocketTM28NoRoomText|2": "I can't bolt till",
"text/CeruleanCity.asm|_CeruleanCityRocketTM28NoRoomText|3": "you take it!",
"text/CeruleanCity.asm|_CeruleanCityRocketIGiveUpText|0": "Okay! Okay!",
"text/CeruleanCity.asm|_CeruleanCityRocketIGiveUpText|1": "Uncle! I'll go",
"text/CeruleanCity.asm|_CeruleanCityRocketIGiveUpText|2": "without a fuss!",
"text/CeruleanCity.asm|_CeruleanCityRocketIllReturnTheTMText|0": "Fine! Take back",
"text/CeruleanCity.asm|_CeruleanCityRocketIllReturnTheTMText|1": "the stolen SC!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerMText|0": "A fellow TAMER?",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerMText|1": "Snaring, battling,",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerMText|2": "healing, repeat.",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerMText|3": "It wears you out.",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd1Text|0": "That shrub by the",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd1Text|1": "SUPPLY blocks the",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd1Text|2": "path, huh?",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd1Text|3": "Maybe some other",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd1Text|4": "route gets past.",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd2Text|0": "A KITHLOG, huh?",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd2Text|1": "Logging every kith",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd2Text|2": "there is? Cute",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd2Text|3": "hobby, I suppose.",
"text/CeruleanCity.asm|_CeruleanCityGuardText|0": "This house got",
"text/CeruleanCity.asm|_CeruleanCityGuardText|1": "burgled at night.",
"text/CeruleanCity.asm|_CeruleanCityGuardText|2": "Smells like GLOAM",
"text/CeruleanCity.asm|_CeruleanCityGuardText|3": "to me. Who else",
"text/CeruleanCity.asm|_CeruleanCityGuardText|4": "would sink so",
"text/CeruleanCity.asm|_CeruleanCityGuardText|5": "low, so loudly?",
"text/CeruleanCity.asm|_CeruleanCityGuardText|6": "Even the town",
"text/CeruleanCity.asm|_CeruleanCityGuardText|7": "watch can't keep",
"text/CeruleanCity.asm|_CeruleanCityGuardText|8": "GLOAM in check!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroUseSonicboomText|0": "DAWDLORD, go!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroUseSonicboomText|1": "Use SHOCKWAVE!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroUseSonicboomText|2": "DAWDLORD! Hello?",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroUseSonicboomText|3": "Eyes over here!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroPunchText|0": "DAWDLORD, swing!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroPunchText|1": "Ugh! Missed by a",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroPunchText|2": "mile again!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|0": "DAWDLORD, TUCK IN!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|1": "No, the OTHER way!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|2": "Why won't it",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|3": "just listen?!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|4": "Kith heed you only",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|5": "as much as your",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|6": "skill as a TAMER",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF1SlowbroWithdrawText|7": "has earned!",
"text/CeruleanCity.asm|_CeruleanCitySlowbroTookASnoozeText|0": "DAWDLORD dozed",
"text/CeruleanCity.asm|_CeruleanCitySlowbroTookASnoozeText|1": "off mid-order...",
"text/CeruleanCity.asm|_CeruleanCitySlowbroIsLoafingAroundText|0": "DAWDLORD is",
"text/CeruleanCity.asm|_CeruleanCitySlowbroIsLoafingAroundText|1": "lazing about...",
"text/CeruleanCity.asm|_CeruleanCitySlowbroTurnedAwayText|0": "DAWDLORD looked",
"text/CeruleanCity.asm|_CeruleanCitySlowbroTurnedAwayText|1": "elsewhere...",
"text/CeruleanCity.asm|_CeruleanCitySlowbroIgnoredOrdersText|0": "DAWDLORD paid",
"text/CeruleanCity.asm|_CeruleanCitySlowbroIgnoredOrdersText|1": "no attention...",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF2Text|0": "I'm saving for a",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF2Text|1": "shiny ROADSTER!",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF2Text|2": "It'll live in my",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF2Text|3": "room. No mud on",
"text/CeruleanCity.asm|_CeruleanCityCooltrainerF2Text|4": "it, ever!",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|0": "That's the DEEP",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|1": "GROTTO. Kith in",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|2": "there are scary",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|3": "strong!",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|4": "Only the CROWN",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|5": "LEAGUE's champ",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|6": "may set foot in",
"text/CeruleanCity.asm|_CeruleanCitySuperNerd3Text|7": "it. Rules!",
"text/CeruleanCity.asm|_CeruleanCitySignText|0": "BRINEFORD",
"text/CeruleanCity.asm|_CeruleanCitySignText|1": "Where the River",
"text/CeruleanCity.asm|_CeruleanCitySignText|2": "Meets the Bridge",
"text/CeruleanCity.asm|_CeruleanCitySignText|3": "of Many Lanterns",
"text/CeruleanCity.asm|_CeruleanCityTrainerTipsText|0": "TAMER TIPS",
"text/CeruleanCity.asm|_CeruleanCityTrainerTipsText|1": "Don't want a kith",
"text/CeruleanCity.asm|_CeruleanCityTrainerTipsText|2": "to change shape?",
"text/CeruleanCity.asm|_CeruleanCityTrainerTipsText|3": "Hold B while it",
"text/CeruleanCity.asm|_CeruleanCityTrainerTipsText|4": "glows to stop it!",
"text/CeruleanCity.asm|_CeruleanCityBikeShopSign|0": "Roll over grass",
"text/CeruleanCity.asm|_CeruleanCityBikeShopSign|1": "and through caves!",
"text/CeruleanCity.asm|_CeruleanCityBikeShopSign|2": "WHEELWORKS",
"text/CeruleanCity.asm|_CeruleanCityGymSign|0": "BRINEFORD",
"text/CeruleanCity.asm|_CeruleanCityGymSign|1": "KITH GYM",
"text/CeruleanCity.asm|_CeruleanCityGymSign|2": "LEADER: MAREN",
"text/CeruleanCity.asm|_CeruleanCityGymSign|3": "The Rough-and-",
"text/CeruleanCity.asm|_CeruleanCityGymSign|4": "Tumble Diver!"
}