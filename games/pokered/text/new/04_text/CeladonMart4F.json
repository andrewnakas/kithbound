{
"text/CeladonMart4F.asm|_CeladonMart4FSuperNerdText|0": "A DECOY DOLL for",
"text/CeladonMart4F.asm|_CeladonMart4FSuperNerdText|1": "my sweetheart. She",
"text/CeladonMart4F.asm|_CeladonMart4FSuperNerdText|2": "likes cute things.",
"text/CeladonMart4F.asm|_CeladonMart4FYoungsterText|0": "Here's a neat",
"text/CeladonMart4F.asm|_CeladonMart4FYoungsterText|1": "trick I learned.",
"text/CeladonMart4F.asm|_CeladonMart4FYoungsterText|2": "Toss a DECOY DOLL",
"text/CeladonMart4F.asm|_CeladonMart4FYoungsterText|3": "at a wild kith and",
"text/CeladonMart4F.asm|_CeladonMart4FYoungsterText|4": "slip off while it",
"text/CeladonMart4F.asm|_CeladonMart4FYoungsterText|5": "stares at it!",
"text/CeladonMart4F.asm|_CeladonMart4FCurrentFloorSignText|0": "Say it with a",
"text/CeladonMart4F.asm|_CeladonMart4FCurrentFloorSignText|1": "present!",
"text/CeladonMart4F.asm|_CeladonMart4FCurrentFloorSignText|2": "4F: GIFT NOOK",
"text/CeladonMart4F.asm|_CeladonMart4FCurrentFloorSignText|3": "Shape Shift Sale!",
"text/CeladonMart4F.asm|_CeladonMart4FCurrentFloorSignText|4": "Every SHARD kind",
"text/CeladonMart4F.asm|_CeladonMart4FCurrentFloorSignText|5": "is in stock!"
}