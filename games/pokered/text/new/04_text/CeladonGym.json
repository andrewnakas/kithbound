{
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|0": "Mmm... the vines",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|1": "are humming today.",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|2": "Can you hear them?",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|3": "...Goodness. I was",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|4": "off in the ivy",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|5": "somewhere. Hello.",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|6": "I'm FLORA. This",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|7": "greenhouse is my",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|8": "GYM, and my home.",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|9": "Here we tend the",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|10": "hanging gardens.",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|11": "Every kith of",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|12": "mine is LEAF-type.",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|13": "A challenge? Oh!",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|14": "Forgive me, I",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|15": "thought you came",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|16": "for cuttings.",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|17": "Then let us grow",
"text/CeladonGym.asm|_CeladonGymErikaPreBattleText|18": "a battle, gently.",
"text/CeladonGym.asm|_CeladonGymErikaReceivedRainbowBadgeText|0": "Oh my.",
"text/CeladonGym.asm|_CeladonGymErikaReceivedRainbowBadgeText|1": "The petals fell.",
"text/CeladonGym.asm|_CeladonGymErikaReceivedRainbowBadgeText|2": "Your roots run",
"text/CeladonGym.asm|_CeladonGymErikaReceivedRainbowBadgeText|3": "deep, TAMER.",
"text/CeladonGym.asm|_CeladonGymErikaReceivedRainbowBadgeText|4": "Please wear this",
"text/CeladonGym.asm|_CeladonGymErikaReceivedRainbowBadgeText|5": "BLOOM BADGE.",
"text/CeladonGym.asm|_CeladonGymErikaPostBattleAdviceText|0": "A KITHLOG? You",
"text/CeladonGym.asm|_CeladonGymErikaPostBattleAdviceText|1": "log every kith?",
"text/CeladonGym.asm|_CeladonGymErikaPostBattleAdviceText|2": "How diligent.",
"text/CeladonGym.asm|_CeladonGymErikaPostBattleAdviceText|3": "I only keep the",
"text/CeladonGym.asm|_CeladonGymErikaPostBattleAdviceText|4": "kith whose colors",
"text/CeladonGym.asm|_CeladonGymErikaPostBattleAdviceText|5": "make my garden",
"text/CeladonGym.asm|_CeladonGymErikaPostBattleAdviceText|6": "sing, I confess.",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|0": "With the BLOOM",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|1": "BADGE, kith up to",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|2": "L50 will listen.",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|3": "Your kith may",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|4": "also use HEAVE",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|5": "to shove boulders",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|6": "outside battle.",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|7": "And one cutting",
"text/CeladonGym.asm|_CeladonGymRainbowBadgeInfoText|8": "more, for you.",
"text/CeladonGym.asm|_CeladonGymReceivedTM21Text|0": "<PLAYER> got",
"text/CeladonGym.asm|_TM21ExplanationText|0": "SC21 holds the",
"text/CeladonGym.asm|_TM21ExplanationText|1": "skill DEEP SAP.",
"text/CeladonGym.asm|_TM21ExplanationText|2": "It drinks from",
"text/CeladonGym.asm|_TM21ExplanationText|3": "the foe and gives",
"text/CeladonGym.asm|_TM21ExplanationText|4": "half back to your",
"text/CeladonGym.asm|_TM21ExplanationText|5": "own kith as HP.",
"text/CeladonGym.asm|_CeladonGymTM21NoRoomText|0": "Your bag is full.",
"text/CeladonGym.asm|_CeladonGymTM21NoRoomText|1": "Free up a slot.",
"text/CeladonGym.asm|_CeladonGymBattleText2|0": "Halt!",
"text/CeladonGym.asm|_CeladonGymBattleText2|1": "Muddy boots off",
"text/CeladonGym.asm|_CeladonGymBattleText2|2": "the moss, please!",
"text/CeladonGym.asm|_CeladonGymEndBattleText2|0": "So",
"text/CeladonGym.asm|_CeladonGymEndBattleText2|1": "pushy!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText2|0": "Hmph!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText2|1": "FLORA will prune",
"text/CeladonGym.asm|_CeladonGymAfterBattleText2|2": "you right back!",
"text/CeladonGym.asm|_CeladonGymBattleText3|0": "Finally, a",
"text/CeladonGym.asm|_CeladonGymBattleText3|1": "visitor!",
"text/CeladonGym.asm|_CeladonGymEndBattleText3|0": "My",
"text/CeladonGym.asm|_CeladonGymEndBattleText3|1": "petals!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText3|0": "LEAF kith drink",
"text/CeladonGym.asm|_CeladonGymAfterBattleText3|1": "up TIDE attacks",
"text/CeladonGym.asm|_CeladonGymAfterBattleText3|2": "like rainwater!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText3|3": "STONE, SOIL kith",
"text/CeladonGym.asm|_CeladonGymAfterBattleText3|4": "wilt before them",
"text/CeladonGym.asm|_CeladonGymAfterBattleText3|5": "too, you'll see!",
"text/CeladonGym.asm|_CeladonGymBattleText4|0": "You were peeking",
"text/CeladonGym.asm|_CeladonGymBattleText4|1": "through the vines!",
"text/CeladonGym.asm|_CeladonGymEndBattleText4|1": "startled!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText4|0": "Not a snoop? Oh.",
"text/CeladonGym.asm|_CeladonGymAfterBattleText4|1": "Folks press their",
"text/CeladonGym.asm|_CeladonGymAfterBattleText4|2": "noses to glass!",
"text/CeladonGym.asm|_CeladonGymBattleText5|0": "Behold my leafy",
"text/CeladonGym.asm|_CeladonGymBattleText5|1": "darlings!",
"text/CeladonGym.asm|_CeladonGymBattleText5|2": "A little sun, a",
"text/CeladonGym.asm|_CeladonGymBattleText5|3": "little water!",
"text/CeladonGym.asm|_CeladonGymEndBattleText5|0": "Wilted!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText5|0": "Only LEAF kith",
"text/CeladonGym.asm|_CeladonGymAfterBattleText5|1": "grow in this",
"text/CeladonGym.asm|_CeladonGymAfterBattleText5|2": "greenhouse!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText5|3": "Between battles",
"text/CeladonGym.asm|_CeladonGymAfterBattleText5|4": "they help us dress",
"text/CeladonGym.asm|_CeladonGymAfterBattleText5|5": "the flower beds!",
"text/CeladonGym.asm|_CeladonGymBattleText6|0": "Bugs and flames",
"text/CeladonGym.asm|_CeladonGymBattleText6|1": "stay outside the",
"text/CeladonGym.asm|_CeladonGymBattleText6|2": "glass, got it?",
"text/CeladonGym.asm|_CeladonGymEndBattleText6|0": "Eek!",
"text/CeladonGym.asm|_CeladonGymEndBattleText6|1": "Scorched!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText6|0": "FLORA talks soft",
"text/CeladonGym.asm|_CeladonGymAfterBattleText6|1": "and dozes a lot,",
"text/CeladonGym.asm|_CeladonGymAfterBattleText6|2": "but her vines",
"text/CeladonGym.asm|_CeladonGymAfterBattleText6|3": "never miss!",
"text/CeladonGym.asm|_CeladonGymBattleText7|0": "Good day. I raise",
"text/CeladonGym.asm|_CeladonGymBattleText7|1": "kith between my",
"text/CeladonGym.asm|_CeladonGymBattleText7|2": "tea and pruning.",
"text/CeladonGym.asm|_CeladonGymEndBattleText7|0": "Oh!",
"text/CeladonGym.asm|_CeladonGymEndBattleText7|1": "How lovely!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText7|0": "I'm meeting a",
"text/CeladonGym.asm|_CeladonGymAfterBattleText7|1": "stranger for tea",
"text/CeladonGym.asm|_CeladonGymAfterBattleText7|2": "soon. Must mind",
"text/CeladonGym.asm|_CeladonGymAfterBattleText7|3": "my manners!",
"text/CeladonGym.asm|_CeladonGymBattleText8|0": "This is the",
"text/CeladonGym.asm|_CeladonGymBattleText8|1": "BLOSSBURY GYM!",
"text/CeladonGym.asm|_CeladonGymBattleText8|2": "Petals look soft,",
"text/CeladonGym.asm|_CeladonGymBattleText8|3": "but thorns are",
"text/CeladonGym.asm|_CeladonGymBattleText8|4": "part of the deal!",
"text/CeladonGym.asm|_CeladonGymEndBattleText8|0": "Ow!",
"text/CeladonGym.asm|_CeladonGymEndBattleText8|1": "Thorned!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText8|0": "My best kith is",
"text/CeladonGym.asm|_CeladonGymAfterBattleText8|1": "home napping!",
"text/CeladonGym.asm|_CeladonGymAfterBattleText8|2": "Next time you'll",
"text/CeladonGym.asm|_CeladonGymAfterBattleText8|3": "see!"
}