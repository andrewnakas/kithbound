"text/BikeShop.asm|_BikeShopClerkWelcomeText|3": "was hand-tuned!",
"text/BikeShop.asm|_BikeShopClerkDoYouLikeItText|0": "This ROADSTER is",
"text/BikeShop.asm|_BikeShopClerkDoYouLikeItText|1": "a beauty. Buy it?",
"text/BikeShop.asm|_BikeShopCantAffordText|0": "Ooh, your purse",
"text/BikeShop.asm|_BikeShopCantAffordText|1": "says no, friend.",
"text/BikeShop.asm|_BikeShopClerkOhThatsAVoucherText|0": "Wait, is that...",
"text/BikeShop.asm|_BikeShopClerkOhThatsAVoucherText|1": "A real CYCLE PASS!",
"text/BikeShop.asm|_BikeShopClerkOhThatsAVoucherText|2": "Deal! It's yours!",
"text/BikeShop.asm|_BikeShopExchangedVoucherText|0": "<PLAYER> traded in",
"text/BikeShop.asm|_BikeShopExchangedVoucherText|1": "a CYCLE PASS and",
"text/BikeShop.asm|_BikeShopExchangedVoucherText|2": "got a ROADSTER!@",
"text/BikeShop.asm|_BikeShopComeAgainText|0": "Pedal by whenever",
"text/BikeShop.asm|_BikeShopComeAgainText|1": "you like!",
"text/BikeShop.asm|_BikeShopClerkHowDoYouLikeYourBicycleText|0": "Riding smooth on",
"text/BikeShop.asm|_BikeShopClerkHowDoYouLikeYourBicycleText|1": "that ROADSTER?",
"text/BikeShop.asm|_BikeShopClerkHowDoYouLikeYourBicycleText|2": "It's fine for the",
"text/BikeShop.asm|_BikeShopClerkHowDoYouLikeYourBicycleText|3": "CYCLE ROAD, even",
"text/BikeShop.asm|_BikeShopClerkHowDoYouLikeYourBicycleText|4": "down in tunnels!",
"text/BikeShop.asm|_BikeShopBagFullText|0": "Your bag's packed",
"text/BikeShop.asm|_BikeShopBagFullText|1": "solid! Clear some!",
"text/BikeShop.asm|_BikeShopMiddleAgedWomanText|0": "I just want two",
"text/BikeShop.asm|_BikeShopMiddleAgedWomanText|1": "wheels and a bell.",
"text/BikeShop.asm|_BikeShopMiddleAgedWomanText|2": "Nothing fancy.",
"text/BikeShop.asm|_BikeShopMiddleAgedWomanText|3": "Those racing ones",
