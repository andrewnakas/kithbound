{
"text/AgathasRoom.asm|_AgathaBeforeBattleText|0": "Come closer. I'm",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|1": "MOIRA of TOP FOUR.",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|2": "So BRAMBLE sent",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|3": "his little errand",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|4": "runner, hm?",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|5": "We battled here",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|6": "together once.",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|7": "He had hair back",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|8": "then, the dear.",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|9": "Now he only",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|10": "counts critters",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|11": "in that KITHLOG.",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|12": "Bah! An idle kith",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|13": "is a candle unlit!",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|14": "<PLAYER>, mind",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|15": "the dark. It",
"text/AgathasRoom.asm|_AgathaBeforeBattleText|16": "bites tonight!",
"text/AgathasRoom.asm|_AgathaEndBattleText|0": "Well, well!",
"text/AgathasRoom.asm|_AgathaEndBattleText|1": "The dark blinked",
"text/AgathasRoom.asm|_AgathaEndBattleText|2": "first, little one!",
"text/AgathasRoom.asm|_AgathaAfterBattleText|0": "Hm. So that's",
"text/AgathasRoom.asm|_AgathaAfterBattleText|1": "why BRAMBLE keeps",
"text/AgathasRoom.asm|_AgathaAfterBattleText|2": "bragging on you.",
"text/AgathasRoom.asm|_AgathaAfterBattleText|3": "My candles are",
"text/AgathasRoom.asm|_AgathaAfterBattleText|4": "out. Off you go,",
"text/AgathasRoom.asm|_AgathaAfterBattleText|5": "and don't dawdle!",
"text/AgathasRoom.asm|_AgathasRoomAgathaDontRunAwayText|0": "A dry whisper:",
"text/AgathasRoom.asm|_AgathasRoomAgathaDontRunAwayText|1": "Stay put, child!"
}