{
"text/CeruleanMart.asm|_CeruleanMartCooltrainerMText|0": "A spritz of WARD",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerMText|1": "SPRAY shoos off",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerMText|2": "feeble wild kith.",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerMText|3": "But it only works",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerMText|4": "on kith weaker",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerMText|5": "than the one at",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerMText|6": "the front of you!",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerFText|0": "Ever found a",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerFText|1": "LEVEL CHARM?",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerFText|2": "They say one bumps",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerFText|3": "a kith up a whole",
"text/CeruleanMart.asm|_CeruleanMartCooltrainerFText|4": "level at once!"
}