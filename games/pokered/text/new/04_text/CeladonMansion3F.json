{
"text/CeladonMansion3F.asm|_CeladonMansion3FProgrammerText|0": "Me? I write the",
"text/CeladonMansion3F.asm|_CeladonMansion3FProgrammerText|1": "code. Sleep later.",
"text/CeladonMansion3F.asm|_CeladonMansion3FGraphicArtistText|0": "I paint all the",
"text/CeladonMansion3F.asm|_CeladonMansion3FGraphicArtistText|1": "little pictures!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGraphicArtistText|2": "Yep, you too!",
"text/CeladonMansion3F.asm|_CeladonMansion3FWriterText|0": "Words are my job!",
"text/CeladonMansion3F.asm|_CeladonMansion3FWriterText|1": "FLORA's my fave.",
"text/CeladonMansion3F.asm|_CeladonMansion3FWriterText|2": "MAREN's a close",
"text/CeladonMansion3F.asm|_CeladonMansion3FWriterText|3": "second, honestly!",
"text/CeladonMansion3F.asm|_CeladonMansion3FWriterText|4": "And SIBYL? Spooky",
"text/CeladonMansion3F.asm|_CeladonMansion3FWriterText|5": "but so cool!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|0": "Oh, really?",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|1": "Me, I plan out",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|2": "the whole game!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|3": "Every page of the",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|4": "KITHLOG is a dare.",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|5": "Keep at it, okay?",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|6": "Fill all of it,",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerText|7": "then show me!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerCompletedDexText|0": "No way! Look!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerCompletedDexText|1": "Every page is",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerCompletedDexText|2": "filled in! Wow!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameDesignerCompletedDexText|3": "You did it all!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameProgramPCText|0": "Raw game code on",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameProgramPCText|1": "the screen. One",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameProgramPCText|2": "wrong key and it",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameProgramPCText|3": "all falls apart!",
"text/CeladonMansion3F.asm|_CeladonMansion3FPlayingGamePCText|0": "Somebody's on a",
"text/CeladonMansion3F.asm|_CeladonMansion3FPlayingGamePCText|1": "high score streak",
"text/CeladonMansion3F.asm|_CeladonMansion3FPlayingGamePCText|2": "on work hours!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameScriptPCText|0": "The full script!",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameScriptPCText|1": "Spoilers ahead.",
"text/CeladonMansion3F.asm|_CeladonMansion3FGameScriptPCText|2": "Better not peek!",
"text/CeladonMansion3F.asm|_CeladonMansion3FDevRoomSignText|0": "3F",
"text/CeladonMansion3F.asm|_CeladonMansion3FDevRoomSignText|1": "Makers' Studio"
}