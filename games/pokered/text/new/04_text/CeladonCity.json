{
"text/CeladonCity.asm|_CeladonCityLittleGirlText|0": "My FUMEPUFF came",
"text/CeladonCity.asm|_CeladonCityLittleGirlText|1": "from EMBERKEY!",
"text/CeladonCity.asm|_CeladonCityLittleGirlText|2": "It's a sweetie,",
"text/CeladonCity.asm|_CeladonCityLittleGirlText|3": "but it puffs out",
"text/CeladonCity.asm|_CeladonCityLittleGirlText|4": "smog when cross!",
"text/CeladonCity.asm|_CeladonCityGramps1Text|0": "Ho ho! I visit",
"text/CeladonCity.asm|_CeladonCityGramps1Text|1": "that GYM daily.",
"text/CeladonCity.asm|_CeladonCityGramps1Text|2": "For the flowers.",
"text/CeladonCity.asm|_CeladonCityGirlText|0": "That PRIZE HALL",
"text/CeladonCity.asm|_CeladonCityGirlText|1": "makes our pretty",
"text/CeladonCity.asm|_CeladonCityGirlText|2": "town look seedy!",
"text/CeladonCity.asm|_CeladonCityGramps2Text|0": "Groan... the reels",
"text/CeladonCity.asm|_CeladonCityGramps2Text|1": "ate my savings!",
"text/CeladonCity.asm|_CeladonCityGramps2Text|2": "Should've swapped",
"text/CeladonCity.asm|_CeladonCityGramps2Text|3": "my tokens for a",
"text/CeladonCity.asm|_CeladonCityGramps2Text|4": "prize in time!",
"text/CeladonCity.asm|_CeladonCityGramps3Text|0": "Why, hello!",
"text/CeladonCity.asm|_CeladonCityGramps3Text|1": "I've waved at you",
"text/CeladonCity.asm|_CeladonCityGramps3Text|2": "from my bench for",
"text/CeladonCity.asm|_CeladonCityGramps3Text|3": "days, you know!",
"text/CeladonCity.asm|_CeladonCityGramps3Text|4": "Take this, for",
"text/CeladonCity.asm|_CeladonCityGramps3Text|5": "being friendly!",
"text/CeladonCity.asm|_CeladonCityGramps3ReceivedTM41Text|0": "<PLAYER> got",
"text/CeladonCity.asm|_CeladonCityGramps3TM41ExplanationText|0": "SC41 holds the",
"text/CeladonCity.asm|_CeladonCityGramps3TM41ExplanationText|1": "skill YOLK MEND!",
"text/CeladonCity.asm|_CeladonCityGramps3TM41ExplanationText|2": "Just one kind of",
"text/CeladonCity.asm|_CeladonCityGramps3TM41ExplanationText|3": "kith can learn it.",
"text/CeladonCity.asm|_CeladonCityGramps3TM41ExplanationText|4": "The nurse egg,",
"text/CeladonCity.asm|_CeladonCityGramps3TM41ExplanationText|5": "MEDIEGG!",
"text/CeladonCity.asm|_CeladonCityGramps3TM41NoRoomText|0": "Dear me, you have",
"text/CeladonCity.asm|_CeladonCityGramps3TM41NoRoomText|1": "no space left!",
"text/CeladonCity.asm|_CeladonCityFisherText|0": "Meet my best bud,",
"text/CeladonCity.asm|_CeladonCityFisherText|1": "VORTEXTOAD!",
"text/CeladonCity.asm|_CeladonCityFisherText|2": "Was an EDDYFROG",
"text/CeladonCity.asm|_CeladonCityFisherText|3": "till a TIDE SHARD",
"text/CeladonCity.asm|_CeladonCityFisherText|4": "changed its life!",
"text/CeladonCity.asm|_CeladonCityPoliwrathText|0": "VORTEXTOAD: Gwob",
"text/CeladonCity.asm|_CeladonCityPoliwrathText|1": "gwob!@",
"text/CeladonCity.asm|_CeladonCityRocket1Text|0": "Got a problem,",
"text/CeladonCity.asm|_CeladonCityRocket1Text|1": "squirt?",
"text/CeladonCity.asm|_CeladonCityRocket2Text|0": "GLOAM business.",
"text/CeladonCity.asm|_CeladonCityRocket2Text|1": "Scram, kid.",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|0": "TAMER TIPS",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|1": "An AIM SHOT keeps",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|2": "your kith's moves",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|3": "from missing!",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|4": "A FOCUS SHOT makes",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|5": "lucky big hits",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|6": "come more often!",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|7": "Both are sold at",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|8": "BLOSSBURY BAZAAR,",
"text/CeladonCity.asm|_CeladonCityTrainerTips1Text|9": "upstairs!",
"text/CeladonCity.asm|_CeladonCitySignText|0": "BLOSSBURY",
"text/CeladonCity.asm|_CeladonCitySignText|1": "Where Gardens",
"text/CeladonCity.asm|_CeladonCitySignText|2": "Climb the Walls",
"text/CeladonCity.asm|_CeladonCityGymSignText|0": "BLOSSBURY",
"text/CeladonCity.asm|_CeladonCityGymSignText|1": "KITH GYM",
"text/CeladonCity.asm|_CeladonCityGymSignText|2": "LEADER: FLORA",
"text/CeladonCity.asm|_CeladonCityGymSignText|3": "Keeper of the",
"text/CeladonCity.asm|_CeladonCityGymSignText|4": "Hanging Gardens",
"text/CeladonCity.asm|_CeladonCityMansionSignText|0": "BLOSSBURY TOWERS",
"text/CeladonCity.asm|_CeladonCityDeptStoreSignText|0": "Five floors of",
"text/CeladonCity.asm|_CeladonCityDeptStoreSignText|1": "goods! BLOSSBURY",
"text/CeladonCity.asm|_CeladonCityDeptStoreSignText|2": "BAZAAR!",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|0": "TAMER TIPS",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|1": "A MIST GUARD",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|2": "shields your kith",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|3": "from stat-lowering",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|4": "tricks for a time",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|5": "in battle!",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|6": "Both are sold at",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|7": "BLOSSBURY BAZAAR,",
"text/CeladonCity.asm|_CeladonCityTrainerTips2Text|8": "upstairs!",
"text/CeladonCity.asm|_CeladonCityPrizeExchangeSignText|0": "Swap your tokens",
"text/CeladonCity.asm|_CeladonCityPrizeExchangeSignText|1": "here for goodies!",
"text/CeladonCity.asm|_CeladonCityPrizeExchangeSignText|2": "TOKEN COUNTER",
"text/CeladonCity.asm|_CeladonCityGameCornerSignText|0": "GLOAM PRIZE HALL",
"text/CeladonCity.asm|_CeladonCityGameCornerSignText|1": "Spin, win, and",
"text/CeladonCity.asm|_CeladonCityGameCornerSignText|2": "lose track of time"
}