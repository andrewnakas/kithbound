{
"text/CeladonHotel.asm|_CeladonHotelGrannyText|0": "Your kith want a",
"text/CeladonHotel.asm|_CeladonHotelGrannyText|1": "bed? Ha! Rooms",
"text/CeladonHotel.asm|_CeladonHotelGrannyText|2": "are for two legs.",
"text/CeladonHotel.asm|_CeladonHotelGrannyText|3": "And we're booked.",
"text/CeladonHotel.asm|_CeladonHotelBeautyText|0": "It's a getaway",
"text/CeladonHotel.asm|_CeladonHotelBeautyText|1": "for me, my beau,",
"text/CeladonHotel.asm|_CeladonHotelBeautyText|2": "and... my brother.",
"text/CeladonHotel.asm|_CeladonHotelBeautyText|3": "Look at all the",
"text/CeladonHotel.asm|_CeladonHotelBeautyText|4": "rooftop gardens!",
"text/CeladonHotel.asm|_CeladonHotelSuperNerdText|0": "Nobody told me I",
"text/CeladonHotel.asm|_CeladonHotelSuperNerdText|1": "was a chaperone."
}