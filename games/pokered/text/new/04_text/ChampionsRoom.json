{
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|0": "<RIVAL>: Finally!",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|1": "Took you long",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|2": "enough to climb",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|3": "up here, <PLAYER>.",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|4": "Good. A rival who",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|5": "folds is useless.",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|6": "Iron sharpens me.",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|7": "Filling my page",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|8": "of the KITHLOG, I",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|9": "combed every cave",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|10": "for real muscle!",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|11": "Then I built a",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|12": "lineup with an",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|13": "answer for every",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|14": "type out there!",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|15": "So guess what.",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|16": "This chair? Mine.",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|17": "CROWN LEAGUE head!",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|18": "<PLAYER>, you",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|19": "get what that",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|20": "makes me?",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|21": "Let me spell it.",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|22": "Nobody, anywhere,",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|23": "tames better than",
"text/ChampionsRoom.asm|_ChampionsRoomRivalIntroText|24": "<RIVAL>. Nobody!",
"text/ChampionsRoom.asm|_RivalDefeatedText|0": "WHAT?!",
"text/ChampionsRoom.asm|_RivalDefeatedText|1": "No way! Not my",
"text/ChampionsRoom.asm|_RivalDefeatedText|2": "top team, too!",
"text/ChampionsRoom.asm|_RivalDefeatedText|3": "All those miles,",
"text/ChampionsRoom.asm|_RivalDefeatedText|4": "all that sweat to",
"text/ChampionsRoom.asm|_RivalDefeatedText|5": "claim this seat?",
"text/ChampionsRoom.asm|_RivalDefeatedText|6": "And I'm out after",
"text/ChampionsRoom.asm|_RivalDefeatedText|7": "one afternoon?",
"text/ChampionsRoom.asm|_RivalDefeatedText|8": "That's so cheap!",
"text/ChampionsRoom.asm|_RivalVictoryText|0": "Ha! Yes!",
"text/ChampionsRoom.asm|_RivalVictoryText|1": "Still the champ!",
"text/ChampionsRoom.asm|_RivalVictoryText|2": "Way out of your",
"text/ChampionsRoom.asm|_RivalVictoryText|3": "league, <PLAYER>!",
"text/ChampionsRoom.asm|_RivalVictoryText|4": "Making it this",
"text/ChampionsRoom.asm|_RivalVictoryText|5": "far's cute, but",
"text/ChampionsRoom.asm|_RivalVictoryText|6": "<RIVAL> is a",
"text/ChampionsRoom.asm|_RivalVictoryText|7": "born kith legend!",
"text/ChampionsRoom.asm|_RivalVictoryText|8": "Better luck never!",
"text/ChampionsRoom.asm|_RivalVictoryText|9": "Ha ha!",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|0": "How?",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|1": "How'd it go wrong?",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|2": "I trained my team",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|3": "by the book, every",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|4": "single day...",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|5": "Ugh! Fine! You're",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|6": "the CROWN LEAGUE",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|7": "champion now.",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|8": "Don't expect me",
"text/ChampionsRoom.asm|_ChampionsRoomRivalAfterBattleText|9": "to clap for it.",
"text/ChampionsRoom.asm|_ChampionsRoomOakText|0": "BRAMBLE: <PLAYER>!",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|0": "BRAMBLE: You did",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|1": "it! My word!",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|2": "The CROWN LEAGUE",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|3": "has a fresh",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|4": "champion!",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|5": "To think you were",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|6": "a nervous kid who",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|7": "set out with",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|10": "<PLAYER>, you're",
"text/ChampionsRoom.asm|_ChampionsRoomOakCongratulatesPlayerText|11": "all grown up now!",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|0": "BRAMBLE: <RIVAL>,",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|1": "I'm let down.",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|2": "I rushed over the",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|3": "moment I heard the",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|4": "four had fallen.",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|5": "Yet you lost the",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|6": "crown before I",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|7": "even arrived!",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|8": "<RIVAL>, do you",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|9": "see what went",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|10": "wrong today?",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|11": "You stopped caring",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|12": "for your kith as",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|13": "friends, and",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|14": "leaned on force!",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|15": "Until you mend",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|16": "that, the crown",
"text/ChampionsRoom.asm|_ChampionsRoomOakDisappointedWithRivalText|17": "won't come back.",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|0": "BRAMBLE: <PLAYER>!",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|1": "Your win came",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|2": "from more than",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|3": "just your own",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|4": "grit, didn't it?",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|5": "You and your kith",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|6": "pull together.",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|7": "It's wonderful!",
"text/ChampionsRoom.asm|_ChampionsRoomOakComeWithMeText|9": "Follow me now!"
}