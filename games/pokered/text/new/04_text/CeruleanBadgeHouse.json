{
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManText|0": "I've studied GYM",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManText|1": "BADGEs my whole",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManText|2": "life, you know.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManText|3": "Ah! There's one",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManText|4": "on your coat!",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManText|5": "Each BADGE hides",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManText|6": "a quiet power.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManWhichBadgeText|0": "Very well...",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManWhichBadgeText|1": "Pick one of the",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManWhichBadgeText|2": "eight, and I'll",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManWhichBadgeText|3": "explain it.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManVisitAnyTimeText|0": "My door's open if",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMiddleAgedManVisitAnyTimeText|1": "you're curious.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseBoulderBadgeText|0": "Your kith hit a",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseBoulderBadgeText|1": "touch harder in",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseBoulderBadgeText|2": "every battle.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseBoulderBadgeText|3": "And their BEACON",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseBoulderBadgeText|4": "skill works out",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseBoulderBadgeText|5": "on the trail.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseCascadeBadgeText|0": "Kith at L30 or",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseCascadeBadgeText|1": "under will listen.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseCascadeBadgeText|2": "Stronger ones may",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseCascadeBadgeText|3": "shrug off orders!",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseCascadeBadgeText|4": "Plus, kith can",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseCascadeBadgeText|5": "CHOP down trees",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseCascadeBadgeText|6": "on your travels.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseThunderBadgeText|0": "Your kith grow a",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseThunderBadgeText|1": "touch quicker in",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseThunderBadgeText|2": "every battle.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseThunderBadgeText|3": "Plus, kith can",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseThunderBadgeText|4": "SOAR you to towns",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseThunderBadgeText|5": "you've seen.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseRainbowBadgeText|0": "Kith at L50 or",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseRainbowBadgeText|1": "under will listen.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseRainbowBadgeText|2": "Stronger ones may",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseRainbowBadgeText|3": "shrug off orders!",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseRainbowBadgeText|4": "Plus, kith can",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseRainbowBadgeText|5": "HEAVE boulders",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseRainbowBadgeText|6": "on your travels.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseSoulBadgeText|0": "Your kith guard a",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseSoulBadgeText|1": "touch better in",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseSoulBadgeText|2": "every battle.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseSoulBadgeText|3": "Plus, kith can",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseSoulBadgeText|4": "WAVE RIDE across",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseSoulBadgeText|5": "open water.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMarshBadgeText|0": "Kith at L70 or",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMarshBadgeText|1": "under will listen.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMarshBadgeText|2": "Stronger ones may",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseMarshBadgeText|3": "shrug off orders!",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseVolcanoBadgeText|0": "Your kith's",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseVolcanoBadgeText|1": "SPECIAL power",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseVolcanoBadgeText|2": "climbs a notch.",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseEarthBadgeText|0": "Every kith, any",
"text/CeruleanBadgeHouse.asm|_CeruleanBadgeHouseEarthBadgeText|1": "level, will heed!"
}