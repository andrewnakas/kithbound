{
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|0": "Welcome, sweaty!",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|1": "ASHBY's the name,",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|2": "and this kiln is",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|3": "my GYM, kiddo!",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|4": "My blazing kith",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|5": "melt challengers",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|6": "into puddles!",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|7": "Got a COOL BALM?",
"text/CinnabarGym.asm|_CinnabarGymBlainePreBattleText|8": "You'll need ten!",
"text/CinnabarGym.asm|_CinnabarGymBlaineReceivedVolcanoBadgeText|0": "My flame's",
"text/CinnabarGym.asm|_CinnabarGymBlaineReceivedVolcanoBadgeText|1": "snuffed out!",
"text/CinnabarGym.asm|_CinnabarGymBlaineReceivedVolcanoBadgeText|2": "Take it, the",
"text/CinnabarGym.asm|_CinnabarGymBlaineReceivedVolcanoBadgeText|3": "KILN BADGE!@",
"text/CinnabarGym.asm|_CinnabarGymBlainePostBattleAdviceText|0": "FIRESTORM! No",
"text/CinnabarGym.asm|_CinnabarGymBlainePostBattleAdviceText|1": "blaze burns any",
"text/CinnabarGym.asm|_CinnabarGymBlainePostBattleAdviceText|2": "hotter, kiddo!",
"text/CinnabarGym.asm|_CinnabarGymBlainePostBattleAdviceText|3": "But aim it at TIDE",
"text/CinnabarGym.asm|_CinnabarGymBlainePostBattleAdviceText|4": "kith? Fizzle!",
"text/CinnabarGym.asm|_CinnabarGymBlaineVolcanoBadgeInfoText|0": "Ha!",
"text/CinnabarGym.asm|_CinnabarGymBlaineVolcanoBadgeInfoText|1": "With the KILN",
"text/CinnabarGym.asm|_CinnabarGymBlaineVolcanoBadgeInfoText|2": "BADGE, your kith",
"text/CinnabarGym.asm|_CinnabarGymBlaineVolcanoBadgeInfoText|3": "gain a kick to",
"text/CinnabarGym.asm|_CinnabarGymBlaineVolcanoBadgeInfoText|4": "SPECIAL power!",
"text/CinnabarGym.asm|_CinnabarGymBlaineVolcanoBadgeInfoText|5": "And here, one",
"text/CinnabarGym.asm|_CinnabarGymBlaineVolcanoBadgeInfoText|6": "more hot gift!",
"text/CinnabarGym.asm|_CinnabarGymBlaineReceivedTM38Text|0": "<PLAYER> got",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38ExplanationText|0": "SC38 holds the",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38ExplanationText|1": "skill FIRESTORM!",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38ExplanationText|2": "EMBER kith wield",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38ExplanationText|3": "it best!",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38ExplanationText|4": "Try SCORCHET or",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38ExplanationText|5": "EMBERCOLT on it",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38ExplanationText|6": "for a hot time!",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38NoRoomText|0": "Your bag's full!",
"text/CinnabarGym.asm|_CinnabarGymBlaineTM38NoRoomText|1": "Clear some space!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1BattleText|0": "Ever measured the",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1BattleText|1": "heat of a kith's",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1BattleText|2": "fiery sneeze?",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1EndBattleText|0": "Ouch!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1EndBattleText|1": "I'm toasted!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1AfterBattleText|0": "A flame is just",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1AfterBattleText|1": "rapid oxidation",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1AfterBattleText|2": "of fuel, which...",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1AfterBattleText|3": "...and so on, and",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd1AfterBattleText|4": "so forth...",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd2BattleText|0": "Used to pick",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd2BattleText|1": "pockets. Now I",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd2BattleText|2": "battle fair!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd2EndBattleText|1": "yield!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd2AfterBattleText|0": "Old habits... I",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd2AfterBattleText|1": "still eye other",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd2AfterBattleText|2": "folks' kith...",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3BattleText|0": "Give up now! I've",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3BattleText|1": "read every paper",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3BattleText|2": "on kith there is!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3EndBattleText|0": "Argh!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3EndBattleText|1": "My notes!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3AfterBattleText|0": "My equations",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3AfterBattleText|1": "would melt your",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd3AfterBattleText|2": "brain, trust me.",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd4BattleText|0": "EMBER kith are",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd4BattleText|1": "just so cozy!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd4EndBattleText|0": "Burned",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd4EndBattleText|1": "my fingers!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd4AfterBattleText|0": "If a pickpocket",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd4AfterBattleText|1": "kith existed, I'd",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd4AfterBattleText|2": "snare it quick!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5BattleText|0": "Want to hear how",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5BattleText|1": "ASHBY got started?",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5EndBattleText|0": "Eep!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5AfterBattleText|0": "Once, ASHBY got",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5AfterBattleText|1": "lost on a snowy",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5AfterBattleText|2": "peak, until a",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5AfterBattleText|3": "FLAREKITE flew by.",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5AfterBattleText|4": "Its glow lit a",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5AfterBattleText|5": "trail, and he",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd5AfterBattleText|6": "followed it home!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6BattleText|0": "I've toured lots",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6BattleText|1": "of GYMs. This",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6BattleText|2": "kiln's the best!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6EndBattleText|0": "Whew!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6EndBattleText|1": "Sizzling!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6AfterBattleText|0": "We flame fans",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6AfterBattleText|1": "adore EMBERCOLT",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd6AfterBattleText|2": "and PYRELYNX!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd7BattleText|0": "Fire fizzles in",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd7BattleText|1": "a puddle, ha!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd7EndBattleText|0": "Pfff!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd7EndBattleText|1": "Extinguished!",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd7AfterBattleText|0": "TIDE beats EMBER,",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd7AfterBattleText|1": "sure. Yet EMBER",
"text/CinnabarGym.asm|_CinnabarGymSuperNerd7AfterBattleText|2": "thaws FROST kith!",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|0": "Hey there, future",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|1": "champ!",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|2": "ASHBY's a fiery",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|3": "fellow who fights",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|4": "with EMBER kith!",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|5": "Soak his team",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|6": "with TIDE moves!",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|7": "And pack a few",
"text/CinnabarGym.asm|_CinnabarGymGymGuideChampInMakingText|8": "COOL BALMS, too!",
"text/CinnabarGym.asm|_CinnabarGymGymGuideBeatBlaineText|0": "<PLAYER>! The kiln",
"text/CinnabarGym.asm|_CinnabarGymGymGuideBeatBlaineText|1": "went cold. Wow!"
}