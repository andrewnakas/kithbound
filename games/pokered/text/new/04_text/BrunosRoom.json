{
"text/BrunosRoom.asm|_BrunoBeforeBattleText|0": "TORVALD. Second",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|1": "wall of the four.",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|2": "Sweat is honest.",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|3": "Kith and tamer",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|4": "both grow by it,",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|5": "rep after rep.",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|6": "My kith hauled",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|7": "stones up the",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|8": "cliff beside me.",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|10": "Now we will crush",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|11": "you with every",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|12": "ounce of it!",
"text/BrunosRoom.asm|_BrunoBeforeBattleText|13": "HRAAH!",
"text/BrunosRoom.asm|_BrunoEndBattleText|0": "Impossible...",
"text/BrunosRoom.asm|_BrunoEndBattleText|1": "My form was true!",
"text/BrunosRoom.asm|_BrunoAfterBattleText|0": "I am spent. The",
"text/BrunosRoom.asm|_BrunoAfterBattleText|1": "next door waits.",
"text/BrunosRoom.asm|_BrunoAfterBattleText|2": "Walk on, TAMER.",
"text/BrunosRoom.asm|_BrunosRoomBrunoDontRunAwayText|0": "A deep growl:",
"text/BrunosRoom.asm|_BrunosRoomBrunoDontRunAwayText|1": "No retreat!"
}