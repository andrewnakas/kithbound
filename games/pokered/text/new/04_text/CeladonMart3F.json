{
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18PreReceiveText|0": "Whew! I just beat",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18PreReceiveText|1": "my KITH game!",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18PreReceiveText|2": "You're still on",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18PreReceiveText|3": "your quest? Here,",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18PreReceiveText|4": "take this!",
"text/CeladonMart3F.asm|_CeladonMart3FClerkReceivedTM18Text|0": "<PLAYER> got",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18ExplanationText|0": "SC18 is REBOUND!",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18ExplanationText|1": "It hits back, like",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18ExplanationText|2": "my sister when I",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18ExplanationText|3": "steal her fries!",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18NoRoomText|0": "Your bag's packed",
"text/CeladonMart3F.asm|_CeladonMart3FClerkTM18NoRoomText|1": "to the brim!",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid1Text|0": "Each kith you",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid1Text|1": "snare is stamped",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid1Text|2": "with your ID No.",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid1Text|3": "and an OT tag.",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid1Text|4": "That's the name",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid1Text|5": "of whoever first",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid1Text|6": "snared it!",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid2Text|0": "Sweet!",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid2Text|1": "My pal says he'll",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid2Text|2": "swap me a",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid2Text|3": "MARSUPRIME for my",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid2Text|4": "RUBBLEMAN!",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid3Text|0": "Go go, RUBBLEMAN!",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid3Text|1": "RUBBLEMAN rules!",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid3Text|2": "I've got dozens!",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid3Text|3": "Wait...",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid3Text|4": "My RUBBLEMAN just",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid3Text|5": "changed shape in",
"text/CeladonMart3F.asm|_CeladonMart3FGameBoyKid3Text|6": "the swap!",
"text/CeladonMart3F.asm|_CeladonMart3FLittleBoyText|0": "A kith from a",
"text/CeladonMart3F.asm|_CeladonMart3FLittleBoyText|1": "swap keeps the",
"text/CeladonMart3F.asm|_CeladonMart3FLittleBoyText|2": "first owner's",
"text/CeladonMart3F.asm|_CeladonMart3FLittleBoyText|3": "ID No. forever!",
"text/CeladonMart3F.asm|_CeladonMart3FSNESText|0": "A shiny console!",
"text/CeladonMart3F.asm|_CeladonMart3FRPGText|0": "A quest game! It'd",
"text/CeladonMart3F.asm|_CeladonMart3FRPGText|1": "eat my whole week!",
"text/CeladonMart3F.asm|_CeladonMart3FSportsGameText|0": "A ball game! My",
"text/CeladonMart3F.asm|_CeladonMart3FSportsGameText|1": "dad would love it!",
"text/CeladonMart3F.asm|_CeladonMart3FPuzzleGameText|0": "Falling blocks!",
"text/CeladonMart3F.asm|_CeladonMart3FPuzzleGameText|1": "Just one more go!",
"text/CeladonMart3F.asm|_CeladonMart3FFightingGameText|0": "A brawler game!",
"text/CeladonMart3F.asm|_CeladonMart3FFightingGameText|1": "Lots of buttons!",
"text/CeladonMart3F.asm|_CeladonMart3FCurrentFloorSignText|0": "3F: PLAY CORNER",
"text/CeladonMart3F.asm|_CeladonMart3FPokemonPosterText|0": "DAWN and DUSK!",
"text/CeladonMart3F.asm|_CeladonMart3FPokemonPosterText|1": "Two kith tales!"
}