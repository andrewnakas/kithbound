{
"text/CeruleanPokecenter.asm|_CeruleanPokecenterSuperNerdText|0": "Oh, that PIP!",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterSuperNerdText|1": "Rumor has it he'd",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterSuperNerdText|2": "trek across a",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterSuperNerdText|3": "volcano for one",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterSuperNerdText|4": "rare kith!",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|0": "Know about PIP?",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|1": "The cape fellow?",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|2": "Folks say he's",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|3": "kith-crazy!",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|4": "Bah. They envy",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|5": "him, if you ask",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|6": "this old man.",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|7": "Who'd not want to",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|8": "show off a prized",
"text/CeruleanPokecenter.asm|_CeruleanPokecenterGentlemanText|9": "kith or two?"
}