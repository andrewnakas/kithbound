{
 "text/Route9.asm|_Route9CooltrainerF1BattleText|0": "Ooh, a TAMER with",
 "text/Route9.asm|_Route9CooltrainerF1BattleText|1": "kith in tow!",
 "text/Route9.asm|_Route9CooltrainerF1BattleText|2": "Battle time!",
 "text/Route9.asm|_Route9CooltrainerF1EndBattleText|0": "You",
 "text/Route9.asm|_Route9CooltrainerF1EndBattleText|1": "tricked me!",
 "text/Route9.asm|_Route9CooltrainerF1AfterBattleText|0": "Bring a light! The",
 "text/Route9.asm|_Route9CooltrainerF1AfterBattleText|1": "cave up ahead is",
 "text/Route9.asm|_Route9CooltrainerF1AfterBattleText|2": "pitch black.",
 "text/Route9.asm|_Route9CooltrainerM1BattleText|0": "Hey, you! Those",
 "text/Route9.asm|_Route9CooltrainerM1BattleText|1": "are some sharp",
 "text/Route9.asm|_Route9CooltrainerM1BattleText|2": "kith you've got!",
 "text/Route9.asm|_Route9CooltrainerM1EndBattleText|0": "Lights",
 "text/Route9.asm|_Route9CooltrainerM1EndBattleText|1": "out!",
 "text/Route9.asm|_Route9CooltrainerM1AfterBattleText|0": "Move along now.",
 "text/Route9.asm|_Route9CooltrainerM2BattleText|0": "I'm cutting thru",
 "text/Route9.asm|_Route9CooltrainerM2BattleText|1": "DARK BORE to get",
 "text/Route9.asm|_Route9CooltrainerM2BattleText|2": "to HOLLOWAY...",
 "text/Route9.asm|_Route9CooltrainerM2EndBattleText|0": "Not my",
 "text/Route9.asm|_Route9CooltrainerM2EndBattleText|1": "level!",
 "text/Route9.asm|_Route9CooltrainerM2AfterBattleText|0": "Going through the",
 "text/Route9.asm|_Route9CooltrainerM2AfterBattleText|1": "cave as well?",
 "text/Route9.asm|_Route9CooltrainerF2BattleText|0": "Don't you talk",
 "text/Route9.asm|_Route9CooltrainerF2BattleText|1": "down to me!",
 "text/Route9.asm|_Route9CooltrainerF2EndBattleText|0": "Ugh!",
 "text/Route9.asm|_Route9CooltrainerF2EndBattleText|1": "Too strong!",
 "text/Route9.asm|_Route9CooltrainerF2AfterBattleText|0": "Clearly you have",
 "text/Route9.asm|_Route9CooltrainerF2AfterBattleText|1": "a gift. Best of",
 "text/Route9.asm|_Route9CooltrainerF2AfterBattleText|2": "luck out there!",
 "text/Route9.asm|_Route9Hiker1BattleText|0": "Ho ho!",
 "text/Route9.asm|_Route9Hiker1BattleText|1": "A battle! Just",
 "text/Route9.asm|_Route9Hiker1BattleText|2": "what I needed!",
 "text/Route9.asm|_Route9Hiker1EndBattleText|0": "More!",
 "text/Route9.asm|_Route9Hiker1EndBattleText|1": "More!",
 "text/Route9.asm|_Route9Hiker1EndBattleText|2": "Hm? My kith are",
 "text/Route9.asm|_Route9Hiker1EndBattleText|3": "all done in!",
 "text/Route9.asm|_Route9Hiker1AfterBattleText|0": "Takes nerve to",
 "text/Route9.asm|_Route9Hiker1AfterBattleText|1": "face a big lug",
 "text/Route9.asm|_Route9Hiker1AfterBattleText|2": "like me. Nice!",
 "text/Route9.asm|_Route9Hiker2BattleText|0": "Ho ho!",
 "text/Route9.asm|_Route9Hiker2BattleText|1": "A pint-sized",
 "text/Route9.asm|_Route9Hiker2BattleText|2": "scrapper, eh?",
 "text/Route9.asm|_Route9Hiker2EndBattleText|0": "Eh?",
 "text/Route9.asm|_Route9Hiker2EndBattleText|1": "Already?",
 "text/Route9.asm|_Route9Hiker2AfterBattleText|0": "Ho ho! Youngsters",
 "text/Route9.asm|_Route9Hiker2AfterBattleText|1": "ought to be tough!",
 "text/Route9.asm|_Route9Youngster1BattleText|0": "Dawn after dawn I",
 "text/Route9.asm|_Route9Youngster1BattleText|1": "tended my kith,",
 "text/Route9.asm|_Route9Youngster1BattleText|2": "right out of the",
 "text/Route9.asm|_Route9Youngster1BattleText|3": "pod and up!",
 "text/Route9.asm|_Route9Youngster1EndBattleText|0": "NO!",
 "text/Route9.asm|_Route9Youngster1EndBattleText|1": "All those dawns,",
 "text/Route9.asm|_Route9Youngster1EndBattleText|2": "for nothing!",
 "text/Route9.asm|_Route9Youngster1AfterBattleText|0": "Maybe I need more",
 "text/Route9.asm|_Route9Youngster1AfterBattleText|1": "than bug kith on",
 "text/Route9.asm|_Route9Youngster1AfterBattleText|2": "my team...",
 "text/Route9.asm|_Route9Hiker3BattleText|0": "Ho ho ho ho!",
 "text/Route9.asm|_Route9Hiker3BattleText|1": "Bring it on, pal!",
 "text/Route9.asm|_Route9Hiker3EndBattleText|0": "Ho ho ho ho!",
 "text/Route9.asm|_Route9Hiker3EndBattleText|1": "Clean win, pal!",
 "text/Route9.asm|_Route9Hiker3AfterBattleText|0": "Ho ho ho ho!",
 "text/Route9.asm|_Route9Hiker3AfterBattleText|1": "Trekkers chuckle",
 "text/Route9.asm|_Route9Hiker3AfterBattleText|2": "through it all!",
 "text/Route9.asm|_Route9Youngster2BattleText|0": "Charge, my mighty",
 "text/Route9.asm|_Route9Youngster2BattleText|1": "bugs!",
 "text/Route9.asm|_Route9Youngster2EndBattleText|0": "My poor",
 "text/Route9.asm|_Route9Youngster2EndBattleText|1": "beetles...",
 "text/Route9.asm|_Route9Youngster2AfterBattleText|0": "Bug haters are on",
 "text/Route9.asm|_Route9Youngster2AfterBattleText|1": "my bad list, so",
 "text/Route9.asm|_Route9Youngster2AfterBattleText|2": "watch it!",
 "text/Route9.asm|_Route9SignText|0": "PATH 9",
 "text/Route9.asm|_Route9SignText|1": "BRINEFORD to",
 "text/Route9.asm|_Route9SignText|2": "DARK BORE"
}