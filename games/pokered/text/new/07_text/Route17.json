 "text/Route17.asm|_Route17Biker5EndBattleText|0": "Short",
 "text/Route17.asm|_Route17Biker5EndBattleText|1": "circuit!",
 "text/Route17.asm|_Route17Biker5AfterBattleText|0": "Found my FUSEBALL",
 "text/Route17.asm|_Route17Biker5AfterBattleText|1": "humming inside the",
 "text/Route17.asm|_Route17Biker5AfterBattleText|2": "OLD DYNAMO.",
 "text/Route17.asm|_Route17Biker6BattleText|0": "Why won't my kith",
 "text/Route17.asm|_Route17Biker6BattleText|1": "grow up already?",
 "text/Route17.asm|_Route17Biker6EndBattleText|0": "Ugh,",
 "text/Route17.asm|_Route17Biker6EndBattleText|1": "you!",
 "text/Route17.asm|_Route17Biker6AfterBattleText|0": "I hear a few kith",
 "text/Route17.asm|_Route17Biker6AfterBattleText|1": "only change if you",
 "text/Route17.asm|_Route17Biker6AfterBattleText|2": "hand them a SHARD.",
