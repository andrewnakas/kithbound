 "text/Route17.asm|_Route17Biker7BattleText|1": "calories!",
 "text/Route17.asm|_Route17Biker7EndBattleText|0": "Phew!",
 "text/Route17.asm|_Route17Biker7EndBattleText|1": "What a sweat!",
 "text/Route17.asm|_Route17Biker7AfterBattleText|0": "I bet that was a",
 "text/Route17.asm|_Route17Biker7AfterBattleText|1": "whole pound gone!",
 "text/Route17.asm|_Route17Biker8BattleText|0": "Break the rules!",
 "text/Route17.asm|_Route17Biker8EndBattleText|0": "Nooooo!",
