{
 "text/Route17.asm|_Route17Biker1BattleText|0": "Beating kids pays",
 "text/Route17.asm|_Route17Biker1BattleText|1": "nothing. Ugh.",
 "text/Route17.asm|_Route17Biker1EndBattleText|0": "Out of",
 "text/Route17.asm|_Route17Biker1EndBattleText|1": "gas!",
 "text/Route17.asm|_Route17Biker1AfterBattleText|0": "Riders drop stuff",
 "text/Route17.asm|_Route17Biker1AfterBattleText|1": "all over CYCLE",
 "text/Route17.asm|_Route17Biker1AfterBattleText|2": "ROAD. Look around!",
 "text/Route17.asm|_Route17Biker2BattleText|0": "Whatcha staring",
 "text/Route17.asm|_Route17Biker2BattleText|1": "at, shorty?",
 "text/Route17.asm|_Route17Biker2EndBattleText|0": "Whoa!",
 "text/Route17.asm|_Route17Biker2AfterBattleText|0": "One shove from my",
