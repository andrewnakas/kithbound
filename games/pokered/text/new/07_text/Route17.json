 "text/Route17.asm|_Route17Biker4BattleText|0": "ROADHOGs, baby!",
 "text/Route17.asm|_Route17Biker4BattleText|1": "Kings of asphalt!",
 "text/Route17.asm|_Route17Biker4EndBattleText|0": "Dusted!",
 "text/Route17.asm|_Route17Biker4AfterBattleText|0": "Out hunting for",
