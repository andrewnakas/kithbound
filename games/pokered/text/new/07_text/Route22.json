{
 "text/Route22.asm|_Route22RivalBeforeBattleText1|0": "<RIVAL>: Oi!",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|2": "Heading for the",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|3": "CROWN LEAGUE?",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|4": "Ha! You'd need a",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|5": "pile of BADGEs to",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|6": "get past the gate!",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|7": "That guard turns",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|8": "nobodies away!",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|9": "Anyway, let's see",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|10": "if your kith have",
 "text/Route22.asm|_Route22RivalBeforeBattleText1|11": "grown at all!",
 "text/Route22.asm|_Route22RivalAfterBattleText1|0": "They say the",
 "text/Route22.asm|_Route22RivalAfterBattleText1|1": "CROWN LEAGUE is",
 "text/Route22.asm|_Route22RivalAfterBattleText1|2": "packed with aces!",
 "text/Route22.asm|_Route22RivalAfterBattleText1|3": "I need a plan to",
 "text/Route22.asm|_Route22RivalAfterBattleText1|4": "smash through all",
 "text/Route22.asm|_Route22RivalAfterBattleText1|5": "of them!",
 "text/Route22.asm|_Route22RivalAfterBattleText1|6": "Stop dragging",
 "text/Route22.asm|_Route22RivalAfterBattleText1|7": "your feet and get",
 "text/Route22.asm|_Route22RivalAfterBattleText1|8": "going, snail!",
 "text/Route22.asm|_Route22Rival1DefeatedText|0": "Tch!",
 "text/Route22.asm|_Route22Rival1DefeatedText|1": "Dumb luck,",
 "text/Route22.asm|_Route22Rival1DefeatedText|2": "that's all!",
 "text/Route22.asm|_Route22Rival1VictoryText|0": "<RIVAL>: Huh?",
 "text/Route22.asm|_Route22Rival1VictoryText|1": "You've barely got",
 "text/Route22.asm|_Route22Rival1VictoryText|2": "any kith at all!",
 "text/Route22.asm|_Route22Rival1VictoryText|3": "Go out and catch",
 "text/Route22.asm|_Route22Rival1VictoryText|4": "a few more!",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|0": "<RIVAL>: Hey!",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|1": "<PLAYER>! Didn't",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|2": "think I'd bump",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|3": "into you here!",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|4": "On your way to the",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|5": "CROWN LEAGUE?",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|6": "Got all eight",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|7": "BADGEs as well?",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|8": "Not bad at all!",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|9": "Then you'll be my",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|10": "<PLAYER>-sized",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|11": "stretch before the",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|12": "CROWN LEAGUE!",
 "text/Route22.asm|_Route22RivalBeforeBattleText2|13": "Let's go!",
 "text/Route22.asm|_Route22RivalAfterBattleText2|0": "Good stretch! Now",
 "text/Route22.asm|_Route22RivalAfterBattleText2|1": "I'm all set for",
 "text/Route22.asm|_Route22RivalAfterBattleText2|2": "the CROWN LEAGUE!",
 "text/Route22.asm|_Route22RivalAfterBattleText2|3": "<PLAYER>, go and",
 "text/Route22.asm|_Route22RivalAfterBattleText2|4": "train some more!",
 "text/Route22.asm|_Route22RivalAfterBattleText2|5": "Then again, you",
 "text/Route22.asm|_Route22RivalAfterBattleText2|6": "knew that. Catch",
 "text/Route22.asm|_Route22RivalAfterBattleText2|7": "you never! Later!",
 "text/Route22.asm|_Route22Rival2DefeatedText|0": "No way!?",
 "text/Route22.asm|_Route22Rival2DefeatedText|1": "I got sloppy,",
 "text/Route22.asm|_Route22Rival2DefeatedText|2": "that's all!",
 "text/Route22.asm|_Route22Rival2VictoryText|0": "<RIVAL>: Ha ha!",
 "text/Route22.asm|_Route22Rival2VictoryText|1": "<PLAYER>! Is that",
 "text/Route22.asm|_Route22Rival2VictoryText|2": "all? You'll never",
 "text/Route22.asm|_Route22Rival2VictoryText|3": "catch up with me,",
 "text/Route22.asm|_Route22Rival2VictoryText|4": "not in a million!",
 "text/Route22.asm|_Route22Rival2VictoryText|5": "Back to training",
 "text/Route22.asm|_Route22Rival2VictoryText|6": "with you, chump!",
 "text/Route22.asm|_Route22PokemonLeagueSignText|0": "CROWN LEAGUE",
 "text/Route22.asm|_Route22PokemonLeagueSignText|1": "Main Gate"
}