{
 "text/Route24_2.asm|_Route24CooltrainerM2EndBattleText|1": "should've stayed!",
 "text/Route24_2.asm|_Route24CooltrainerM2AfterBattleText|0": "I ducked in here.",
 "text/Route24_2.asm|_Route24CooltrainerM2AfterBattleText|1": "Those bridge kids",
 "text/Route24_2.asm|_Route24CooltrainerM2AfterBattleText|2": "were scary!",
 "text/Route24_2.asm|_Route24CooltrainerM3BattleText|0": "Last one! Number",
 "text/Route24_2.asm|_Route24CooltrainerM3BattleText|1": "five! Prepare!",
 "text/Route24_2.asm|_Route24CooltrainerM3EndBattleText|0": "Yikes!",
 "text/Route24_2.asm|_Route24CooltrainerM3EndBattleText|1": "You're a storm!",
 "text/Route24_2.asm|_Route24CooltrainerM3AfterBattleText|0": "Gave it my all.",
 "text/Route24_2.asm|_Route24CooltrainerM3AfterBattleText|1": "Head held high!",
 "text/Route24_2.asm|_Route24CooltrainerF1BattleText|0": "Number four here!",
 "text/Route24_2.asm|_Route24CooltrainerF1BattleText|1": "Feeling worn yet?",
 "text/Route24_2.asm|_Route24CooltrainerF1EndBattleText|0": "Me as",
 "text/Route24_2.asm|_Route24CooltrainerF1EndBattleText|1": "well?!",
 "text/Route24_2.asm|_Route24CooltrainerF1AfterBattleText|0": "I tried my very",
 "text/Route24_2.asm|_Route24CooltrainerF1AfterBattleText|1": "hardest. Proud!",
 "text/Route24_2.asm|_Route24Youngster1BattleText|0": "Third in line!",
 "text/Route24_2.asm|_Route24Youngster1BattleText|1": "I'm no pushover!",
 "text/Route24_2.asm|_Route24Youngster1EndBattleText|0": "Ouch!",
 "text/Route24_2.asm|_Route24Youngster1EndBattleText|1": "Pancaked!",
 "text/Route24_2.asm|_Route24Youngster1AfterBattleText|0": "That was all I",
 "text/Route24_2.asm|_Route24Youngster1AfterBattleText|1": "had. I'm content!",
 "text/Route24_2.asm|_Route24CooltrainerF2BattleText|0": "Number two! No",
 "text/Route24_2.asm|_Route24CooltrainerF2BattleText|1": "more warmups!",
 "text/Route24_2.asm|_Route24CooltrainerF2EndBattleText|0": "Wait, I",
 "text/Route24_2.asm|_Route24CooltrainerF2EndBattleText|1": "lost?",
 "text/Route24_2.asm|_Route24CooltrainerF2AfterBattleText|0": "I fought hard.",
 "text/Route24_2.asm|_Route24CooltrainerF2AfterBattleText|1": "Zero shame here!",
 "text/Route24_2.asm|_Route24Youngster2BattleText|0": "Welcome to the",
 "text/Route24_2.asm|_Route24Youngster2BattleText|1": "bridge gauntlet!",
 "text/Route24_2.asm|_Route24Youngster2BattleText|2": "Topple all five",
 "text/Route24_2.asm|_Route24Youngster2BattleText|3": "of us for a prize!",
 "text/Route24_2.asm|_Route24Youngster2BattleText|4": "Got the nerve to",
 "text/Route24_2.asm|_Route24Youngster2BattleText|5": "give it a go?",
 "text/Route24_2.asm|_Route24Youngster2EndBattleText|0": "Wow!",
 "text/Route24_2.asm|_Route24Youngster2EndBattleText|1": "Nice one!",
 "text/Route24_2.asm|_Route24Youngster2AfterBattleText|0": "I lost, but I'm",
 "text/Route24_2.asm|_Route24Youngster2AfterBattleText|1": "smiling anyway!"
}