{
 "text/Route20.asm|_Route20Swimmer1BattleText|0": "My toes can touch",
 "text/Route20.asm|_Route20Swimmer1BattleText|1": "the bottom here!",
 "text/Route20.asm|_Route20Swimmer1EndBattleText|0": "Sploosh!",
 "text/Route20.asm|_Route20Swimmer1AfterBattleText|0": "I want a kith to",
 "text/Route20.asm|_Route20Swimmer1AfterBattleText|1": "carry me around.",
 "text/Route20.asm|_Route20Swimmer2BattleText|0": "FROSTREEF is my",
 "text/Route20.asm|_Route20Swimmer2BattleText|1": "quiet hideaway!",
 "text/Route20.asm|_Route20Swimmer2EndBattleText|0": "Enough!",
 "text/Route20.asm|_Route20Swimmer2AfterBattleText|0": "Caves wind deep",
 "text/Route20.asm|_Route20Swimmer2AfterBattleText|1": "down under these",
 "text/Route20.asm|_Route20Swimmer2AfterBattleText|2": "icy isles.",
 "text/Route20.asm|_Route20Swimmer3BattleText|0": "Drifting among the",
 "text/Route20.asm|_Route20Swimmer3BattleText|1": "fish is bliss!",
 "text/Route20.asm|_Route20Swimmer3EndBattleText|0": "Ouchie!",
 "text/Route20.asm|_Route20Swimmer3AfterBattleText|0": "Care to drift",
 "text/Route20.asm|_Route20Swimmer3AfterBattleText|1": "along with me?",
 "text/Route20.asm|_Route20Swimmer4BattleText|0": "On holiday? Me",
 "text/Route20.asm|_Route20Swimmer4BattleText|1": "too! Let's play!",
 "text/Route20.asm|_Route20Swimmer4EndBattleText|0": "Harsh,",
 "text/Route20.asm|_Route20Swimmer4EndBattleText|1": "so harsh!",
 "text/Route20.asm|_Route20Swimmer4AfterBattleText|0": "Long ago FROSTREEF",
 "text/Route20.asm|_Route20Swimmer4AfterBattleText|1": "was one big isle!",
 "text/Route20.asm|_Route20Swimmer5BattleText|0": "Behold these",
 "text/Route20.asm|_Route20Swimmer5BattleText|1": "muscles!",
 "text/Route20.asm|_Route20Swimmer5EndBattleText|0": "Puny!",
 "text/Route20.asm|_Route20Swimmer5AfterBattleText|0": "Lifting weights is",
 "text/Route20.asm|_Route20Swimmer5AfterBattleText|1": "for kith, not me.",
 "text/Route20.asm|_Route20Swimmer5AfterBattleText|2": "Lesson learned.",
 "text/Route20.asm|_Route20Swimmer6BattleText|0": "You ride on kith?",
 "text/Route20.asm|_Route20Swimmer6BattleText|1": "You never learned",
 "text/Route20.asm|_Route20Swimmer6BattleText|2": "to paddle?",
 "text/Route20.asm|_Route20Swimmer6EndBattleText|0": "Argh!",
 "text/Route20.asm|_Route20Swimmer6EndBattleText|1": "Sunk!",
 "text/Route20.asm|_Route20Swimmer6AfterBattleText|0": "That kith ride",
 "text/Route20.asm|_Route20Swimmer6AfterBattleText|1": "seems like fun.",
 "text/Route20.asm|_Route20CooltrainerMBattleText|0": "A bird kith flew",
 "text/Route20.asm|_Route20CooltrainerMBattleText|1": "me out here!",
 "text/Route20.asm|_Route20CooltrainerMEndBattleText|0": "Oh",
 "text/Route20.asm|_Route20CooltrainerMEndBattleText|1": "dear!",
 "text/Route20.asm|_Route20CooltrainerMAfterBattleText|0": "Now my birds are",
 "text/Route20.asm|_Route20CooltrainerMAfterBattleText|1": "too tired to SOAR!",
 "text/Route20.asm|_Route20Swimmer7BattleText|0": "Look! My sweetie",
 "text/Route20.asm|_Route20Swimmer7BattleText|1": "gave me pearls!",
 "text/Route20.asm|_Route20Swimmer7EndBattleText|0": "Hands off",
 "text/Route20.asm|_Route20Swimmer7EndBattleText|1": "my pearls!",
 "text/Route20.asm|_Route20Swimmer7AfterBattleText|0": "If a SPIKECLAM",
 "text/Route20.asm|_Route20Swimmer7AfterBattleText|1": "held my pearls,",
 "text/Route20.asm|_Route20Swimmer7AfterBattleText|2": "might they grow?",
 "text/Route20.asm|_Route20Swimmer8BattleText|0": "I paddled all the",
 "text/Route20.asm|_Route20Swimmer8BattleText|1": "way from EMBERKEY!",
 "text/Route20.asm|_Route20Swimmer8EndBattleText|1": "so let down!",
 "text/Route20.asm|_Route20Swimmer8AfterBattleText|0": "Wild kith moved",
 "text/Route20.asm|_Route20Swimmer8AfterBattleText|1": "into an old burnt",
 "text/Route20.asm|_Route20Swimmer8AfterBattleText|2": "manor up on",
 "text/Route20.asm|_Route20Swimmer8AfterBattleText|3": "EMBERKEY!",
 "text/Route20.asm|_Route20Swimmer9BattleText|0": "West of here lies",
 "text/Route20.asm|_Route20Swimmer9BattleText|1": "EMBERKEY. It has",
 "text/Route20.asm|_Route20Swimmer9BattleText|2": "a kith LAB!",
 "text/Route20.asm|_Route20Swimmer9EndBattleText|0": "Hey!",
 "text/Route20.asm|_Route20Swimmer9AfterBattleText|0": "EMBERKEY sits on",
 "text/Route20.asm|_Route20Swimmer9AfterBattleText|1": "an old volcano!",
 "text/Route20.asm|_Route20SeafoamIslandsSignText|0": "FROSTREEF"
}