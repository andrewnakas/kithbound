{
 "text/Route25.asm|_Route25Youngster1BattleText|0": "Tamers from town",
 "text/Route25.asm|_Route25Youngster1BattleText|1": "train out here",
 "text/Route25.asm|_Route25Youngster1BattleText|2": "all the time!",
 "text/Route25.asm|_Route25Youngster1EndBattleText|0": "Not",
 "text/Route25.asm|_Route25Youngster1EndBattleText|1": "bad.",
 "text/Route25.asm|_Route25Youngster1AfterBattleText|0": "Each kith has a",
 "text/Route25.asm|_Route25Youngster1AfterBattleText|1": "weak side. Mix up",
 "text/Route25.asm|_Route25Youngster1AfterBattleText|2": "your team so you",
 "text/Route25.asm|_Route25Youngster1AfterBattleText|3": "can cover them!",
 "text/Route25.asm|_Route25Youngster2BattleText|0": "My dad and I went",
 "text/Route25.asm|_Route25Youngster2BattleText|1": "to a fancy bash on",
 "text/Route25.asm|_Route25Youngster2BattleText|2": "the S.S.WREN in",
 "text/Route25.asm|_Route25Youngster2BattleText|3": "PORTSALT!",
 "text/Route25.asm|_Route25Youngster2EndBattleText|1": "fine. Totally!",
 "text/Route25.asm|_Route25Youngster2AfterBattleText|0": "TAMERs from every",
 "text/Route25.asm|_Route25Youngster2AfterBattleText|1": "land were on the",
 "text/Route25.asm|_Route25Youngster2AfterBattleText|2": "S.S.WREN!",
 "text/Route25.asm|_Route25CooltrainerMBattleText|0": "Check me out. I",
 "text/Route25.asm|_Route25CooltrainerMBattleText|1": "have a sweetheart,",
 "text/Route25.asm|_Route25CooltrainerMBattleText|2": "you know!",
 "text/Route25.asm|_Route25CooltrainerMEndBattleText|0": "Oh,",
 "text/Route25.asm|_Route25CooltrainerMEndBattleText|1": "bother...",
 "text/Route25.asm|_Route25CooltrainerMAfterBattleText|0": "My sweetheart will",
 "text/Route25.asm|_Route25CooltrainerMAfterBattleText|1": "perk me right up.",
 "text/Route25.asm|_Route25CooltrainerF1BattleText|0": "My sweetie is the",
 "text/Route25.asm|_Route25CooltrainerF1BattleText|1": "best around!",
 "text/Route25.asm|_Route25CooltrainerF1EndBattleText|0": "Off day",
 "text/Route25.asm|_Route25CooltrainerF1EndBattleText|1": "for me!",
 "text/Route25.asm|_Route25CooltrainerF1AfterBattleText|0": "If only my sweetie",
 "text/Route25.asm|_Route25CooltrainerF1AfterBattleText|1": "battled like you!",
 "text/Route25.asm|_Route25Youngster3BattleText|0": "I had a hunch",
 "text/Route25.asm|_Route25Youngster3BattleText|1": "we'd battle!",
 "text/Route25.asm|_Route25Youngster3EndBattleText|0": "Had a hunch",
 "text/Route25.asm|_Route25Youngster3EndBattleText|1": "I'd lose, too!",
 "text/Route25.asm|_Route25Youngster3AfterBattleText|0": "Kith dazed or",
 "text/Route25.asm|_Route25Youngster3AfterBattleText|1": "dozing? Swap in a",
 "text/Route25.asm|_Route25Youngster3AfterBattleText|2": "fresh one and let",
 "text/Route25.asm|_Route25Youngster3AfterBattleText|3": "it rest!",
 "text/Route25.asm|_Route25CooltrainerF2BattleText|0": "My pal's kith is",
 "text/Route25.asm|_Route25CooltrainerF2BattleText|1": "so cuddly. I want",
 "text/Route25.asm|_Route25CooltrainerF2BattleText|2": "one so badly!",
 "text/Route25.asm|_Route25CooltrainerF2EndBattleText|1": "over it now!",
 "text/Route25.asm|_Route25CooltrainerF2AfterBattleText|0": "Did you pass MT.",
 "text/Route25.asm|_Route25CooltrainerF2AfterBattleText|1": "HUSH? Got a spare",
 "text/Route25.asm|_Route25CooltrainerF2AfterBattleText|2": "MOONDROP for me?",
 "text/Route25.asm|_Route25Hiker1BattleText|0": "Fresh off MT.HUSH",
 "text/Route25.asm|_Route25Hiker1BattleText|1": "and still full of",
 "text/Route25.asm|_Route25Hiker1BattleText|2": "pep! Let's go!",
 "text/Route25.asm|_Route25Hiker1EndBattleText|0": "Good",
 "text/Route25.asm|_Route25Hiker1EndBattleText|1": "hustle!",
 "text/Route25.asm|_Route25Hiker1AfterBattleText|0": "Ow! A DUSKBIT",
 "text/Route25.asm|_Route25Hiker1AfterBattleText|1": "nipped my ear in",
 "text/Route25.asm|_Route25Hiker1AfterBattleText|2": "that cave.",
 "text/Route25.asm|_Route25Hiker2BattleText|0": "I'm hiking out to",
 "text/Route25.asm|_Route25Hiker2BattleText|1": "the cape to meet",
 "text/Route25.asm|_Route25Hiker2BattleText|2": "a kith hoarder!",
 "text/Route25.asm|_Route25Hiker2EndBattleText|0": "Fair",
 "text/Route25.asm|_Route25Hiker2EndBattleText|1": "and square.",
 "text/Route25.asm|_Route25Hiker2AfterBattleText|0": "That hoarder has",
 "text/Route25.asm|_Route25Hiker2AfterBattleText|1": "kith you'll never",
 "text/Route25.asm|_Route25Hiker2AfterBattleText|2": "see elsewhere!",
 "text/Route25.asm|_Route25Hiker3BattleText|0": "Off to see PIP?",
 "text/Route25.asm|_Route25Hiker3BattleText|1": "You'll have to get",
 "text/Route25.asm|_Route25Hiker3BattleText|2": "past me first!",
 "text/Route25.asm|_Route25Hiker3EndBattleText|0": "Quite",
 "text/Route25.asm|_Route25Hiker3EndBattleText|1": "the TAMER!",
 "text/Route25.asm|_Route25Hiker3AfterBattleText|0": "That path down",
 "text/Route25.asm|_Route25Hiker3AfterBattleText|1": "there cuts back",
 "text/Route25.asm|_Route25Hiker3AfterBattleText|2": "to BRINEFORD fast.",
 "text/Route25.asm|_Route25BillSignText|0": "CLIFF HUT",
 "text/Route25.asm|_Route25BillSignText|1": "Home of PIP!"
}