{
 "text/Route19.asm|_Route19CooltrainerM1BattleText|0": "A little warmup",
 "text/Route19.asm|_Route19CooltrainerM1BattleText|1": "first, then a dip!",
 "text/Route19.asm|_Route19CooltrainerM1EndBattleText|0": "Nice and",
 "text/Route19.asm|_Route19CooltrainerM1EndBattleText|1": "loose now!",
 "text/Route19.asm|_Route19CooltrainerM1AfterBattleText|0": "Cheers! Limber",
 "text/Route19.asm|_Route19CooltrainerM1AfterBattleText|1": "and ready to swim!",
 "text/Route19.asm|_Route19CooltrainerM2BattleText|0": "Hey! Stretch first",
 "text/Route19.asm|_Route19CooltrainerM2BattleText|1": "or you'll cramp!",
 "text/Route19.asm|_Route19CooltrainerM2EndBattleText|0": "Brr!",
 "text/Route19.asm|_Route19CooltrainerM2EndBattleText|1": "Cold shoulder!",
 "text/Route19.asm|_Route19CooltrainerM2AfterBattleText|0": "DRIFTJELL sting.",
 "text/Route19.asm|_Route19CooltrainerM2AfterBattleText|1": "Swim wide of them!",
 "text/Route19.asm|_Route19Swimmer1BattleText|0": "Water's lovely!",
 "text/Route19.asm|_Route19Swimmer1BattleText|1": "Hop in with me!",
 "text/Route19.asm|_Route19Swimmer1EndBattleText|0": "Big",
 "text/Route19.asm|_Route19Swimmer1EndBattleText|1": "splash!",
 "text/Route19.asm|_Route19Swimmer1AfterBattleText|0": "I'm faster in the",
 "text/Route19.asm|_Route19Swimmer1AfterBattleText|1": "water than kith!",
 "text/Route19.asm|_Route19Swimmer2BattleText|0": "I wonder what's",
 "text/Route19.asm|_Route19Swimmer2BattleText|1": "past the sea edge.",
 "text/Route19.asm|_Route19Swimmer2EndBattleText|0": "Blub!",
 "text/Route19.asm|_Route19Swimmer2AfterBattleText|0": "Two islands, out",
 "text/Route19.asm|_Route19Swimmer2AfterBattleText|1": "there in the haze!",
 "text/Route19.asm|_Route19Swimmer3BattleText|0": "I dove deep to",
 "text/Route19.asm|_Route19Swimmer3BattleText|1": "catch kith. Got",
 "text/Route19.asm|_Route19Swimmer3BattleText|2": "nothing but sand!",
 "text/Route19.asm|_Route19Swimmer3EndBattleText|0": "Lifeguard!",
 "text/Route19.asm|_Route19Swimmer3AfterBattleText|0": "Use a rod if you",
 "text/Route19.asm|_Route19Swimmer3AfterBattleText|1": "want sea kith!",
 "text/Route19.asm|_Route19Swimmer4BattleText|0": "The waves wash my",
 "text/Route19.asm|_Route19Swimmer4BattleText|1": "worries away...",
 "text/Route19.asm|_Route19Swimmer4EndBattleText|0": "Oof!",
 "text/Route19.asm|_Route19Swimmer4EndBattleText|1": "New worries!",
 "text/Route19.asm|_Route19Swimmer4AfterBattleText|0": "More waves. More",
 "text/Route19.asm|_Route19Swimmer4AfterBattleText|1": "forgetting. Sigh.",
 "text/Route19.asm|_Route19Swimmer5BattleText|0": "Ooh, cute kith to",
 "text/Route19.asm|_Route19Swimmer5BattleText|1": "ride! If I win, I",
 "text/Route19.asm|_Route19Swimmer5BattleText|2": "get to keep it!",
 "text/Route19.asm|_Route19Swimmer5EndBattleText|0": "Aww!",
 "text/Route19.asm|_Route19Swimmer5EndBattleText|1": "Not fair!",
 "text/Route19.asm|_Route19Swimmer5AfterBattleText|0": "FROSTREEF is still",
 "text/Route19.asm|_Route19Swimmer5AfterBattleText|1": "far out. Keep on",
 "text/Route19.asm|_Route19Swimmer5AfterBattleText|2": "paddling!",
 "text/Route19.asm|_Route19Swimmer6BattleText|0": "I love the sea!",
 "text/Route19.asm|_Route19Swimmer6BattleText|1": "I hate peeling!",
 "text/Route19.asm|_Route19Swimmer6EndBattleText|0": "Zap!",
 "text/Route19.asm|_Route19Swimmer6AfterBattleText|0": "My sweetheart set",
 "text/Route19.asm|_Route19Swimmer6AfterBattleText|1": "off to swim out to",
 "text/Route19.asm|_Route19Swimmer6AfterBattleText|2": "FROSTREEF.",
 "text/Route19.asm|_Route19Swimmer7BattleText|0": "Riptides out here",
 "text/Route19.asm|_Route19Swimmer7BattleText|1": "drag folks under!",
 "text/Route19.asm|_Route19Swimmer7EndBattleText|0": "Yikes!",
 "text/Route19.asm|_Route19Swimmer7EndBattleText|1": "Rough waters!",
 "text/Route19.asm|_Route19Swimmer7AfterBattleText|0": "Ow, leg cramp!",
 "text/Route19.asm|_Route19Swimmer7AfterBattleText|1": "Blub, blub...",
 "text/Route19.asm|_Route19Swimmer8BattleText|0": "Long swim. My arms",
 "text/Route19.asm|_Route19Swimmer8BattleText|1": "are jelly.",
 "text/Route19.asm|_Route19Swimmer8EndBattleText|1": "all worn out...",
 "text/Route19.asm|_Route19Swimmer8AfterBattleText|0": "A SEAFERRY could",
 "text/Route19.asm|_Route19Swimmer8AfterBattleText|1": "ferry you over",
 "text/Route19.asm|_Route19Swimmer8AfterBattleText|2": "the waves, dry!",
 "text/Route19.asm|_Route19SignText|0": "SEA PATH 19",
 "text/Route19.asm|_Route19SignText|1": "MARSHGATE to",
 "text/Route19.asm|_Route19SignText|2": "FROSTREEF"
}