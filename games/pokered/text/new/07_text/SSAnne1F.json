{
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|0": "Welcome aboard!",
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|1": "I wait tables on",
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|2": "the S.S.WREN!",
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|3": "Ask for whatever",
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|4": "you like, and it",
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|5": "will be served!",
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|6": "Ah, not a talker?",
 "text/SSAnne1F.asm|_SSAnne1FWaiterText|7": "How mysterious!",
 "text/SSAnne1F.asm|_SSAnne1FSailorText|0": "Folks on board are",
 "text/SSAnne1F.asm|_SSAnne1FSailorText|1": "getting antsy!",
 "text/SSAnne1F.asm|_SSAnne1FSailorText|2": "The ones with",
 "text/SSAnne1F.asm|_SSAnne1FSailorText|3": "nothing to do may",
 "text/SSAnne1F.asm|_SSAnne1FSailorText|4": "want a battle!"
}