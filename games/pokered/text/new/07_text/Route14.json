{
 "text/Route14.asm|_Route14CooltrainerM1BattleText|0": "Skill scrolls make",
 "text/Route14.asm|_Route14CooltrainerM1BattleText|1": "a so-so kith into",
 "text/Route14.asm|_Route14CooltrainerM1BattleText|2": "a real headache!",
 "text/Route14.asm|_Route14CooltrainerM1EndBattleText|0": "My scrolls",
 "text/Route14.asm|_Route14CooltrainerM1EndBattleText|1": "let me down!",
 "text/Route14.asm|_Route14CooltrainerM1AfterBattleText|0": "A KS skill sticks",
 "text/Route14.asm|_Route14CooltrainerM1AfterBattleText|1": "for good. A kith",
 "text/Route14.asm|_Route14CooltrainerM1AfterBattleText|2": "keeps it all its",
 "text/Route14.asm|_Route14CooltrainerM1AfterBattleText|3": "life, so choose!",
 "text/Route14.asm|_Route14CooltrainerM2BattleText|0": "My flock has been",
 "text/Route14.asm|_Route14CooltrainerM2BattleText|1": "preening all day.",
 "text/Route14.asm|_Route14CooltrainerM2BattleText|2": "Time to show off!",
 "text/Route14.asm|_Route14CooltrainerM2EndBattleText|0": "Feathers",
 "text/Route14.asm|_Route14CooltrainerM2EndBattleText|1": "everywhere!",
 "text/Route14.asm|_Route14CooltrainerM2AfterBattleText|0": "Pretty plumes win",
 "text/Route14.asm|_Route14CooltrainerM2AfterBattleText|1": "no fights, I see.",
 "text/Route14.asm|_Route14CooltrainerM3BattleText|0": "BLOSSBURY BAZAAR",
 "text/Route14.asm|_Route14CooltrainerM3BattleText|1": "sells SC scrolls.",
 "text/Route14.asm|_Route14CooltrainerM3BattleText|2": "KS scrolls, now...",
 "text/Route14.asm|_Route14CooltrainerM3BattleText|3": "those are rare!",
 "text/Route14.asm|_Route14CooltrainerM3EndBattleText|0": "Oof,",
 "text/Route14.asm|_Route14CooltrainerM3EndBattleText|1": "fair enough.",
 "text/Route14.asm|_Route14CooltrainerM3AfterBattleText|0": "A LEAF kith with a",
 "text/Route14.asm|_Route14CooltrainerM3AfterBattleText|1": "LEAF skill hits",
 "text/Route14.asm|_Route14CooltrainerM3AfterBattleText|2": "harder. Match the",
 "text/Route14.asm|_Route14CooltrainerM3AfterBattleText|3": "type to the user!",
 "text/Route14.asm|_Route14CooltrainerM4BattleText|0": "Can your feathered",
 "text/Route14.asm|_Route14CooltrainerM4BattleText|1": "friends SOAR you",
 "text/Route14.asm|_Route14CooltrainerM4BattleText|2": "across the map?",
 "text/Route14.asm|_Route14CooltrainerM4EndBattleText|0": "Clipped",
 "text/Route14.asm|_Route14CooltrainerM4EndBattleText|1": "my wings!",
 "text/Route14.asm|_Route14CooltrainerM4AfterBattleText|0": "Sky kith are the",
 "text/Route14.asm|_Route14CooltrainerM4AfterBattleText|1": "only kith for me.",
 "text/Route14.asm|_Route14CooltrainerM5BattleText|0": "They say three",
 "text/Route14.asm|_Route14CooltrainerM5BattleText|1": "great birds rule",
 "text/Route14.asm|_Route14CooltrainerM5BattleText|2": "the far skies...",
 "text/Route14.asm|_Route14CooltrainerM5EndBattleText|0": "How?",
 "text/Route14.asm|_Route14CooltrainerM5EndBattleText|1": "Explain it!",
 "text/Route14.asm|_Route14CooltrainerM5AfterBattleText|0": "Frost, storm and",
 "text/Route14.asm|_Route14CooltrainerM5AfterBattleText|1": "flame, one bird",
 "text/Route14.asm|_Route14CooltrainerM5AfterBattleText|2": "each. I'll see one!",
 "text/Route14.asm|_Route14CooltrainerM6BattleText|0": "Eh, battles bore",
 "text/Route14.asm|_Route14CooltrainerM6BattleText|1": "me. Fine, one go.",
 "text/Route14.asm|_Route14CooltrainerM6EndBattleText|1": "saw that coming.",
 "text/Route14.asm|_Route14CooltrainerM6AfterBattleText|0": "Win today, lose",
 "text/Route14.asm|_Route14CooltrainerM6AfterBattleText|1": "next week. It all",
 "text/Route14.asm|_Route14CooltrainerM6AfterBattleText|2": "evens out, really.",
 "text/Route14.asm|_Route14Biker1BattleText|0": "Move it, move it!",
 "text/Route14.asm|_Route14Biker1BattleText|1": "I've got places",
 "text/Route14.asm|_Route14Biker1BattleText|2": "to be, kid!",
 "text/Route14.asm|_Route14Biker1EndBattleText|0": "Grr!",
 "text/Route14.asm|_Route14Biker1EndBattleText|1": "Scram already!",
 "text/Route14.asm|_Route14Biker1AfterBattleText|0": "Huh? You again?",
 "text/Route14.asm|_Route14Biker1AfterBattleText|1": "Make it quick!",
 "text/Route14.asm|_Route14Biker2BattleText|0": "Great, a kid! My",
 "text/Route14.asm|_Route14Biker2BattleText|1": "day was so dull.",
 "text/Route14.asm|_Route14Biker2EndBattleText|0": "Hold on.",
 "text/Route14.asm|_Route14Biker2EndBattleText|1": "That's it?",
 "text/Route14.asm|_Route14Biker2AfterBattleText|0": "Feeding kith all",
 "text/Route14.asm|_Route14Biker2AfterBattleText|1": "week? So tiring.",
 "text/Route14.asm|_Route14Biker3BattleText|0": "The open road out",
 "text/Route14.asm|_Route14Biker3BattleText|1": "here is ours. Lots",
 "text/Route14.asm|_Route14Biker3BattleText|2": "of elbow room!",
 "text/Route14.asm|_Route14Biker3EndBattleText|0": "Skidded!",
 "text/Route14.asm|_Route14Biker3AfterBattleText|0": "Your kith hit like",
 "text/Route14.asm|_Route14Biker3AfterBattleText|1": "freight trains. I",
 "text/Route14.asm|_Route14Biker3AfterBattleText|2": "respect that.",
 "text/Route14.asm|_Route14Biker3AfterBattleText|3": "Strength talks",
 "text/Route14.asm|_Route14Biker3AfterBattleText|4": "loudest, kid!",
 "text/Route14.asm|_Route14Biker4BattleText|0": "A scrap? Yes!",
 "text/Route14.asm|_Route14Biker4BattleText|1": "Gimme gimme!",
 "text/Route14.asm|_Route14Biker4EndBattleText|0": "Flat",
 "text/Route14.asm|_Route14Biker4EndBattleText|1": "tire!",
 "text/Route14.asm|_Route14Biker4AfterBattleText|0": "Next time, no",
 "text/Route14.asm|_Route14Biker4AfterBattleText|1": "kith. Just me, you",
 "text/Route14.asm|_Route14Biker4AfterBattleText|2": "and a drag race!",
 "text/Route14.asm|_Route14SignText|0": "PATH 14",
 "text/Route14.asm|_Route14SignText|1": "MARSHGATE lies",
 "text/Route14.asm|_Route14SignText|2": "to the west"
}