{
 "text/Route15.asm|_Route15CooltrainerF1BattleText|0": "Fresh from a swap!",
 "text/Route15.asm|_Route15CooltrainerF1BattleText|1": "Let's see what my",
 "text/Route15.asm|_Route15CooltrainerF1BattleText|2": "new kith can do!",
 "text/Route15.asm|_Route15CooltrainerF1EndBattleText|0": "Not my",
 "text/Route15.asm|_Route15CooltrainerF1EndBattleText|1": "new pal!",
 "text/Route15.asm|_Route15CooltrainerF1AfterBattleText|0": "Swapped kith keep",
 "text/Route15.asm|_Route15CooltrainerF1AfterBattleText|1": "the name given to",
 "text/Route15.asm|_Route15CooltrainerF1AfterBattleText|2": "them by whoever",
 "text/Route15.asm|_Route15CooltrainerF1AfterBattleText|3": "caught them first.",
 "text/Route15.asm|_Route15CooltrainerF1AfterBattleText|4": "That first TAMER",
 "text/Route15.asm|_Route15CooltrainerF1AfterBattleText|5": "picks it for life.",
 "text/Route15.asm|_Route15CooltrainerF2BattleText|0": "You seem sweet.",
 "text/Route15.asm|_Route15CooltrainerF2BattleText|1": "Sweet means easy,",
 "text/Route15.asm|_Route15CooltrainerF2BattleText|2": "right?",
 "text/Route15.asm|_Route15CooltrainerF2EndBattleText|0": "Not easy",
 "text/Route15.asm|_Route15CooltrainerF2EndBattleText|1": "at all!",
 "text/Route15.asm|_Route15CooltrainerF2AfterBattleText|0": "Those ROADHOGs up",
 "text/Route15.asm|_Route15CooltrainerF2AfterBattleText|1": "the road give me",
 "text/Route15.asm|_Route15CooltrainerF2AfterBattleText|2": "the shivers!",
 "text/Route15.asm|_Route15CooltrainerM1BattleText|0": "One whistle and",
 "text/Route15.asm|_Route15CooltrainerM1BattleText|1": "the whole flock",
 "text/Route15.asm|_Route15CooltrainerM1BattleText|2": "comes running!",
 "text/Route15.asm|_Route15CooltrainerM1EndBattleText|0": "Aw!",
 "text/Route15.asm|_Route15CooltrainerM1EndBattleText|1": "Bad whistle!",
 "text/Route15.asm|_Route15CooltrainerM1AfterBattleText|0": "I'll stick to bird",
 "text/Route15.asm|_Route15CooltrainerM1AfterBattleText|1": "watching, I think.",
 "text/Route15.asm|_Route15CooltrainerM2BattleText|0": "Oho? My flock is",
 "text/Route15.asm|_Route15CooltrainerM2BattleText|1": "trembling. You've",
 "text/Route15.asm|_Route15CooltrainerM2BattleText|2": "got skill, eh?",
 "text/Route15.asm|_Route15CooltrainerM2EndBattleText|0": "Called",
 "text/Route15.asm|_Route15CooltrainerM2EndBattleText|1": "it!",
 "text/Route15.asm|_Route15CooltrainerM2AfterBattleText|0": "UPHEAVAL shakes",
 "text/Route15.asm|_Route15CooltrainerM2AfterBattleText|1": "the ground, so it",
 "text/Route15.asm|_Route15CooltrainerM2AfterBattleText|2": "can't touch kith",
 "text/Route15.asm|_Route15CooltrainerM2AfterBattleText|3": "up in the air!",
 "text/Route15.asm|_Route15Beauty1BattleText|0": "Aww, look at you!",
 "text/Route15.asm|_Route15Beauty1BattleText|1": "So adorable!",
 "text/Route15.asm|_Route15Beauty1EndBattleText|0": "Adorable",
 "text/Route15.asm|_Route15Beauty1EndBattleText|1": "and tough?",
 "text/Route15.asm|_Route15Beauty1AfterBattleText|0": "No hard feelings!",
 "text/Route15.asm|_Route15Beauty1AfterBattleText|1": "I'm a good sport.",
 "text/Route15.asm|_Route15Beauty2BattleText|0": "My flat is quiet,",
 "text/Route15.asm|_Route15Beauty2BattleText|1": "so I keep kith for",
 "text/Route15.asm|_Route15Beauty2BattleText|2": "company!",
 "text/Route15.asm|_Route15Beauty2EndBattleText|0": "Rude, just",
 "text/Route15.asm|_Route15Beauty2EndBattleText|1": "plain rude!",
 "text/Route15.asm|_Route15Beauty2AfterBattleText|0": "At night my kith",
 "text/Route15.asm|_Route15Beauty2AfterBattleText|1": "curl up beside me.",
 "text/Route15.asm|_Route15Beauty2AfterBattleText|2": "Best part of it!",
 "text/Route15.asm|_Route15Biker1BattleText|0": "Psst, kid! Got new",
 "text/Route15.asm|_Route15Biker1BattleText|1": "kith! Try them!",
 "text/Route15.asm|_Route15Biker1EndBattleText|0": "Aw,",
 "text/Route15.asm|_Route15Biker1EndBattleText|1": "c'mon!",
 "text/Route15.asm|_Route15Biker1AfterBattleText|0": "Rules? Curfews?",
 "text/Route15.asm|_Route15Biker1AfterBattleText|1": "Not for me, pal!",
 "text/Route15.asm|_Route15Biker1AfterBattleText|2": "The GLOAM crew is",
 "text/Route15.asm|_Route15Biker1AfterBattleText|3": "the best around!",
 "text/Route15.asm|_Route15Biker2BattleText|0": "Lose and your coin",
 "text/Route15.asm|_Route15Biker2BattleText|1": "goes in my boot,",
 "text/Route15.asm|_Route15Biker2BattleText|2": "got it?",
 "text/Route15.asm|_Route15Biker2EndBattleText|0": "My boot",
 "text/Route15.asm|_Route15Biker2EndBattleText|1": "stays empty!",
 "text/Route15.asm|_Route15Biker2AfterBattleText|0": "Kidding! I'd never",
 "text/Route15.asm|_Route15Biker2AfterBattleText|1": "really take it!",
 "text/Route15.asm|_Route15CooltrainerF3BattleText|0": "Know what's fun?",
 "text/Route15.asm|_Route15CooltrainerF3BattleText|1": "Swapping kith!",
 "text/Route15.asm|_Route15CooltrainerF3EndBattleText|1": "wanted a swap!",
 "text/Route15.asm|_Route15CooltrainerF3AfterBattleText|0": "My pals and I swap",
 "text/Route15.asm|_Route15CooltrainerF3AfterBattleText|1": "kith every week!",
 "text/Route15.asm|_Route15CooltrainerF4BattleText|0": "My kith want a",
 "text/Route15.asm|_Route15CooltrainerF4BattleText|1": "playdate! Ready?",
 "text/Route15.asm|_Route15CooltrainerF4EndBattleText|0": "Rushed it,",
 "text/Route15.asm|_Route15CooltrainerF4EndBattleText|1": "didn't I?",
 "text/Route15.asm|_Route15CooltrainerF4AfterBattleText|0": "Back to practice",
 "text/Route15.asm|_Route15CooltrainerF4AfterBattleText|1": "with beginners.@",
 "text/Route15.asm|_Route15SignText|0": "PATH 15",
 "text/Route15.asm|_Route15SignText|1": "MARSHGATE lies",
 "text/Route15.asm|_Route15SignText|2": "to the west"
}