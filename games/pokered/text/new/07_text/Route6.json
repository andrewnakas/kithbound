{
 "text/Route6.asm|_Route6CooltrainerM1BattleText|0": "Hey! Are you",
 "text/Route6.asm|_Route6CooltrainerM1BattleText|1": "eavesdropping on",
 "text/Route6.asm|_Route6CooltrainerM1BattleText|2": "our talk?",
 "text/Route6.asm|_Route6CooltrainerM1EndBattleText|1": "never get lucky!",
 "text/Route6.asm|_Route6CooltrainerAfterBattleText|0": "Psst...",
 "text/Route6.asm|_Route6CooltrainerAfterBattleText|1": "psst...",
 "text/Route6.asm|_Route6CooltrainerF1BattleText|0": "Ahem! We were",
 "text/Route6.asm|_Route6CooltrainerF1BattleText|1": "talking, thank",
 "text/Route6.asm|_Route6CooltrainerF1BattleText|2": "you very much!",
 "text/Route6.asm|_Route6CooltrainerF1EndBattleText|0": "Hmph!",
 "text/Route6.asm|_Route6CooltrainerF1EndBattleText|1": "Not fair!",
 "text/Route6.asm|_Route6Youngster1BattleText|0": "Barely any bug",
 "text/Route6.asm|_Route6Youngster1BattleText|1": "kith around here.",
 "text/Route6.asm|_Route6Youngster1EndBattleText|0": "What?!",
 "text/Route6.asm|_Route6Youngster1EndBattleText|1": "Seriously?!",
 "text/Route6.asm|_Route6Youngster1AfterBattleText|0": "Bugs are my thing.",
 "text/Route6.asm|_Route6Youngster1AfterBattleText|1": "Back to TANGLEWOOD",
 "text/Route6.asm|_Route6Youngster1AfterBattleText|2": "for me!",
 "text/Route6.asm|_Route6CooltrainerM2BattleText|0": "Eh? Were you",
 "text/Route6.asm|_Route6CooltrainerM2BattleText|1": "calling me?",
 "text/Route6.asm|_Route6CooltrainerM2EndBattleText|1": "never wanted this!",
 "text/Route6.asm|_Route6CooltrainerM2AfterBattleText|0": "Maybe I ought to",
 "text/Route6.asm|_Route6CooltrainerM2AfterBattleText|1": "bring a few more",
 "text/Route6.asm|_Route6CooltrainerM2AfterBattleText|2": "kith along.",
 "text/Route6.asm|_Route6CooltrainerF2BattleText|0": "Me? Hmm, sure.",
 "text/Route6.asm|_Route6CooltrainerF2BattleText|1": "Let's have fun!",
 "text/Route6.asm|_Route6CooltrainerF2EndBattleText|0": "No luck",
 "text/Route6.asm|_Route6CooltrainerF2EndBattleText|1": "this time!",
 "text/Route6.asm|_Route6CooltrainerF2AfterBattleText|0": "I want to be tough",
 "text/Route6.asm|_Route6CooltrainerF2AfterBattleText|1": "like you! Share",
 "text/Route6.asm|_Route6CooltrainerF2AfterBattleText|2": "your tricks!",
 "text/Route6.asm|_Route6Youngster2BattleText|0": "New face, huh?",
 "text/Route6.asm|_Route6Youngster2BattleText|1": "Never seen you.",
 "text/Route6.asm|_Route6Youngster2BattleText|2": "Any good at this?",
 "text/Route6.asm|_Route6Youngster2EndBattleText|0": "Way",
 "text/Route6.asm|_Route6Youngster2EndBattleText|1": "too good!",
 "text/Route6.asm|_Route6Youngster2AfterBattleText|0": "Is it my kith who",
 "text/Route6.asm|_Route6Youngster2AfterBattleText|1": "are weak? Or is",
 "text/Route6.asm|_Route6Youngster2AfterBattleText|2": "it me?",
 "text/Route6.asm|_Route6UndergroundPathSignText|0": "UNDERPASS",
 "text/Route6.asm|_Route6UndergroundPathSignText|1": "BRINEFORD to",
 "text/Route6.asm|_Route6UndergroundPathSignText|2": "PORTSALT"
}