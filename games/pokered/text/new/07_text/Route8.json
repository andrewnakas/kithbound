 "text/Route8.asm|_Route8CooltrainerF1AfterBattleText|2": "Mine should stay",
 "text/Route8.asm|_Route8CooltrainerF1AfterBattleText|3": "tiny forever!",
 "text/Route8.asm|_Route8SuperNerd3BattleText|0": "I adore classes.",
 "text/Route8.asm|_Route8SuperNerd3BattleText|1": "And kith, too.",
 "text/Route8.asm|_Route8SuperNerd3EndBattleText|0": "Back to",
 "text/Route8.asm|_Route8SuperNerd3EndBattleText|1": "the books.",
 "text/Route8.asm|_Route8SuperNerd3AfterBattleText|0": "SPIREHOLM shut its",
 "text/Route8.asm|_Route8SuperNerd3AfterBattleText|1": "gates, so we are",
 "text/Route8.asm|_Route8SuperNerd3AfterBattleText|2": "all stuck here.",
 "text/Route8.asm|_Route8CooltrainerF2BattleText|0": "COINCAT is fluffy!",
 "text/Route8.asm|_Route8CooltrainerF2BattleText|1": "Purr, purr, purr!",
 "text/Route8.asm|_Route8CooltrainerF2EndBattleText|0": "Purr!",
 "text/Route8.asm|_Route8CooltrainerF2AfterBattleText|0": "Oh, and PIPWING",
 "text/Route8.asm|_Route8CooltrainerF2AfterBattleText|1": "and NIBBIT? So",
 "text/Route8.asm|_Route8CooltrainerF2AfterBattleText|2": "sweet as well!",
 "text/Route8.asm|_Route8CooltrainerF3BattleText|0": "Ugh, loitering at",
 "text/Route8.asm|_Route8CooltrainerF3BattleText|1": "a gate all day",
 "text/Route8.asm|_Route8CooltrainerF3BattleText|2": "looks so dumb!",
 "text/Route8.asm|_Route8CooltrainerF3EndBattleText|0": "See what",
 "text/Route8.asm|_Route8CooltrainerF3EndBattleText|1": "you did?",
 "text/Route8.asm|_Route8CooltrainerF3AfterBattleText|0": "The SPIREHOLM gate",
