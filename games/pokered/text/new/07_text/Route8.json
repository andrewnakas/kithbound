 "text/Route8.asm|_Route8CooltrainerF3AfterBattleText|2": "away every time.",
 "text/Route8.asm|_Route8CooltrainerF3AfterBattleText|3": "What a grump!",
 "text/Route8.asm|_Route8Gambler2BattleText|0": "I roam, I bet,",
 "text/Route8.asm|_Route8Gambler2BattleText|1": "I never regret!",
 "text/Route8.asm|_Route8Gambler2EndBattleText|0": "There goes",
 "text/Route8.asm|_Route8Gambler2EndBattleText|1": "my jackpot!",
 "text/Route8.asm|_Route8Gambler2AfterBattleText|0": "Betting and kith",
