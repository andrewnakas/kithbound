{
 "text/Route8.asm|_Route8SuperNerd1BattleText|0": "You can battle,",
 "text/Route8.asm|_Route8SuperNerd1BattleText|1": "sure. But can you",
 "text/Route8.asm|_Route8SuperNerd1BattleText|2": "balance equations?",
 "text/Route8.asm|_Route8SuperNerd1EndBattleText|0": "Argh!",
 "text/Route8.asm|_Route8SuperNerd1EndBattleText|1": "Reactor fire!",
 "text/Route8.asm|_Route8SuperNerd1AfterBattleText|0": "My grades beat my",
 "text/Route8.asm|_Route8SuperNerd1AfterBattleText|1": "battle record.",
 "text/Route8.asm|_Route8Gambler1BattleText|0": "Feeling lucky!",
 "text/Route8.asm|_Route8Gambler1BattleText|1": "Let's bet big!",
 "text/Route8.asm|_Route8Gambler1EndBattleText|0": "Bust!",
 "text/Route8.asm|_Route8Gambler1EndBattleText|1": "Snake eyes!",
 "text/Route8.asm|_Route8Gambler1AfterBattleText|0": "My luck's off on",
