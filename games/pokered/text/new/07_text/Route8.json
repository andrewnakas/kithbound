 "text/Route8.asm|_Route8SuperNerd2EndBattleText|1": "data!",
 "text/Route8.asm|_Route8SuperNerd2AfterBattleText|0": "Lead with MUCKLET,",
 "text/Route8.asm|_Route8SuperNerd2AfterBattleText|1": "then...hmm...",
 "text/Route8.asm|_Route8SuperNerd2AfterBattleText|2": "carry the one...",
 "text/Route8.asm|_Route8CooltrainerF1BattleText|0": "Hedgehogs are the",
 "text/Route8.asm|_Route8CooltrainerF1BattleText|1": "best! See my set!",
