{
 "text/Route24.asm|_Route24CooltrainerM1YouBeatOurContestText|0": "Wow! You toppled",
 "text/Route24.asm|_Route24CooltrainerM1YouBeatOurContestText|1": "all five of us on",
 "text/Route24.asm|_Route24CooltrainerM1YouBeatOurContestText|2": "the bridge!@",
 "text/Route24.asm|_Route24CooltrainerM1YouJustEarnedAPrizeText|0": "That earns you a",
