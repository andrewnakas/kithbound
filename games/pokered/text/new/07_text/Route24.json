 "text/Route24.asm|_Route24CooltrainerM1ReceivedNuggetText|0": "<PLAYER> got",
 "text/Route24.asm|_Route24CooltrainerM1NoRoomText|0": "Your bag can't",
 "text/Route24.asm|_Route24CooltrainerM1NoRoomText|1": "hold any more!",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|0": "Say, how'd you",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|1": "like to sign up",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|2": "with GLOAM?",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|3": "We use kith to",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|4": "take whatever we",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|5": "want. Fun, right?",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|6": "So? Are you in?",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|7": "No? Seriously?",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|8": "Don't be shy!",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|9": "Sign up already,",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|10": "I insist!",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|11": "Fine. Guess I'll",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|12": "have to persuade",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|13": "you!",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|14": "Let's make this",
 "text/Route24.asm|_Route24CooltrainerM1JoinTeamRocketText|15": "physical!",
 "text/Route24.asm|_Route24CooltrainerM1DefeatedText|0": "Gah!",
 "text/Route24.asm|_Route24CooltrainerM1DefeatedText|1": "You're tough!",
 "text/Route24.asm|_Route24CooltrainerM1YouCouldBecomeATopLeaderText|0": "Skills like yours",
 "text/Route24.asm|_Route24CooltrainerM1YouCouldBecomeATopLeaderText|1": "would make you a",
 "text/Route24.asm|_Route24CooltrainerM1YouCouldBecomeATopLeaderText|2": "big boss in GLOAM",
 "text/Route24.asm|_Route24CooltrainerM1YouCouldBecomeATopLeaderText|3": "in no time!",
 "text/Route24.asm|_Route24CooltrainerM2BattleText|0": "I watched you go",
 "text/Route24.asm|_Route24CooltrainerM2BattleText|1": "down the line!"
}