{
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsWigglytuffText|0": "BALLADOON: Fwoo",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsWigglytuffText|1": "fwooo!@",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1BattleText|0": "I roam the world",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1BattleText|1": "all by myself!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1BattleText|2": "My kith are all",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1BattleText|3": "the crew I need!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1EndBattleText|0": "My dear",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1EndBattleText|1": "companions...",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1AfterBattleText|0": "Treat your kith",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman1AfterBattleText|1": "kindly, my boy!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman2BattleText|0": "Insolent brat!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman2BattleText|1": "Barging in here!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman2EndBattleText|0": "Hmph!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman2EndBattleText|1": "No manners!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman2AfterBattleText|0": "Leave my cabin",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman2AfterBattleText|1": "this instant!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterBattleText|0": "Kith are great!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterBattleText|1": "You agree?",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterEndBattleText|0": "Whoa!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterEndBattleText|1": "Amazing!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterAfterBattleText|0": "Can we be pals?",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterAfterBattleText|1": "Please?",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterAfterBattleText|2": "Then we could",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsYoungsterAfterBattleText|3": "swap kith!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFBattleText|0": "My kith come from",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFBattleText|1": "every port on the",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFBattleText|2": "map, you know!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFEndBattleText|0": "No!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFEndBattleText|1": "I sailed so far",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFEndBattleText|2": "to find them!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFAfterBattleText|0": "My well-traveled",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFAfterBattleText|1": "kith are hurt!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFAfterBattleText|2": "You owe them a",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFAfterBattleText|3": "trip to a",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsCooltrainerFAfterBattleText|4": "REST HOUSE visit!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGirl1Text|0": "Excuse me! One",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGirl1Text|1": "plum tart, please,",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGirl1Text|2": "and quickly!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsMiddleAgedManText|0": "Sailing is so very",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsMiddleAgedManText|1": "grand, yet snug!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsLittleGirlText|0": "BALLADOON joins me",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsLittleGirlText|1": "on every trip!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGirl2Text|0": "We are sailing all",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGirl2Text|1": "over the globe.",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman3Text|0": "Hush! I'm an agent",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman3Text|1": "of WORLD WATCH!",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman3Text|2": "I'm hunting down",
 "text/SSAnne1FRooms.asm|_SSAnne1FRoomsGentleman3Text|3": "the GLOAM gang!"
}