{
 "text/ViridianForest.asm|_ViridianForestYoungster1Text|0": "My pals dragged",
 "text/ViridianForest.asm|_ViridianForestYoungster1Text|1": "me out here!",
 "text/ViridianForest.asm|_ViridianForestYoungster1Text|2": "They went looking",
 "text/ViridianForest.asm|_ViridianForestYoungster1Text|3": "for battles!",
 "text/ViridianForest.asm|_ViridianForestYoungster2BattleText|0": "You've got KITH",
 "text/ViridianForest.asm|_ViridianForestYoungster2BattleText|1": "too? Then let's",
 "text/ViridianForest.asm|_ViridianForestYoungster2BattleText|2": "go a round!",
 "text/ViridianForest.asm|_ViridianForestYoungster2EndBattleText|0": "Aww!",
 "text/ViridianForest.asm|_ViridianForestYoungster2EndBattleText|1": "My SILKLING",
 "text/ViridianForest.asm|_ViridianForestYoungster2EndBattleText|2": "wasn't enough!",
 "text/ViridianForest.asm|_ViridianForestYoungster2AfterBattleText|0": "Shh! The bugs",
 "text/ViridianForest.asm|_ViridianForestYoungster2AfterBattleText|1": "spook easily!",
 "text/ViridianForest.asm|_ViridianForestYoungster3BattleText|0": "A TAMER can't",
 "text/ViridianForest.asm|_ViridianForestYoungster3BattleText|1": "dodge a fight!",
 "text/ViridianForest.asm|_ViridianForestYoungster3BattleText|2": "Them's the rules!",
 "text/ViridianForest.asm|_ViridianForestYoungster3EndBattleText|0": "Eh?",
 "text/ViridianForest.asm|_ViridianForestYoungster3EndBattleText|1": "That was my last",
 "text/ViridianForest.asm|_ViridianForestYoungster3EndBattleText|2": "KITH!",
 "text/ViridianForest.asm|_ViridianForestYoungster3AfterBattleText|0": "Next time I'll",
 "text/ViridianForest.asm|_ViridianForestYoungster3AfterBattleText|1": "bring tougher",
 "text/ViridianForest.asm|_ViridianForestYoungster3AfterBattleText|2": "bugs. Promise!",
 "text/ViridianForest.asm|_ViridianForestYoungster4BattleText|0": "Oi, slow down!",
 "text/ViridianForest.asm|_ViridianForestYoungster4BattleText|1": "Where's the fire?",
 "text/ViridianForest.asm|_ViridianForestYoungster4EndBattleText|1": "fold! That was",
 "text/ViridianForest.asm|_ViridianForestYoungster4EndBattleText|2": "slick of you!",
 "text/ViridianForest.asm|_ViridianForestYoungster4AfterBattleText|0": "Keep your eyes on",
 "text/ViridianForest.asm|_ViridianForestYoungster4AfterBattleText|1": "the dirt. Loot",
 "text/ViridianForest.asm|_ViridianForestYoungster4AfterBattleText|2": "turns up there!",
 "text/ViridianForest.asm|_ViridianForestYoungster4AfterBattleText|3": "I'm hunting for",
 "text/ViridianForest.asm|_ViridianForestYoungster4AfterBattleText|4": "a coin I let",
 "text/ViridianForest.asm|_ViridianForestYoungster4AfterBattleText|5": "slip earlier.",
 "text/ViridianForest.asm|_ViridianForestYoungster5Text|0": "I'm out of SNAREs",
 "text/ViridianForest.asm|_ViridianForestYoungster5Text|1": "and there's a",
 "text/ViridianForest.asm|_ViridianForestYoungster5Text|2": "KITH right there!",
 "text/ViridianForest.asm|_ViridianForestYoungster5Text|3": "Always pack a",
 "text/ViridianForest.asm|_ViridianForestYoungster5Text|4": "few spares!",
 "text/ViridianForest.asm|_ViridianForestTrainerTips1Text|0": "TAMER NOTES",
 "text/ViridianForest.asm|_ViridianForestTrainerTips1Text|1": "Tall grass hides",
 "text/ViridianForest.asm|_ViridianForestTrainerTips1Text|2": "wild KITH.",
 "text/ViridianForest.asm|_ViridianForestTrainerTips1Text|3": "Stick to paths",
 "text/ViridianForest.asm|_ViridianForestTrainerTips1Text|4": "to keep moving!",
 "text/ViridianForest.asm|_ViridianForestUseAntidoteSignText|0": "Venom got you?",
 "text/ViridianForest.asm|_ViridianForestUseAntidoteSignText|1": "A CLEANSER fixes",
 "text/ViridianForest.asm|_ViridianForestUseAntidoteSignText|2": "it. Ask a SUPPLY!",
 "text/ViridianForest.asm|_ViridianForestTrainerTips2Text|0": "TAMER NOTES",
 "text/ViridianForest.asm|_ViridianForestTrainerTips2Text|1": "Ring PROF.BRAMBLE",
 "text/ViridianForest.asm|_ViridianForestTrainerTips2Text|2": "on any PC to",
 "text/ViridianForest.asm|_ViridianForestTrainerTips2Text|3": "get your KITHLOG",
 "text/ViridianForest.asm|_ViridianForestTrainerTips2Text|4": "graded!",
 "text/ViridianForest.asm|_ViridianForestTrainerTips3Text|0": "TAMER NOTES",
 "text/ViridianForest.asm|_ViridianForestTrainerTips3Text|1": "Another TAMER's",
 "text/ViridianForest.asm|_ViridianForestTrainerTips3Text|2": "KITH are theirs",
 "text/ViridianForest.asm|_ViridianForestTrainerTips3Text|3": "for keeps!",
 "text/ViridianForest.asm|_ViridianForestTrainerTips3Text|4": "Wild ones only",
 "text/ViridianForest.asm|_ViridianForestTrainerTips3Text|5": "for your SNAREs!",
 "text/ViridianForest.asm|_ViridianForestTrainerTips4Text|0": "TAMER NOTES",
 "text/ViridianForest.asm|_ViridianForestTrainerTips4Text|1": "A KITH at full",
 "text/ViridianForest.asm|_ViridianForestTrainerTips4Text|2": "health tends to",
 "text/ViridianForest.asm|_ViridianForestTrainerTips4Text|3": "bust out!",
 "text/ViridianForest.asm|_ViridianForestTrainerTips4Text|4": "Wear it down",
 "text/ViridianForest.asm|_ViridianForestTrainerTips4Text|5": "before you throw.",
 "text/ViridianForest.asm|_ViridianForestLeavingSignText|0": "NOW EXITING",
 "text/ViridianForest.asm|_ViridianForestLeavingSignText|1": "TANGLEWOOD",
 "text/ViridianForest.asm|_ViridianForestLeavingSignText|2": "FLINTON THIS WAY"
