{
 "text/VermilionOldRodHouse.asm|_VermilionOldRodHouseFishingGuruDoYouLikeToFishText|0": "Ahoy! They call me",
 "text/VermilionOldRodHouse.asm|_VermilionOldRodHouseFishingGuruDoYouLikeToFishText|1": "the ANGLER KING!",
 "text/VermilionOldRodHouse.asm|_VermilionOldRodHouseFishingGuruDoYouLikeToFishText|2": "Nothing beats a",
