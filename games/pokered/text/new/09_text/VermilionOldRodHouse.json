 "text/VermilionOldRodHouse.asm|_VermilionOldRodHouseFishingGuruDoYouLikeToFishText|5": "line yourself?",
 "text/VermilionOldRodHouse.asm|_VermilionOldRodHouseFishingGuruTakeThisText|0": "Splendid! A fellow",
 "text/VermilionOldRodHouse.asm|_VermilionOldRodHouseFishingGuruTakeThisText|1": "angler at last!",
 "text/VermilionOldRodHouse.asm|_VermilionOldRodHouseFishingGuruTakeThisText|2": "Here, a starter",
