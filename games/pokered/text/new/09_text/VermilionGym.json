{
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|0": "Halt, cadet! Who",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|1": "let a pup into",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|2": "my barracks?",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|3": "Out in the field",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|4": "you'd be toast in",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|5": "a minute flat!",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|6": "Back in my tour,",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|7": "VOLT KITH kept",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|8": "my whole unit",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|9": "breathing!",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|10": "Their sparks left",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|11": "the other side",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|12": "locked up stiff!",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|13": "Ready for your",
 "text/VermilionGym.asm|_VermilionGymLTSurgePreBattleText|14": "own dose?"
}