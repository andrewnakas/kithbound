{
 "text/VermilionGym_2.asm|_VermilionGymLTSurgePostBattleAdviceText|0": "Listen up, cadet!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgePostBattleAdviceText|1": "Sparks hit hard,",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgePostBattleAdviceText|2": "no question.",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgePostBattleAdviceText|3": "But SOIL KITH",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgePostBattleAdviceText|4": "shrug them off",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgePostBattleAdviceText|5": "like rain on a",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgePostBattleAdviceText|6": "tin roof!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|0": "The VOLT BADGE",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|1": "puts pep in your",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|2": "KITH's step!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|3": "Plus, your KITH",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|4": "can SOAR from",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|5": "town to town!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|6": "You earned a bit",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeThunderBadgeInfoText|7": "more. Here!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeReceivedTM24Text|0": "<PLAYER> earned ",
 "text/VermilionGym_2.asm|_TM24ExplanationText|0": "SC24 is VOLT ARC!",
 "text/VermilionGym_2.asm|_TM24ExplanationText|1": "Fine choice for",
 "text/VermilionGym_2.asm|_TM24ExplanationText|2": "any VOLT KITH",
 "text/VermilionGym_2.asm|_TM24ExplanationText|3": "in your squad!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeTM24NoRoomText|0": "Your bag's full,",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeTM24NoRoomText|1": "cadet! Clear it!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeReceivedThunderBadgeText|0": "Ha!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeReceivedThunderBadgeText|1": "Not bad at all,",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeReceivedThunderBadgeText|2": "cadet!",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeReceivedThunderBadgeText|3": "Here, the VOLT",
 "text/VermilionGym_2.asm|_VermilionGymLTSurgeReceivedThunderBadgeText|4": "BADGE is yours!",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanBattleText|0": "I served under",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanBattleText|1": "MAJ.VOLTA. Hardest",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanBattleText|2": "boss I ever had!",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanEndBattleText|0": "Enough!",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanEndBattleText|1": "Well fought!",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanAfterBattleText|0": "Gate stuck?",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanAfterBattleText|1": "Ha, of course!",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanAfterBattleText|2": "The MAJOR guards",
 "text/VermilionGym_2.asm|_VermilionGymGentlemanAfterBattleText|3": "every inch here.",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdBattleText|0": "I'm scrawny, but",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdBattleText|1": "I wire my KITH",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdBattleText|2": "for max voltage!",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdEndBattleText|0": "Shorted out!",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdAfterBattleText|0": "Fine, a tip!",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdAfterBattleText|1": "The MAJOR tucked",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdAfterBattleText|2": "the gate switches",
 "text/VermilionGym_2.asm|_VermilionGymSuperNerdAfterBattleText|3": "into the bins!",
 "text/VermilionGym_2.asm|_VermilionGymSailorBattleText|0": "Scram! Grown-ups",
 "text/VermilionGym_2.asm|_VermilionGymSailorBattleText|1": "only in here!",
 "text/VermilionGym_2.asm|_VermilionGymSailorEndBattleText|0": "Huh!",
 "text/VermilionGym_2.asm|_VermilionGymSailorEndBattleText|1": "Didn't see that!",
 "text/VermilionGym_2.asm|_VermilionGymSailorAfterBattleText|0": "Two locks guard",
 "text/VermilionGym_2.asm|_VermilionGymSailorAfterBattleText|1": "the MAJOR's door.",
 "text/VermilionGym_2.asm|_VermilionGymSailorAfterBattleText|2": "Free tip for you:",
 "text/VermilionGym_2.asm|_VermilionGymSailorAfterBattleText|3": "Find the first",
 "text/VermilionGym_2.asm|_VermilionGymSailorAfterBattleText|4": "switch, and the",
 "text/VermilionGym_2.asm|_VermilionGymSailorAfterBattleText|5": "second one hides",
 "text/VermilionGym_2.asm|_VermilionGymSailorAfterBattleText|6": "right beside it!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|0": "Hey there, future",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|1": "champ!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|2": "Folks around here",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|3": "call MAJ.VOLTA",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|4": "the Storm in",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|5": "Uniform!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|6": "VOLT KITH are",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|7": "his whole army!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|8": "GALE and TIDE",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|9": "KITH will fry!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|10": "And watch for",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|11": "stiff, numb legs!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|12": "He's also a",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|13": "worrier!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|14": "His door has a",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|15": "puzzle lock. You",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|16": "must crack it",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideChampInMakingText|17": "first!",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideBeatLTSurgeText|0": "Wow! My hair is",
 "text/VermilionGym_2.asm|_VermilionGymGymGuideBeatLTSurgeText|1": "still standing up!"
}