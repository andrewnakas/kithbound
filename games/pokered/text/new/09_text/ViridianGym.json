{
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|0": "So. You found my",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|1": "secret lair.",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|2": "I meant to raise",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|3": "GLOAM from the",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|4": "ashes, right here.",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|5": "Yet once again",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|6": "you stand in my",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|7": "way! Very well.",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|8": "No mercy this",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|9": "time, child!",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|10": "Come, then! Face",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|11": "VANCE, the",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|12": "finest TAMER",
 "text/ViridianGym.asm|_ViridianGymGiovanniPreBattleText|13": "who ever lived!",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedEarthBadgeText|0": "Hah!",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedEarthBadgeText|1": "What a battle!",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedEarthBadgeText|2": "I yield. You",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedEarthBadgeText|3": "have bested me.",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedEarthBadgeText|4": "Take this, the",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedEarthBadgeText|5": "CROWN BADGE!@",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|0": "Beaten twice...",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|1": "my agents would",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|2": "laugh at me.",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|3": "So be it. GLOAM",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|4": "ends tonight.",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|5": "From now on, I",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|6": "will study KITH,",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|7": "not rule them.",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|8": "Perhaps fate will",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|9": "cross our paths",
 "text/ViridianGym.asm|_ViridianGymGiovanniPostBattleAdviceText|10": "again. Goodbye!@",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|0": "With the CROWN",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|1": "BADGE, every KITH",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|2": "heeds you, no",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|3": "matter its level!",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|4": "It marks you as",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|5": "a TAMER of the",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|6": "highest rank.",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|7": "It also opens",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|8": "the gates of the",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|9": "CROWN LEAGUE.",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|10": "Take it to your",
 "text/ViridianGym.asm|_ViridianGymGiovanniEarthBadgeInfoText|11": "final challenge.",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedTM27Text|0": "<PLAYER> got",
 "text/ViridianGym.asm|_ViridianGymGiovanniReceivedTM27Text|1": "SC27!@",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27ExplanationText|0": "SC27 is CHASM!",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27ExplanationText|1": "One hit, and the",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27ExplanationText|2": "foe KITH is",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27ExplanationText|3": "simply gone!",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27ExplanationText|4": "I crafted it back",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27ExplanationText|5": "when this GYM was",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27ExplanationText|6": "mine, years ago.",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27NoRoomText|0": "Your bag can't",
 "text/ViridianGym.asm|_ViridianGymGiovanniTM27NoRoomText|1": "hold this.",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM1BattleText|0": "Huffing and",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM1BattleText|1": "puffing yet? You",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM1BattleText|2": "will be soon!",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM1EndBattleText|1": "am all tapped out!",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM1AfterBattleText|0": "Our LEADER takes",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM1AfterBattleText|1": "real muscle to",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM1AfterBattleText|2": "keep pace with!",
 "text/ViridianGym.asm|_ViridianGymHiker1BattleText|0": "Grrrah! I'm",
 "text/ViridianGym.asm|_ViridianGymHiker1BattleText|1": "stoking my own",
 "text/ViridianGym.asm|_ViridianGymHiker1BattleText|2": "temper!",
 "text/ViridianGym.asm|_ViridianGymHiker1EndBattleText|0": "Gwah!",
 "text/ViridianGym.asm|_ViridianGymHiker1AfterBattleText|0": "I'm not good",
 "text/ViridianGym.asm|_ViridianGymHiker1AfterBattleText|1": "enough yet!",
 "text/ViridianGym.asm|_ViridianGymRocker1BattleText|0": "My KITH and I",
 "text/ViridianGym.asm|_ViridianGymRocker1BattleText|1": "jam like a real",
 "text/ViridianGym.asm|_ViridianGymRocker1BattleText|2": "band!",
 "text/ViridianGym.asm|_ViridianGymRocker1EndBattleText|0": "You hit every",
 "text/ViridianGym.asm|_ViridianGymRocker1EndBattleText|1": "note right!",
 "text/ViridianGym.asm|_ViridianGymRocker1AfterBattleText|0": "Got any clue who",
 "text/ViridianGym.asm|_ViridianGymRocker1AfterBattleText|1": "our LEADER really",
 "text/ViridianGym.asm|_ViridianGymRocker1AfterBattleText|2": "is?",
 "text/ViridianGym.asm|_ViridianGymHiker2BattleText|0": "Open-hand fighting",
 "text/ViridianGym.asm|_ViridianGymHiker2BattleText|1": "beats every other",
 "text/ViridianGym.asm|_ViridianGymHiker2BattleText|2": "style there is!",
 "text/ViridianGym.asm|_ViridianGymHiker2EndBattleText|0": "Hiyaa!",
 "text/ViridianGym.asm|_ViridianGymHiker2AfterBattleText|0": "If only my KITH",
 "text/ViridianGym.asm|_ViridianGymHiker2AfterBattleText|1": "trained as hard",
 "text/ViridianGym.asm|_ViridianGymHiker2AfterBattleText|2": "as I do...",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM2BattleText|0": "Real talent wins",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM2BattleText|1": "with flair!",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM2EndBattleText|1": "fumbled it!",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM2AfterBattleText|0": "The boss will",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM2AfterBattleText|1": "chew me out!",
 "text/ViridianGym.asm|_ViridianGymHiker3BattleText|0": "Behold the DOJO",
 "text/ViridianGym.asm|_ViridianGymHiker3BattleText|1": "MONARCH! Your fate",
 "text/ViridianGym.asm|_ViridianGymHiker3BattleText|2": "is in my fists!",
 "text/ViridianGym.asm|_ViridianGymHiker3EndBattleText|0": "Hyah!",
 "text/ViridianGym.asm|_ViridianGymHiker3AfterBattleText|0": "The CROWN LEAGUE?",
 "text/ViridianGym.asm|_ViridianGymHiker3AfterBattleText|1": "You? Don't make",
 "text/ViridianGym.asm|_ViridianGymHiker3AfterBattleText|2": "me laugh!",
 "text/ViridianGym.asm|_ViridianGymRocker2BattleText|0": "One snap of my",
 "text/ViridianGym.asm|_ViridianGymRocker2BattleText|1": "lash and your KITH",
 "text/ViridianGym.asm|_ViridianGymRocker2BattleText|2": "will hide!",
 "text/ViridianGym.asm|_ViridianGymRocker2EndBattleText|0": "Ouch!",
 "text/ViridianGym.asm|_ViridianGymRocker2EndBattleText|1": "Snapped back!",
 "text/ViridianGym.asm|_ViridianGymRocker2AfterBattleText|0": "Hold on! I just",
 "text/ViridianGym.asm|_ViridianGymRocker2AfterBattleText|1": "got sloppy!",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3BattleText|0": "This GYM sat dark",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3BattleText|1": "for ages. But",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3BattleText|2": "our LEADER has",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3BattleText|3": "finally returned!",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3EndBattleText|1": "lost? Me?",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3AfterBattleText|0": "Want the CROWN",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3AfterBattleText|1": "LEAGUE? You must",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3AfterBattleText|2": "first topple our",
 "text/ViridianGym.asm|_ViridianGymCooltrainerM3AfterBattleText|3": "LEADER!",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|0": "Hey, future",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|1": "champ!",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|2": "Even I can't say",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|3": "who leads the",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|4": "GREYWICK GYM!",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|5": "Brace yourself.",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|6": "This LEADER is",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|7": "the hardest yet!",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|8": "Word is, the",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|9": "TAMERS here love",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|10": "SOIL-type",
 "text/ViridianGym.asm|_ViridianGymGuidePreBattleText|11": "KITH!",
 "text/ViridianGym.asm|_ViridianGymGuidePostBattleText|0": "Unbelievable!",
 "text/ViridianGym.asm|_ViridianGymGuidePostBattleText|1": "VANCE ran this",
 "text/ViridianGym.asm|_ViridianGymGuidePostBattleText|2": "GYM all along?"
}