{
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|0": "Some crooks treat",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|1": "KITH like tools",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|2": "for dirty jobs.",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|3": "GLOAM, for one.",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|4": "They smuggle rare",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|5": "KITH for coin.",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|6": "And the ones they",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|7": "think are dull",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|8": "or weak?",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|9": "They just dump",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|10": "them by the",
 "text/VermilionMart.asm|_VermilionMartCooltrainerMText|11": "roadside.",
 "text/VermilionMart.asm|_VermilionMartCooltrainerFText|0": "A KITH is a",
 "text/VermilionMart.asm|_VermilionMartCooltrainerFText|1": "mirror. Kind",
 "text/VermilionMart.asm|_VermilionMartCooltrainerFText|2": "TAMER, kind KITH.",
 "text/VermilionMart.asm|_VermilionMartCooltrainerFText|3": "Cruel? Same deal."
}