{
 "text/VermilionCity.asm|_VermilionCityBeautyText|0": "Our harbor crew",
 "text/VermilionCity.asm|_VermilionCityBeautyText|1": "scrubs the docks!",
 "text/VermilionCity.asm|_VermilionCityBeautyText|2": "Dirty water draws",
 "text/VermilionCity.asm|_VermilionCityBeautyText|3": "MUCKLET in",
 "text/VermilionCity.asm|_VermilionCityBeautyText|4": "heaps, they say.",
 "text/VermilionCity.asm|_VermilionCityGambler1DidYouSeeText|0": "That big white",
 "text/VermilionCity.asm|_VermilionCityGambler1DidYouSeeText|1": "boat in the bay?",
 "text/VermilionCity.asm|_VermilionCityGambler1DidYouSeeText|2": "It's the S.S.WREN!",
 "text/VermilionCity.asm|_VermilionCityGambler1SSAnneDepartedText|0": "The S.S.WREN has",
 "text/VermilionCity.asm|_VermilionCityGambler1SSAnneDepartedText|1": "gone to sea!",
 "text/VermilionCity.asm|_VermilionCityGambler1SSAnneDepartedText|2": "Won't see her",
 "text/VermilionCity.asm|_VermilionCityGambler1SSAnneDepartedText|3": "again till spring.",
 "text/VermilionCity.asm|_VermilionCitySailor1WelcomeToSSAnneText|0": "Ahoy! This is the",
 "text/VermilionCity.asm|_VermilionCitySailor1WelcomeToSSAnneText|1": "S.S.WREN gangway!",
 "text/VermilionCity.asm|_VermilionCitySailor1DoYouHaveATicketText|0": "Ahoy there!",
 "text/VermilionCity.asm|_VermilionCitySailor1DoYouHaveATicketText|1": "Boarding S.S.WREN?",
 "text/VermilionCity.asm|_VermilionCitySailor1DoYouHaveATicketText|2": "Show me your",
 "text/VermilionCity.asm|_VermilionCitySailor1DoYouHaveATicketText|3": "BOAT PASS, please.",
 "text/VermilionCity.asm|_VermilionCitySailor1FlashedTicketText|0": "<PLAYER> showed",
 "text/VermilionCity.asm|_VermilionCitySailor1FlashedTicketText|1": "the BOAT PASS!",
 "text/VermilionCity.asm|_VermilionCitySailor1FlashedTicketText|2": "All in order!",
 "text/VermilionCity.asm|_VermilionCitySailor1FlashedTicketText|3": "Up you go, mate!",
 "text/VermilionCity.asm|_VermilionCitySailor1YouNeedATicketText|0": "<PLAYER> has no",
 "text/VermilionCity.asm|_VermilionCitySailor1YouNeedATicketText|1": "BOAT PASS to",
 "text/VermilionCity.asm|_VermilionCitySailor1YouNeedATicketText|2": "show.",
 "text/VermilionCity.asm|_VermilionCitySailor1YouNeedATicketText|3": "Ah, too bad!",
 "text/VermilionCity.asm|_VermilionCitySailor1YouNeedATicketText|4": "Only pass holders",
 "text/VermilionCity.asm|_VermilionCitySailor1YouNeedATicketText|5": "may board, mate.",
 "text/VermilionCity.asm|_VermilionCitySailor1ShipSetSailText|0": "She's out to sea.",
 "text/VermilionCity.asm|_VermilionCityGambler2Text|0": "This empty lot",
 "text/VermilionCity.asm|_VermilionCityGambler2Text|1": "will hold my new",
 "text/VermilionCity.asm|_VermilionCityGambler2Text|2": "inn one day.",
 "text/VermilionCity.asm|_VermilionCityGambler2Text|3": "My KITH is",
 "text/VermilionCity.asm|_VermilionCityGambler2Text|4": "packing the dirt.",
 "text/VermilionCity.asm|_VermilionCityMachopText|0": "GRAPPLET: Hup!",
 "text/VermilionCity.asm|_VermilionCityMachopText|1": "Hup! Hrrah!@",
 "text/VermilionCity.asm|_VermilionCityMachopStompingTheLandFlatText|0": "The GRAPPLET",
 "text/VermilionCity.asm|_VermilionCityMachopStompingTheLandFlatText|1": "flattens the dirt",
 "text/VermilionCity.asm|_VermilionCityMachopStompingTheLandFlatText|2": "with its feet.",
 "text/VermilionCity.asm|_VermilionCitySailor2Text|0": "The S.S.WREN takes",
 "text/VermilionCity.asm|_VermilionCitySailor2Text|1": "rich folks on long",
 "text/VermilionCity.asm|_VermilionCitySailor2Text|2": "sea holidays.",
 "text/VermilionCity.asm|_VermilionCitySailor2Text|3": "She calls here",
 "text/VermilionCity.asm|_VermilionCitySailor2Text|4": "each winter.",
 "text/VermilionCity.asm|_VermilionCitySignText|0": "PORTSALT",
 "text/VermilionCity.asm|_VermilionCitySignText|1": "Salt Air and",
 "text/VermilionCity.asm|_VermilionCitySignText|2": "Sea Shanties",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|0": "ATTENTION!",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|1": "A big KITH is",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|2": "asleep across",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|3": "PATH 12.",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|4": "Go around through",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|5": "DARK BORE and",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|6": "HOLLOWAY instead.",
 "text/VermilionCity.asm|_VermilionCityNoticeSignText|7": "-PORTSALT WATCH",
 "text/VermilionCity.asm|_VermilionCityPokemonFanClubSignText|0": "KITH FAN CLUB",
 "text/VermilionCity.asm|_VermilionCityPokemonFanClubSignText|1": "Come brag about",
 "text/VermilionCity.asm|_VermilionCityPokemonFanClubSignText|2": "your KITH!",
 "text/VermilionCity.asm|_VermilionCityGymSignText|0": "PORTSALT",
