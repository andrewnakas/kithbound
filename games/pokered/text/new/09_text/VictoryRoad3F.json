{
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM1BattleText|0": "Word is, a young",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM1BattleText|1": "wonder is coming!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM1EndBattleText|0": "So",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM1EndBattleText|1": "it's all true!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM1AfterBattleText|0": "You toppled VANCE",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM1AfterBattleText|1": "and his GLOAM?",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF1BattleText|0": "Time to test what",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF1BattleText|1": "you're made of!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF1EndBattleText|1": "fuming!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF1AfterBattleText|0": "Turns out I'm the",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF1AfterBattleText|1": "one being tested!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM2BattleText|0": "Prove you belong",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM2BattleText|1": "beyond this point!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM2EndBattleText|1": "can't accept this!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM2AfterBattleText|0": "Everyone in here",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM2AfterBattleText|1": "is bound for the",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM2AfterBattleText|2": "CROWN LEAGUE.",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerM2AfterBattleText|3": "Stay sharp!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2BattleText|0": "A real TAMER",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2BattleText|1": "always hunts for",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2BattleText|2": "a tougher foe!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2EndBattleText|0": "Ah!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2EndBattleText|1": "Too much!",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2AfterBattleText|0": "Hard fights are",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2AfterBattleText|1": "how you grow.",
 "text/VictoryRoad3F.asm|_VictoryRoad3FCooltrainerF2AfterBattleText|2": "Keep at it!"
}