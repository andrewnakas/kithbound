{
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseYoungsterText|0": "My PIPWING carries",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseYoungsterText|1": "my mail up north",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseYoungsterText|2": "to my pen pal in",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseYoungsterText|3": "SPIREHOLM!",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHousePidgeyText|0": "PIPWING: Chirrup!@",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseLetterText|0": "Dear MAVIS, I miss",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseLetterText|1": "you heaps.",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseLetterText|2": "News says GLOAM",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseLetterText|3": "has moved into",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseLetterText|4": "SPIREHOLM. Scary!",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseLetterText|5": "Here in PORTSALT,",
 "text/VermilionPidgeyHouse.asm|_VermilionPidgeyHouseLetterText|6": "all is calm."
}