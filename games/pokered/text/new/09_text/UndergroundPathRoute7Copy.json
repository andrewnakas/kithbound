{
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGirlText|0": "BLOSSBURY BAZAAR",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGirlText|1": "has the cutest",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGirlText|2": "hats, but...",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGirlText|3": "the crowd near",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGirlText|4": "there gives me",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGirlText|5": "the shivers.",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedTeamRocketHadAHideoutText|0": "A GLOAM lair",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedTeamRocketHadAHideoutText|1": "under BLOSSBURY?",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedTeamRocketHadAHideoutText|2": "No way. Really?",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedMiddleAgedManText|0": "Off to spend your",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedMiddleAgedManText|1": "coin in BLOSSBURY?",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedMiddleAgedManText|2": "Go up the stairs,",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedMiddleAgedManText|3": "then turn west.",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|0": "This UNDERPASS",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|1": "runs below",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|2": "SPIREHOLM all the",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|3": "way to HOLLOWAY.",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|4": "For BRINEFORD,",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|5": "use the gatehouse",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|6": "on the far side",
 "text/UndergroundPathRoute7Copy.asm|_UndergroundPathRoute7CopyUnusedGoesUnderSaffronText|7": "of the street."
}