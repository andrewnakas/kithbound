{
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|0": "Some loot lies",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|1": "buried where eyes",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|2": "can't see it.",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|3": "A DOWSER beeps",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|4": "when you stand",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|5": "near hidden loot.",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|6": "It won't say the",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|7": "exact square, so",
"text/Route11Gate2F.asm|_Route11Gate2FOaksAideItemfinderDescriptionText|8": "you dig around!",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsSnorlaxText|0": "Peered through",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsSnorlaxText|1": "the scope.",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsSnorlaxText|2": "A huge kith lies",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsSnorlaxText|3": "snoring on a path!",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsNoSnorlaxText|0": "Peered through",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsNoSnorlaxText|1": "the scope.",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsNoSnorlaxText|2": "Hills and sky as",
"text/Route11Gate2F.asm|_Route11Gate2FLeftBinocularsNoSnorlaxText|3": "far as you see!",
"text/Route11Gate2F.asm|_Route11Gate2FRightBinocularsText|0": "Peered through",
"text/Route11Gate2F.asm|_Route11Gate2FRightBinocularsText|1": "the scope.",
"text/Route11Gate2F.asm|_Route11Gate2FRightBinocularsText|2": "To go between",
"text/Route11Gate2F.asm|_Route11Gate2FRightBinocularsText|3": "BRINEFORD and",
"text/Route11Gate2F.asm|_Route11Gate2FRightBinocularsText|4": "HOLLOWAY, you",
"text/Route11Gate2F.asm|_Route11Gate2FRightBinocularsText|5": "must pass through",
"text/Route11Gate2F.asm|_Route11Gate2FRightBinocularsText|6": "DARK BORE."
}