{
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|0": "TAMERS come in",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|1": "every shape. Some",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|2": "chip, some crush.",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|3": "You've got a real",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|4": "knack for this,",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|5": "kid. Honest.",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|6": "BRINEFORD has the",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|7": "next GYM. Head",
"text/PewterGym_2.asm|_PewterGymBrockPostBattleAdviceText|8": "there and grow!",
"text/PewterGym_2.asm|_PewterGymBrockWaitTakeThisText|0": "Hold up! One more",
"text/PewterGym_2.asm|_PewterGymBrockWaitTakeThisText|1": "thing for you.",
"text/PewterGym_2.asm|_PewterGymReceivedTM34Text|0": "<PLAYER> got",
"text/PewterGym_2.asm|_PewterGymReceivedTM34Text|1": "SC34!@",
"text/PewterGym_2.asm|_TM34ExplanationText|0": "A SC is a scroll",
"text/PewterGym_2.asm|_TM34ExplanationText|1": "that can teach a",
"text/PewterGym_2.asm|_TM34ExplanationText|2": "kith a new skill",
"text/PewterGym_2.asm|_TM34ExplanationText|3": "in one sitting.",
"text/PewterGym_2.asm|_TM34ExplanationText|4": "Each scroll burns",
"text/PewterGym_2.asm|_TM34ExplanationText|5": "up after a single",
"text/PewterGym_2.asm|_TM34ExplanationText|6": "lesson, so think",
"text/PewterGym_2.asm|_TM34ExplanationText|7": "hard about which",
"text/PewterGym_2.asm|_TM34ExplanationText|8": "kith ought to",
"text/PewterGym_2.asm|_TM34ExplanationText|9": "learn it.",
"text/PewterGym_2.asm|_TM34ExplanationText|10": "SC34 teaches",
"text/PewterGym_2.asm|_TM34ExplanationText|11": "BROOD!",
"text/PewterGym_2.asm|_TM34ExplanationText|12": "Your kith soaks",
"text/PewterGym_2.asm|_TM34ExplanationText|13": "up hits for a bit",
"text/PewterGym_2.asm|_TM34ExplanationText|14": "then hurls twice",
"text/PewterGym_2.asm|_TM34ExplanationText|15": "the harm back!",
"text/PewterGym_2.asm|_PewterGymTM34NoRoomText|0": "Your bag's full.",
"text/PewterGym_2.asm|_PewterGymTM34NoRoomText|1": "Make some space!",
"text/PewterGym_2.asm|_PewterGymBrockReceivedBoulderBadgeText|0": "I misjudged you",
"text/PewterGym_2.asm|_PewterGymBrockReceivedBoulderBadgeText|1": "badly, I admit.",
"text/PewterGym_2.asm|_PewterGymBrockReceivedBoulderBadgeText|2": "You earned this.",
"text/PewterGym_2.asm|_PewterGymBrockReceivedBoulderBadgeText|3": "Take it: the",
"text/PewterGym_2.asm|_PewterGymBrockReceivedBoulderBadgeText|4": "GRIT BADGE!",
"text/PewterGym_2.asm|_PewterGymBrockReceivedBoulderBadgeText|5": "<PLAYER> got",
"text/PewterGym_2.asm|_PewterGymBrockReceivedBoulderBadgeText|6": "the GRIT BADGE!@",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|0": "It's a true mark",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|1": "of the CROWN",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|2": "LEAGUE.",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|3": "Kith that follow",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|4": "you will hit with",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|5": "more force now.",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|6": "And BEACON works",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|7": "outside of battle",
"text/PewterGym_2.asm|_PewterGymBrockBoulderBadgeInfoText|8": "whenever you like!",
"text/PewterGym_2.asm|_PewterGymCooltrainerMBattleText|0": "Whoa, freeze,",
"text/PewterGym_2.asm|_PewterGymCooltrainerMBattleText|1": "rookie!",
"text/PewterGym_2.asm|_PewterGymCooltrainerMBattleText|2": "CRAG is a whole",
"text/PewterGym_2.asm|_PewterGymCooltrainerMBattleText|3": "mountain above",
"text/PewterGym_2.asm|_PewterGymCooltrainerMBattleText|4": "you!",
"text/PewterGym_2.asm|_PewterGymCooltrainerMEndBattleText|0": "Rats!",
"text/PewterGym_2.asm|_PewterGymCooltrainerMEndBattleText|1": "Hm, a mountain",
"text/PewterGym_2.asm|_PewterGymCooltrainerMEndBattleText|2": "is tall, not far.",
"text/PewterGym_2.asm|_PewterGymCooltrainerMEndBattleText|3": "Bad metaphor.",
"text/PewterGym_2.asm|_PewterGymCooltrainerMAfterBattleText|0": "You've got grit,",
"text/PewterGym_2.asm|_PewterGymCooltrainerMAfterBattleText|1": "but CRAG's got a",
"text/PewterGym_2.asm|_PewterGymCooltrainerMAfterBattleText|2": "quarry of it.",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|0": "Hey hey! You've",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|1": "got that spark",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|2": "champs are made",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|3": "of, I can see it!",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|4": "I don't battle",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|5": "myself, but I",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|6": "know the tricks!",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|7": "I'll coach you to",
"text/PewterGym_2.asm|_PewterGymGuidePreAdviceText|8": "glory, pal!",
"text/PewterGym_2.asm|_PewterGymGuideBeginAdviceText|0": "Great! Listen",
"text/PewterGym_2.asm|_PewterGymGuideBeginAdviceText|1": "closely now!",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|0": "Whichever kith",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|1": "sits first in",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|2": "your lineup goes",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|3": "out first, always!",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|4": "Shuffle the order",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|5": "to lead with the",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|6": "right kith and",
"text/PewterGym_2.asm|_PewterGymGuideAdviceText|7": "fights get easy!",
"text/PewterGym_2.asm|_PewterGymGuideFreeServiceText|0": "No charge, ever!",
"text/PewterGym_2.asm|_PewterGymGuideFreeServiceText|1": "Coaching for",
"text/PewterGym_2.asm|_PewterGymGuideFreeServiceText|2": "the love of it!",
"text/PewterGym_2.asm|_PewterGymGuidePostBattleText|0": "Knew it from the",
"text/PewterGym_2.asm|_PewterGymGuidePostBattleText|1": "start! You're",
"text/PewterGym_2.asm|_PewterGymGuidePostBattleText|2": "a champ-in-making!"
}