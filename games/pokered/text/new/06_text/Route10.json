{
"text/Route10.asm|_Route10SuperNerd1BattleText|0": "Oh! A fellow",
"text/Route10.asm|_Route10SuperNerd1BattleText|1": "KITH BUFF? Let",
"text/Route10.asm|_Route10SuperNerd1BattleText|2": "me show off my",
"text/Route10.asm|_Route10SuperNerd1BattleText|3": "prized lineup!",
"text/Route10.asm|_Route10SuperNerd1EndBattleText|0": "Hmph.",
"text/Route10.asm|_Route10SuperNerd1EndBattleText|1": "I'm totally calm!",
"text/Route10.asm|_Route10SuperNerd1AfterBattleText|0": "My rarest finds",
"text/Route10.asm|_Route10SuperNerd1AfterBattleText|1": "stay safe at home!",
"text/Route10.asm|_Route10Hiker1BattleText|0": "Bwahaha-hoo-ha!",
"text/Route10.asm|_Route10Hiker1EndBattleText|0": "Hoo-hah!",
"text/Route10.asm|_Route10Hiker1EndBattleText|1": "That's no laugh!",
"text/Route10.asm|_Route10Hiker1EndBattleText|2": "Pollen! Pollen!",
"text/Route10.asm|_Route10Hiker1EndBattleText|3": "Hah-hah-HATCHOO!",
"text/Route10.asm|_Route10Hiker1AfterBattleText|0": "Hah-HATCHOO!",
"text/Route10.asm|_Route10Hiker1AfterBattleText|1": "Hatchoo!",
"text/Route10.asm|_Route10Hiker1AfterBattleText|2": "Sniff! Snuffle!",
"text/Route10.asm|_Route10SuperNerd2BattleText|0": "Psst, kid! Peek",
"text/Route10.asm|_Route10SuperNerd2BattleText|1": "at my kith!",
"text/Route10.asm|_Route10SuperNerd2EndBattleText|0": "Waah!",
"text/Route10.asm|_Route10SuperNerd2EndBattleText|1": "My darlings!",
"text/Route10.asm|_Route10SuperNerd2AfterBattleText|0": "Go away. You were",
"text/Route10.asm|_Route10SuperNerd2AfterBattleText|1": "mean to my team.",
"text/Route10.asm|_Route10CooltrainerF1BattleText|0": "I've tried GYMS",
"text/Route10.asm|_Route10CooltrainerF1BattleText|1": "a handful of",
"text/Route10.asm|_Route10CooltrainerF1BattleText|2": "times. Never won",
"text/Route10.asm|_Route10CooltrainerF1BattleText|3": "a single badge.",
"text/Route10.asm|_Route10CooltrainerF1EndBattleText|0": "Argh!",
"text/Route10.asm|_Route10CooltrainerF1EndBattleText|1": "Same old story!",
"text/Route10.asm|_Route10CooltrainerF1AfterBattleText|0": "Watch out, KITH",
"text/Route10.asm|_Route10CooltrainerF1AfterBattleText|1": "BUFFS keep lurk-",
"text/Route10.asm|_Route10CooltrainerF1AfterBattleText|2": "ing on this path.",
"text/Route10.asm|_Route10Hiker2BattleText|0": "Mmm! Breathe in",
"text/Route10.asm|_Route10Hiker2BattleText|1": "that peak breeze!",
"text/Route10.asm|_Route10Hiker2EndBattleText|0": "Ah,",
"text/Route10.asm|_Route10Hiker2EndBattleText|1": "how refreshing!",
"text/Route10.asm|_Route10Hiker2AfterBattleText|0": "I've gulped so",
"text/Route10.asm|_Route10Hiker2AfterBattleText|1": "much air I'm full!",
"text/Route10.asm|_Route10CooltrainerF2BattleText|0": "This climb has me",
"text/Route10.asm|_Route10CooltrainerF2BattleText|1": "woozy, honestly.",
"text/Route10.asm|_Route10CooltrainerF2BattleText|2": "Go easy, okay?",
"text/Route10.asm|_Route10CooltrainerF2EndBattleText|1": "too dizzy!",
"text/Route10.asm|_Route10CooltrainerF2AfterBattleText|0": "Wild kith around",
"text/Route10.asm|_Route10CooltrainerF2AfterBattleText|1": "here are plump!",
"text/Route10.asm|_Route10CooltrainerF2AfterBattleText|2": "I keep hoping to",
"text/Route10.asm|_Route10CooltrainerF2AfterBattleText|3": "find one with",
"text/Route10.asm|_Route10CooltrainerF2AfterBattleText|4": "polka dots!",
"text/Route10.asm|_Route10RockTunnelSignText|0": "DARK BORE ahead",
"text/Route10.asm|_Route10PowerPlantSignText|0": "OLD DYNAMO plant"
}