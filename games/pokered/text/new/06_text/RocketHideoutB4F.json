{
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniImpressedYouGotHereText|0": "Well, well. Few",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniImpressedYouGotHereText|1": "make it this far",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniImpressedYouGotHereText|2": "alive. Bravo.",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniWhatCannotBeText|0": "NO!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniWhatCannotBeText|1": "Impossible!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|0": "Clearly your kith",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|1": "trust you. That",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|2": "bond is rare.",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|3": "My vision is far",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|4": "too vast for a",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|5": "child to grasp.",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|6": "Leave it at that.",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|7": "I'll withdraw,",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|8": "for today.",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|9": "Our paths will",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FGiovanniHopeWeMeetAgainText|10": "cross again...",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1BattleText|0": "You! The brat who",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1BattleText|1": "wrecked our MT.",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1BattleText|2": "HUSH dig!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1EndBattleText|0": "Foiled",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1EndBattleText|1": "again!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1AfterBattleText|0": "What did GLOAM",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1AfterBattleText|1": "ever do to you,",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket1AfterBattleText|2": "huh?",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket2BattleText|0": "Villainy is an",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket2BattleText|1": "art! Can't you",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket2BattleText|2": "appreciate it?",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket2EndBattleText|0": "Eeyow!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket2AfterBattleText|0": "Forgive me, BOSS!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket2AfterBattleText|1": "I let you down!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket3BattleText|0": "Lift's dead?",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket3BattleText|1": "Then who's got",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket3BattleText|2": "the HOIST KEY?",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket3EndBattleText|0": "Gah!",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket3AfterBattleText|0": "Whoops! The HOIST",
"text/RocketHideoutB4F.asm|_RocketHideoutB4FRocket3AfterBattleText|1": "KEY fell out!"
}