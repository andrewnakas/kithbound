{
"text/Route11.asm|_Route11Gambler1BattleText|0": "Roll the dice!",
"text/Route11.asm|_Route11Gambler1EndBattleText|0": "Snake",
"text/Route11.asm|_Route11Gambler1EndBattleText|1": "eyes for me!",
"text/Route11.asm|_Route11Gambler1AfterBattleText|0": "Battles are bets,",
"text/Route11.asm|_Route11Gambler1AfterBattleText|1": "and every day is",
"text/Route11.asm|_Route11Gambler1AfterBattleText|2": "a wager, kid!",
"text/Route11.asm|_Route11Gambler2BattleText|0": "A showdown? Oh,",
"text/Route11.asm|_Route11Gambler2BattleText|1": "I live for these!",
"text/Route11.asm|_Route11Gambler2EndBattleText|0": "So",
"text/Route11.asm|_Route11Gambler2EndBattleText|1": "close!",
"text/Route11.asm|_Route11Gambler2AfterBattleText|0": "Timid TAMERS",
"text/Route11.asm|_Route11Gambler2AfterBattleText|1": "never win big.",
"text/Route11.asm|_Route11Gambler2AfterBattleText|2": "Be bold, kid!",
"text/Route11.asm|_Route11Youngster1BattleText|0": "Fair fight! No",
"text/Route11.asm|_Route11Youngster1BattleText|1": "funny business!",
"text/Route11.asm|_Route11Youngster1EndBattleText|0": "Wait!",
"text/Route11.asm|_Route11Youngster1EndBattleText|1": "That can't be!",
"text/Route11.asm|_Route11Youngster1AfterBattleText|0": "I gave it all.",
"text/Route11.asm|_Route11Youngster1AfterBattleText|1": "I'm proud anyway!",
"text/Route11.asm|_Route11SuperNerd1BattleText|0": "Mind your feet!",
"text/Route11.asm|_Route11SuperNerd1BattleText|1": "I'm running wire",
"text/Route11.asm|_Route11SuperNerd1BattleText|2": "along here!",
"text/Route11.asm|_Route11SuperNerd1EndBattleText|0": "What a",
"text/Route11.asm|_Route11SuperNerd1EndBattleText|1": "jolt!",
"text/Route11.asm|_Route11SuperNerd1AfterBattleText|0": "Flip off lights",
"text/Route11.asm|_Route11SuperNerd1AfterBattleText|1": "you aren't using!",
"text/Route11.asm|_Route11Youngster2BattleText|0": "I'm brand new at",
"text/Route11.asm|_Route11Youngster2BattleText|1": "this, but I've",
"text/Route11.asm|_Route11Youngster2BattleText|2": "got a good feel!",
"text/Route11.asm|_Route11Youngster2EndBattleText|0": "My",
"text/Route11.asm|_Route11Youngster2EndBattleText|1": "team fizzled!",
"text/Route11.asm|_Route11Youngster2AfterBattleText5|0": "Don't look at me!",
"text/Route11.asm|_Route11Youngster2AfterBattleText5|1": "Go away!",
"text/Route11.asm|_Route11Gambler3BattleText|0": "Hah! My streak",
"text/Route11.asm|_Route11Gambler3BattleText|1": "is unbroken!",
"text/Route11.asm|_Route11Gambler3EndBattleText|0": "Broken",
"text/Route11.asm|_Route11Gambler3EndBattleText|1": "at last!",
"text/Route11.asm|_Route11Gambler3AfterBattleText|0": "Pure fluke!",
"text/Route11.asm|_Route11Gambler3AfterBattleText|1": "Nothing more!",
"text/Route11.asm|_Route11Gambler4BattleText|0": "Not one win in",
"text/Route11.asm|_Route11Gambler4BattleText|1": "my whole life...",
"text/Route11.asm|_Route11Gambler4EndBattleText|0": "Sigh,",
"text/Route11.asm|_Route11Gambler4EndBattleText|1": "as expected...",
"text/Route11.asm|_Route11Gambler4AfterBattleText|0": "Fortune hates me.",
"text/Route11.asm|_Route11Gambler4AfterBattleText|1": "Always has.",
"text/Route11.asm|_Route11Youngster3BattleText|0": "Top of the class,",
"text/Route11.asm|_Route11Youngster3BattleText|1": "that's me!",
"text/Route11.asm|_Route11Youngster3EndBattleText|0": "Rats!",
"text/Route11.asm|_Route11Youngster3EndBattleText|1": "More training for",
"text/Route11.asm|_Route11Youngster3EndBattleText|2": "my team, I guess!",
"text/Route11.asm|_Route11Youngster3AfterBattleText|0": "A huge, dozy kith",
"text/Route11.asm|_Route11Youngster3AfterBattleText|1": "wanders down out",
"text/Route11.asm|_Route11Youngster3AfterBattleText|2": "of the hills",
"text/Route11.asm|_Route11Youngster3AfterBattleText|3": "sometimes.",
"text/Route11.asm|_Route11Youngster3AfterBattleText|4": "Nab it and it'll",
"text/Route11.asm|_Route11Youngster3AfterBattleText|5": "crush for you!",
"text/Route11.asm|_Route11SuperNerd2BattleText|0": "Careful, these",
"text/Route11.asm|_Route11SuperNerd2BattleText|1": "cables are hot!"
}