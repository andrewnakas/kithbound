{
"text/PokemonFanClub.asm|_PokemonFanClubPikachuFanNormalText|0": "Look how my",
"text/PokemonFanClub.asm|_PokemonFanClubPikachuFanNormalText|1": "ZAPPET's cheeks",
"text/PokemonFanClub.asm|_PokemonFanClubPikachuFanNormalText|2": "crackle! So cute!",
"text/PokemonFanClub.asm|_PokemonFanClubPikachuFanBetterText|0": "Pfft! Mine sparks",
"text/PokemonFanClub.asm|_PokemonFanClubPikachuFanBetterText|1": "way brighter than",
"text/PokemonFanClub.asm|_PokemonFanClubPikachuFanBetterText|2": "yours does!",
"text/PokemonFanClub.asm|_PokemonFanClubSeelFanNormalText|0": "My FLOEPUP is the",
"text/PokemonFanClub.asm|_PokemonFanClubSeelFanNormalText|1": "sweetest thing!",
"text/PokemonFanClub.asm|_PokemonFanClubSeelFanNormalText|2": "It honks when I",
"text/PokemonFanClub.asm|_PokemonFanClubSeelFanNormalText|3": "squeeze it!",
"text/PokemonFanClub.asm|_PokemonFanClubSeelFanBetterText|0": "Goodness me!",
"text/PokemonFanClub.asm|_PokemonFanClubSeelFanBetterText|1": "My FLOEPUP has a",
"text/PokemonFanClub.asm|_PokemonFanClubSeelFanBetterText|2": "shinier horn!",
"text/PokemonFanClub.asm|_PokemonFanClubPikachuText|0": "ZAPPET: Pik",
"text/PokemonFanClub.asm|_PokemonFanClubPikachuText|1": "pik!",
"text/PokemonFanClub.asm|_PokemonFanClubSeelText|0": "FLOEPUP: Arf arf!",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|0": "Welcome! I'm head",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|1": "of this fan club.",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|2": "My kith number",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|3": "past a hundred!",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|4": "And I have very",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|5": "firm opinions on",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|6": "each of them!",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|7": "Well then...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|8": "Shall I tell you",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|9": "all about my",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanIntroText|10": "darling kith?",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|0": "Splendid!",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|1": "Get comfortable!",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|2": "My pride and joy",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|3": "is BLAZESTEED...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|4": "Its mane...glows",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|5": "...it trots...so",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|6": "proud...the hoof",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|7": "clops...you see?",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|8": "...and it nuzzles",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|9": "...gleaming...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|10": "gentle...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|11": "adore it!",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|12": "At night it...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|13": "curls by the fire",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|14": "...toasty...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|15": "magnificent...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|16": "dazzling...",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|17": "...My word! Is it",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|18": "dark already? I",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|19": "rambled for ages!",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|20": "Bless you for",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|21": "listening! Please",
"text/PokemonFanClub.asm|_PokemonFanClubChairmanStoryText|22": "take this gift!",
"text/PokemonFanClub.asm|_PokemonFanClubReceivedBikeVoucherText|0": "<PLAYER> got",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|0": "Trade it in for",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|1": "a ROADSTER!",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|2": "I never ride. My",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|3": "RAPTORAX carries",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|4": "me everywhere!",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|5": "So a ROADSTER is",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|6": "no use to me!",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|7": "Enjoy the",
"text/PokemonFanClub.asm|_PokemonFanClubExplainBikeVoucherText|8": "breeze!",
"text/PokemonFanClub.asm|_PokemonFanClubNoStoryText|0": "Aw. Well, my door",
"text/PokemonFanClub.asm|_PokemonFanClubNoStoryText|1": "is open whenever",
"text/PokemonFanClub.asm|_PokemonFanClubNoStoryText|2": "you're curious!",
"text/PokemonFanClub.asm|_PokemonFanClubChairFinalText|0": "Ah, <PLAYER>!",
"text/PokemonFanClub.asm|_PokemonFanClubChairFinalText|1": "Back to hear",
"text/PokemonFanClub.asm|_PokemonFanClubChairFinalText|2": "more about my",
"text/PokemonFanClub.asm|_PokemonFanClubChairFinalText|3": "dear BLAZESTEED?",
"text/PokemonFanClub.asm|_PokemonFanClubChairFinalText|4": "No? Pity!",
"text/PokemonFanClub.asm|_PokemonFanClubBagFullText|0": "Your bag needs a",
"text/PokemonFanClub.asm|_PokemonFanClubBagFullText|1": "free slot first!",
"text/PokemonFanClub.asm|_PokemonFanClubReceptionistText|0": "The CLUB HEAD",
"text/PokemonFanClub.asm|_PokemonFanClubReceptionistText|1": "can talk kith for",
"text/PokemonFanClub.asm|_PokemonFanClubReceptionistText|2": "hours on end.",
