{
"text/PewterNidoranHouse.asm|_PewterNidoranHouseNidoranText|0": "BRISTLO: Hrrff!@",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseLittleBoyText|0": "BRISTLO, stay!",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|0": "This kith came to",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|1": "us by trade, so",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|2": "it's headstrong.",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|3": "Traded kith carry",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|4": "another TAMER'S",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|5": "name with them.",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|6": "They learn quick,",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|7": "yet they'll shrug",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|8": "off orders from a",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|9": "green TAMER.",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|10": "A BADGE or two",
"text/PewterNidoranHouse.asm|_PewterNidoranHouseMiddleAgedManText|11": "would fix that..."
}