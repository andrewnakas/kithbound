{
"text/RockTunnel1F.asm|_RockTunnel1FHiker1BattleText|0": "Miles of dark",
"text/RockTunnel1F.asm|_RockTunnel1FHiker1BattleText|1": "ahead, rookie!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker1EndBattleText|0": "Bah!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker1EndBattleText|1": "Fair's fair!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker1AfterBattleText|0": "Mind SLATEWORM!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker1AfterBattleText|1": "It coils up tight",
"text/RockTunnel1F.asm|_RockTunnel1FHiker1AfterBattleText|2": "round its prey!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2BattleText|0": "Er... was it",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2BattleText|1": "left or right?",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2EndBattleText|0": "Hold on!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2EndBattleText|1": "Why'd I fight?",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2EndBattleText|2": "I need the exit!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2AfterBattleText|0": "A big snoozing",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2AfterBattleText|1": "kith blocks PATH",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2AfterBattleText|2": "12, so I took",
"text/RockTunnel1F.asm|_RockTunnel1FHiker2AfterBattleText|3": "this long way.",
"text/RockTunnel1F.asm|_RockTunnel1FHiker3BattleText|0": "Hey, flatlander!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker3BattleText|1": "Mind your manners",
"text/RockTunnel1F.asm|_RockTunnel1FHiker3BattleText|2": "in my mountain!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker3EndBattleText|0": "Enough!",
"text/RockTunnel1F.asm|_RockTunnel1FHiker3AfterBattleText|0": "Okay, you've got",
"text/RockTunnel1F.asm|_RockTunnel1FHiker3AfterBattleText|1": "trekker legs!",
"text/RockTunnel1F.asm|_RockTunnel1FSuperNerdBattleText|0": "Battle mode on!",
"text/RockTunnel1F.asm|_RockTunnel1FSuperNerdBattleText|1": "Engage!",
"text/RockTunnel1F.asm|_RockTunnel1FSuperNerdEndBattleText|0": "System",
"text/RockTunnel1F.asm|_RockTunnel1FSuperNerdEndBattleText|1": "crash!",
"text/RockTunnel1F.asm|_RockTunnel1FSuperNerdAfterBattleText|0": "Fine. I'll go net",
"text/RockTunnel1F.asm|_RockTunnel1FSuperNerdAfterBattleText|1": "a DUSKBIT instead.",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF1BattleText|0": "Stay back! I",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF1BattleText|1": "can't see a thing",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF1BattleText|2": "down here!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF1EndBattleText|0": "Unfair,",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF1EndBattleText|1": "I couldn't see!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF1AfterBattleText|0": "A GRAPPLET lurks",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF1AfterBattleText|1": "around here!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF2BattleText|0": "I hiked all this",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF2BattleText|1": "way to train!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF2EndBattleText|1": "all tapped out!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF2AfterBattleText|0": "You seemed so",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF2AfterBattleText|1": "sweet and mild!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF3BattleText|0": "A TAMER! Great,",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF3BattleText|1": "let's spar!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF3EndBattleText|0": "Rough",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF3EndBattleText|1": "stuff!",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF3AfterBattleText|0": "Phew, I need",
"text/RockTunnel1F.asm|_RockTunnel1FCooltrainerF3AfterBattleText|1": "a towel!",
"text/RockTunnel1F.asm|_RockTunnel1FSignText|0": "DARK BORE",
"text/RockTunnel1F.asm|_RockTunnel1FSignText|1": "BRINEFORD to",
"text/RockTunnel1F.asm|_RockTunnel1FSignText|2": "HOLLOWAY"
}