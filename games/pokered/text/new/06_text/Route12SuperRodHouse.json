{
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruDoYouLikeToFishText|0": "My big brother is",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruDoYouLikeToFishText|1": "an angling legend!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruDoYouLikeToFishText|2": "And me? I'm crazy",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruDoYouLikeToFishText|3": "for it too!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruDoYouLikeToFishText|4": "You cast lines",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruDoYouLikeToFishText|5": "too, I hope?",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruReceivedSuperRodText|0": "Ha! A kindred",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruReceivedSuperRodText|1": "spirit!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruReceivedSuperRodText|2": "This is for you.",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruReceivedSuperRodText|3": "Go reel, kiddo!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruReceivedSuperRodText|4": "<PLAYER> got",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruFishingWayOfLifeText|0": "Rods and reels",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruFishingWayOfLifeText|1": "are my whole life!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruFishingWayOfLifeText|2": "Lakes, streams,",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruFishingWayOfLifeText|3": "oceans... go hook",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruFishingWayOfLifeText|4": "the monster of",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruFishingWayOfLifeText|5": "your dreams!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruThatsDisappointingText|0": "Aw... What a",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruThatsDisappointingText|1": "letdown...",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|0": "Ahoy, angler",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|2": "Cast the STEEL",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|3": "ROD in any pond!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|4": "Each kind of",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|5": "water hides its",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|6": "own odd kith.",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|7": "Cast a line every",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruTryFishingText|8": "chance you get!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruNoRoomText|0": "Uh-oh!",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruNoRoomText|1": "I've got a gift,",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruNoRoomText|2": "but your pack is",
"text/Route12SuperRodHouse.asm|_Route12SuperRodHouseFishingGuruNoRoomText|3": "packed too tight!"
}