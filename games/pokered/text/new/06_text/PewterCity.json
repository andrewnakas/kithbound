{
"text/PewterCity.asm|_PewterCityCooltrainerFText|0": "Folks up here say",
"text/PewterCity.asm|_PewterCityCooltrainerFText|1": "MOONDROPs drifted",
"text/PewterCity.asm|_PewterCityCooltrainerFText|2": "down from the sky.",
"text/PewterCity.asm|_PewterCityCooltrainerFText|3": "They showed up",
"text/PewterCity.asm|_PewterCityCooltrainerFText|4": "once a NIGHT SHARD",
"text/PewterCity.asm|_PewterCityCooltrainerFText|5": "hit MT.HUSH.",
"text/PewterCity.asm|_PewterCityCooltrainerMText|0": "Hardly anybody",
"text/PewterCity.asm|_PewterCityCooltrainerMText|1": "in FLINTON trains",
"text/PewterCity.asm|_PewterCityCooltrainerMText|2": "for real, sadly.",
"text/PewterCity.asm|_PewterCityCooltrainerMText|3": "Most just chase",
"text/PewterCity.asm|_PewterCityCooltrainerMText|4": "bugs in the weeds.",
"text/PewterCity.asm|_PewterCityCooltrainerMText|5": "CRAG at the GYM,",
"text/PewterCity.asm|_PewterCityCooltrainerMText|6": "though? He lives",
"text/PewterCity.asm|_PewterCityCooltrainerMText|7": "and breathes it!",
"text/PewterCity.asm|_PewterCitySuperNerd1DidYouCheckOutMuseumText|0": "Been inside our",
"text/PewterCity.asm|_PewterCitySuperNerd1DidYouCheckOutMuseumText|1": "MUSEUM yet?",
"text/PewterCity.asm|_PewterCitySuperNerd1WerentThoseFossilsAmazingText|0": "Those old bones",
"text/PewterCity.asm|_PewterCitySuperNerd1WerentThoseFossilsAmazingText|1": "dug out of MT.HUSH",
"text/PewterCity.asm|_PewterCitySuperNerd1WerentThoseFossilsAmazingText|2": "were wild, huh?",
"text/PewterCity.asm|_PewterCitySuperNerd1YouHaveToGoText|0": "No? Oh, that",
"text/PewterCity.asm|_PewterCitySuperNerd1YouHaveToGoText|1": "won't do. Go see",
"text/PewterCity.asm|_PewterCitySuperNerd1YouHaveToGoText|2": "it, seriously!",
"text/PewterCity.asm|_PewterCitySuperNerd1ItsRightHereText|0": "Here it is!",
"text/PewterCity.asm|_PewterCitySuperNerd1ItsRightHereText|1": "There's a fee at",
"text/PewterCity.asm|_PewterCitySuperNerd1ItsRightHereText|2": "the door, yet the",
"text/PewterCity.asm|_PewterCitySuperNerd1ItsRightHereText|3": "bones are worth it",
"text/PewterCity.asm|_PewterCitySuperNerd1ItsRightHereText|4": "Catch you later!",
"text/PewterCity.asm|_PewterCitySuperNerd2DoYouKnowWhatImDoingText|0": "Hey, you there!",
"text/PewterCity.asm|_PewterCitySuperNerd2DoYouKnowWhatImDoingText|1": "Guess what job",
"text/PewterCity.asm|_PewterCitySuperNerd2DoYouKnowWhatImDoingText|2": "keeps me busy?",
"text/PewterCity.asm|_PewterCitySuperNerd2ThatsRightText|0": "Yep, you got it!",
"text/PewterCity.asm|_PewterCitySuperNerd2ThatsRightText|1": "My arms ache!",
"text/PewterCity.asm|_PewterCitySuperNerd2ImSprayingRepelText|0": "WARD SPRAY! It",
"text/PewterCity.asm|_PewterCitySuperNerd2ImSprayingRepelText|1": "keeps wild kith",
"text/PewterCity.asm|_PewterCitySuperNerd2ImSprayingRepelText|2": "off my turnips.",
"text/PewterCity.asm|_PewterCityYoungsterYoureATrainerFollowMeText|0": "Ooh, a TAMER! CRAG",
"text/PewterCity.asm|_PewterCityYoungsterYoureATrainerFollowMeText|1": "at the GYM wants",
"text/PewterCity.asm|_PewterCityYoungsterYoureATrainerFollowMeText|2": "fresh opponents.",
"text/PewterCity.asm|_PewterCityYoungsterYoureATrainerFollowMeText|3": "I'll show you the",
"text/PewterCity.asm|_PewterCityYoungsterYoureATrainerFollowMeText|4": "way. This way!",
"text/PewterCity.asm|_PewterCityYoungsterGoTakeOnBrockText|0": "Think you're",
"text/PewterCity.asm|_PewterCityYoungsterGoTakeOnBrockText|1": "tough enough? Then",
"text/PewterCity.asm|_PewterCityYoungsterGoTakeOnBrockText|2": "go face CRAG!",
"text/PewterCity.asm|_PewterCityTrainerTipsText|0": "TAMER TIPS",
"text/PewterCity.asm|_PewterCityTrainerTipsText|1": "Even a kith that",
"text/PewterCity.asm|_PewterCityTrainerTipsText|2": "only stepped in",
"text/PewterCity.asm|_PewterCityTrainerTipsText|3": "for a moment gets",
"text/PewterCity.asm|_PewterCityTrainerTipsText|4": "a share of EXP!",
"text/PewterCity.asm|_PewterCityPoliceNoticeSignText|0": "WARNING!",
"text/PewterCity.asm|_PewterCityPoliceNoticeSignText|1": "Fossil thieves",
"text/PewterCity.asm|_PewterCityPoliceNoticeSignText|2": "are raiding the",
"text/PewterCity.asm|_PewterCityPoliceNoticeSignText|3": "caves of MT.HUSH!",
"text/PewterCity.asm|_PewterCityPoliceNoticeSignText|4": "Tips go to the",
"text/PewterCity.asm|_PewterCityPoliceNoticeSignText|5": "FLINTON WATCH",
"text/PewterCity.asm|_PewterCityPoliceNoticeSignText|6": "office, thanks!",
"text/PewterCity.asm|_PewterCityMuseumSignText|0": "FLINTON HALL",
"text/PewterCity.asm|_PewterCityMuseumSignText|1": "OF OLD BONES",
"text/PewterCity.asm|_PewterCityGymSignText|0": "FLINTON",
"text/PewterCity.asm|_PewterCityGymSignText|1": "KITH GYM",
"text/PewterCity.asm|_PewterCityGymSignText|2": "LEADER: CRAG",
"text/PewterCity.asm|_PewterCityGymSignText|3": "Unbudging as a",
"text/PewterCity.asm|_PewterCityGymSignText|4": "mountainside!",
"text/PewterCity.asm|_PewterCitySignText|0": "FLINTON",
"text/PewterCity.asm|_PewterCitySignText|1": "Built on bedrock,",
"text/PewterCity.asm|_PewterCitySignText|2": "proud of it"
}