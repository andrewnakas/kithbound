{
"text/Route12.asm|_Route12SnorlaxText|0": "A giant kith is",
"text/Route12.asm|_Route12SnorlaxText|1": "napping in the way",
"text/Route12.asm|_Route12SnorlaxWokeUpText|0": "SLUMBERUS stirred!",
"text/Route12.asm|_Route12SnorlaxWokeUpText|1": "Cranky from its",
"text/Route12.asm|_Route12SnorlaxWokeUpText|2": "nap, it charges!",
"text/Route12.asm|_Route12SnorlaxCalmedDownText|0": "SLUMBERUS settled.",
"text/Route12.asm|_Route12SnorlaxCalmedDownText|1": "It stretched,",
"text/Route12.asm|_Route12SnorlaxCalmedDownText|2": "yawned wide, and",
"text/Route12.asm|_Route12SnorlaxCalmedDownText|3": "lumbered uphill!",
"text/Route12.asm|_Route12Fisher1BattleText|0": "Whoa! Something's",
"text/Route12.asm|_Route12Fisher1BattleText|1": "tugging my line!",
"text/Route12.asm|_Route12Fisher1EndBattleText|0": "Pah!",
"text/Route12.asm|_Route12Fisher1EndBattleText|1": "A minnow at best!",
"text/Route12.asm|_Route12Fisher1AfterBattleText|0": "Ugh, my hook's",
"text/Route12.asm|_Route12Fisher1AfterBattleText|1": "caught on a rock!",
"text/Route12.asm|_Route12Fisher2BattleText|0": "Shh! Sit still.",
"text/Route12.asm|_Route12Fisher2BattleText|1": "The fish come to",
"text/Route12.asm|_Route12Fisher2BattleText|2": "the calm ones.",
"text/Route12.asm|_Route12Fisher2EndBattleText|0": "Slipped",
"text/Route12.asm|_Route12Fisher2EndBattleText|1": "off the hook!",
"text/Route12.asm|_Route12Fisher2AfterBattleText|0": "A finer rod would",
"text/Route12.asm|_Route12Fisher2AfterBattleText|1": "haul up finer",
"text/Route12.asm|_Route12Fisher2AfterBattleText|2": "kith, I bet!",
"text/Route12.asm|_Route12CooltrainerMBattleText|0": "Seen any NIGHT",
"text/Route12.asm|_Route12CooltrainerMBattleText|1": "SHARDS lately?",
"text/Route12.asm|_Route12CooltrainerMEndBattleText|0": "Ack!",
"text/Route12.asm|_Route12CooltrainerMAfterBattleText|0": "A NIGHT SHARD",
"text/Route12.asm|_Route12CooltrainerMAfterBattleText|1": "would've grown my",
"text/Route12.asm|_Route12CooltrainerMAfterBattleText|2": "team up for sure!",
"text/Route12.asm|_Route12SuperNerdBattleText|0": "Volts and amps",
"text/Route12.asm|_Route12SuperNerdBattleText|1": "are my thing!",
"text/Route12.asm|_Route12SuperNerdEndBattleText|0": "Short-circuited!",
"text/Route12.asm|_Route12SuperNerdAfterBattleText|0": "Wet kith hate a",
"text/Route12.asm|_Route12SuperNerdAfterBattleText|1": "good jolt. Hit",
"text/Route12.asm|_Route12SuperNerdAfterBattleText|2": "TIDE kith with",
"text/Route12.asm|_Route12SuperNerdAfterBattleText|3": "VOLT skills!",
"text/Route12.asm|_Route12Fisher3BattleText|0": "ANGLER ACE",
"text/Route12.asm|_Route12Fisher3BattleText|1": "takes on rookie!",
"text/Route12.asm|_Route12Fisher3EndBattleText|0": "Out-",
"text/Route12.asm|_Route12Fisher3EndBattleText|1": "fished!",
"text/Route12.asm|_Route12Fisher3AfterBattleText|0": "You win battles,",
"text/Route12.asm|_Route12Fisher3AfterBattleText|1": "fine, but I still",
"text/Route12.asm|_Route12Fisher3AfterBattleText|2": "reel in more fish!",
"text/Route12.asm|_Route12Fisher4BattleText|0": "Should've stayed",
"text/Route12.asm|_Route12Fisher4BattleText|1": "at the office!",
"text/Route12.asm|_Route12Fisher4EndBattleText|0": "Tough",
"text/Route12.asm|_Route12Fisher4EndBattleText|1": "day...",
"text/Route12.asm|_Route12Fisher4AfterBattleText|0": "Eh, no worries.",
"text/Route12.asm|_Route12Fisher4AfterBattleText|1": "I've made peace",
"text/Route12.asm|_Route12Fisher4AfterBattleText|2": "with losing.",
"text/Route12.asm|_Route12Fisher5BattleText|0": "Who knows what",
"text/Route12.asm|_Route12Fisher5BattleText|1": "lurks under the",
"text/Route12.asm|_Route12Fisher5BattleText|2": "ripples?",
"text/Route12.asm|_Route12Fisher5EndBattleText|0": "Gone,",
"text/Route12.asm|_Route12Fisher5EndBattleText|1": "poof!",
"text/Route12.asm|_Route12Fisher5AfterBattleText|0": "SPLASHLING bite",
"text/Route12.asm|_Route12Fisher5AfterBattleText|1": "every cast. They",
"text/Route12.asm|_Route12Fisher5AfterBattleText|2": "just flop around!",
"text/Route12.asm|_Route12SignText|0": "PATH 12",
"text/Route12.asm|_Route12SignText|1": "Up to HOLLOWAY",
"text/Route12.asm|_Route12SportFishingSignText|0": "ANGLERS' PIER"
}