{
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF1BattleText|0": "Trekkers drop",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF1BattleText|1": "sticks as signs.",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF1EndBattleText|0": "Aww!",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF1EndBattleText|1": "That's all I had!",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF1AfterBattleText|0": "I miss my bed!",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF1AfterBattleText|1": "Get me out!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker1BattleText|0": "Ho ho! Feel these",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker1BattleText|1": "mighty arms!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker1EndBattleText|0": "Whoa!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker1EndBattleText|1": "Out-flexed!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker1AfterBattleText|0": "Brains are hard.",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker1AfterBattleText|1": "Biceps are easy.",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker1AfterBattleText|2": "That's my motto!",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1BattleText|0": "Is that a real",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1BattleText|1": "KITHLOG?",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1BattleText|2": "Lucky! Gimme!",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1EndBattleText|0": "Ugh!",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1EndBattleText|1": "Green with envy!",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1AfterBattleText|0": "Once yours is all",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1AfterBattleText|1": "filled, pass it",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd1AfterBattleText|2": "on to me, yeah?",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd2BattleText|0": "Ever been to a",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd2BattleText|1": "dress-up meet?",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd2EndBattleText|0": "Oh,",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd2EndBattleText|1": "fine then.",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd2AfterBattleText|0": "We sew kith suits",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd2AfterBattleText|1": "and parade in",
"text/RockTunnelB1F.asm|_RockTunnelB1FSuperNerd2AfterBattleText|2": "them. So fun!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2BattleText|0": "My kith's tricks",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2BattleText|1": "will have you",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2BattleText|2": "bawling, kid!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2EndBattleText|0": "Uncle!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2EndBattleText|1": "Your tricks beat",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2EndBattleText|2": "mine, fair's fair.",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2AfterBattleText|0": "Up in the hills,",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2AfterBattleText|1": "STONE kith turn",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker2AfterBattleText|2": "up all the time.",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2BattleText|0": "I'm rarely down",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2BattleText|1": "in this hole, but",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2BattleText|2": "a match? Sure!",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2EndBattleText|0": "Aw!",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2EndBattleText|1": "Beaten!",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2AfterBattleText|0": "Pocket-size kith",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2AfterBattleText|1": "are best. Huge",
"text/RockTunnelB1F.asm|_RockTunnelB1FCooltrainerF2AfterBattleText|2": "ones scare me!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker3BattleText|0": "Come on, swing",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker3BattleText|1": "for the fences!",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker3EndBattleText|0": "Knocked",
"text/RockTunnelB1F.asm|_RockTunnelB1FHiker3EndBattleText|1": "flat!"
}