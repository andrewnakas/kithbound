{
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|0": "<RIVAL>: Well,",
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|1": "<PLAYER>! Lost?",
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|2": "This is a grave-",
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|3": "yard! Your kith",
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|4": "are still alive!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|5": "Not for long! I",
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|6": "can knock them",
"text/PokemonTower2F.asm|_PokemonTower2FRivalWhatBringsYouHereText|7": "out right here!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalDefeatedText|0": "No way!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalDefeatedText|1": "Cheater!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalDefeatedText|2": "I was going soft",
"text/PokemonTower2F.asm|_PokemonTower2FRivalDefeatedText|3": "on you anyway!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalVictoryText|0": "<RIVAL>: Heh!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalVictoryText|1": "Your whole team",
"text/PokemonTower2F.asm|_PokemonTower2FRivalVictoryText|2": "folded!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalVictoryText|3": "Go train before",
"text/PokemonTower2F.asm|_PokemonTower2FRivalVictoryText|4": "you embarrass me!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|0": "So, filling up",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|1": "that KITHLOG yet?",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|2": "I snared myself a",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|3": "SKULLWAIF!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|4": "Its big form,",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|5": "BONEWARDEN, hasn't",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|6": "turned up.",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|7": "Maybe none exist",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|8": "anymore. Anyhow,",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|9": "I'm out of here!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|10": "Places to be,",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|11": "people to beat!",
"text/PokemonTower2F.asm|_PokemonTower2FRivalHowsYourDexText|12": "Later, dawdler!",
"text/PokemonTower2F.asm|_PokemonTower2FChannelerText|0": "Not one of us can",
"text/PokemonTower2F.asm|_PokemonTower2FChannelerText|1": "name the shades",
"text/PokemonTower2F.asm|_PokemonTower2FChannelerText|2": "drifting here!",
"text/PokemonTower2F.asm|_PokemonTower2FChannelerText|3": "They say a GHOST",
"text/PokemonTower2F.asm|_PokemonTower2FChannelerText|4": "LENS shows their",
"text/PokemonTower2F.asm|_PokemonTower2FChannelerText|5": "true faces."
}