{
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|0": "OLD HOLT: Oh? A",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|1": "rescue, for me?",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|2": "Kind, but I was",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|3": "never a captive.",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|4": "I chose to climb.",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|5": "A grieving shade",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|6": "haunted this",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|7": "spire: SKULLWAIF's",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|8": "mother, a fallen",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|9": "BONEWARDEN. Now",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|10": "she rests at last.",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|11": "Your brave heart",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|12": "means a lot to an",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|13": "old man.",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|14": "Come down to my",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|15": "place, the little",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|16": "kith refuge below",
"text/PokemonTower7F.asm|_PokemonTower7FMrFujiRescueText|17": "the tower.",
"text/PokemonTower7F.asm|_PokemonTower7FRocket1BattleText|0": "Huh? Who let you",
"text/PokemonTower7F.asm|_PokemonTower7FRocket1BattleText|1": "up here, brat?",
"text/PokemonTower7F.asm|_PokemonTower7FRocket1EndBattleText|0": "Fine, fine!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket1AfterBattleText|0": "You'll pay for",
"text/PokemonTower7F.asm|_PokemonTower7FRocket1AfterBattleText|1": "this someday!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2BattleText|0": "Gramps here came",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2BattleText|1": "nagging us to go",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2BattleText|2": "easy on a few",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2BattleText|3": "worthless kith!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2BattleText|4": "We're settling",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2BattleText|5": "it, grown-up way!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2EndBattleText|0": "Okay!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2EndBattleText|1": "Uncle!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2AfterBattleText|0": "Kith exist to",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2AfterBattleText|1": "turn a profit,",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2AfterBattleText|2": "period!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2AfterBattleText|3": "Butt out of",
"text/PokemonTower7F.asm|_PokemonTower7FRocket2AfterBattleText|4": "GLOAM affairs!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket3BattleText|0": "No heroics today,",
"text/PokemonTower7F.asm|_PokemonTower7FRocket3BattleText|1": "brat!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket3EndBattleText|0": "You'll",
"text/PokemonTower7F.asm|_PokemonTower7FRocket3EndBattleText|1": "regret this!",
"text/PokemonTower7F.asm|_PokemonTower7FRocket3AfterBattleText|0": "GLOAM will make",
"text/PokemonTower7F.asm|_PokemonTower7FRocket3AfterBattleText|1": "you pay for this!"
}