{
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1BattleText|0": "Butt out, kid!",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1BattleText|1": "GLOAM jobs are",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1BattleText|2": "none of yours!",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1EndBattleText|0": "Ugh!",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1EndBattleText|1": "Knocked flat!",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1AfterBattleText|0": "The GHOST LENS?",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1AfterBattleText|1": "Our BOSS swiped",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1AfterBattleText|2": "that gadget. It's",
"text/RocketHideoutB3F.asm|_RocketHideoutB3FRocket1AfterBattleText|3": "hidden down here.",
"text/RocketHideoutB3F.asm|_RocketHideout3BattleText|0": "The guys above",
"text/RocketHideoutB3F.asm|_RocketHideout3BattleText|1": "radioed ahead.",
"text/RocketHideoutB3F.asm|_RocketHideout3BattleText|2": "We expected you!",
"text/RocketHideoutB3F.asm|_RocketHideout3EndBattleText3|0": "Huh?",
"text/RocketHideoutB3F.asm|_RocketHideout3EndBattleText3|1": "Beaten? Me?",
"text/RocketHideoutB3F.asm|_RocketHide3AfterBattleText3|0": "Fine, pass. Just",
"text/RocketHideoutB3F.asm|_RocketHide3AfterBattleText3|1": "know the lift",
"text/RocketHideoutB3F.asm|_RocketHide3AfterBattleText3|2": "won't budge with-",
"text/RocketHideoutB3F.asm|_RocketHide3AfterBattleText3|3": "out a HOIST KEY!"
}