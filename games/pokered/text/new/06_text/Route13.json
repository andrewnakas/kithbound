{
"text/Route13.asm|_Route13CooltrainerM1BattleText|0": "My feathered team",
"text/Route13.asm|_Route13CooltrainerM1BattleText|1": "is itching to go!",
"text/Route13.asm|_Route13CooltrainerM1EndBattleText|0": "My",
"text/Route13.asm|_Route13CooltrainerM1EndBattleText|1": "flock got beat?",
"text/Route13.asm|_Route13CooltrainerM1AfterBattleText|0": "Funny, my birds",
"text/Route13.asm|_Route13CooltrainerM1AfterBattleText|1": "still seem cheery",
"text/Route13.asm|_Route13CooltrainerM1AfterBattleText|2": "after that.",
"text/Route13.asm|_Route13CooltrainerF1BattleText|0": "Folks say I'm a",
"text/Route13.asm|_Route13CooltrainerF1BattleText|1": "prodigy! Ready?",
"text/Route13.asm|_Route13CooltrainerF1EndBattleText|0": "Aw!",
"text/Route13.asm|_Route13CooltrainerF1EndBattleText|1": "Not fair!",
"text/Route13.asm|_Route13CooltrainerF1AfterBattleText|0": "Someday I'll be",
"text/Route13.asm|_Route13CooltrainerF1AfterBattleText|1": "a great TAMER.",
"text/Route13.asm|_Route13CooltrainerF1AfterBattleText|2": "Lots of drills!",
"text/Route13.asm|_Route13CooltrainerF2BattleText|0": "Ooh, look at all",
"text/Route13.asm|_Route13CooltrainerF2BattleText|1": "those BADGES!",
"text/Route13.asm|_Route13CooltrainerF2EndBattleText|0": "Short",
"text/Route13.asm|_Route13CooltrainerF2EndBattleText|1": "of it!",
"text/Route13.asm|_Route13CooltrainerF2AfterBattleText|0": "Each BADGE means",
"text/Route13.asm|_Route13CooltrainerF2AfterBattleText|1": "a GYM boss fell",
"text/Route13.asm|_Route13CooltrainerF2AfterBattleText|2": "to you, right?",
"text/Route13.asm|_Route13CooltrainerF3BattleText|0": "My sweet little",
"text/Route13.asm|_Route13CooltrainerF3BattleText|1": "team would love",
"text/Route13.asm|_Route13CooltrainerF3BattleText|2": "to say hello!",
"text/Route13.asm|_Route13CooltrainerF3EndBattleText|0": "Golly!",
"text/Route13.asm|_Route13CooltrainerF3EndBattleText|1": "What a sweep!",
"text/Route13.asm|_Route13CooltrainerF3AfterBattleText|0": "Battles are how",
"text/Route13.asm|_Route13CooltrainerF3AfterBattleText|1": "kith grow strong,",
"text/Route13.asm|_Route13CooltrainerF3AfterBattleText|2": "cuteness aside!",
"text/Route13.asm|_Route13CooltrainerF4BattleText|0": "A cave once gave",
"text/Route13.asm|_Route13CooltrainerF4BattleText|1": "me a DASH MIX!",
"text/Route13.asm|_Route13CooltrainerF4EndBattleText|0": "Total",
"text/Route13.asm|_Route13CooltrainerF4EndBattleText|1": "flub!",
"text/Route13.asm|_Route13CooltrainerF4AfterBattleText|0": "That DASH MIX",
"text/Route13.asm|_Route13CooltrainerF4AfterBattleText|1": "made my kith zip",
"text/Route13.asm|_Route13CooltrainerF4AfterBattleText|2": "around so fast!",
"text/Route13.asm|_Route13CooltrainerM2BattleText|0": "I've got a tail-",
"text/Route13.asm|_Route13CooltrainerM2BattleText|1": "wind today!",
"text/Route13.asm|_Route13CooltrainerM2EndBattleText|0": "Head-",
"text/Route13.asm|_Route13CooltrainerM2EndBattleText|1": "wind now!",
"text/Route13.asm|_Route13CooltrainerM2AfterBattleText|0": "I'm done. Time",
"text/Route13.asm|_Route13CooltrainerM2AfterBattleText|1": "to SOAR home.",
"text/Route13.asm|_Route13Beauty1BattleText|0": "Ooh, a playmate!",
"text/Route13.asm|_Route13Beauty1BattleText|1": "Let's go!",
"text/Route13.asm|_Route13Beauty1EndBattleText|0": "Hey!",
"text/Route13.asm|_Route13Beauty1EndBattleText|1": "So rough!",
"text/Route13.asm|_Route13Beauty1AfterBattleText|0": "Are ♂ kith tough-",
"text/Route13.asm|_Route13Beauty1AfterBattleText|1": "er than ♀ ones?",
"text/Route13.asm|_Route13Beauty1AfterBattleText|2": "I can't decide.",
"text/Route13.asm|_Route13Beauty2BattleText|0": "Care for a quick",
"text/Route13.asm|_Route13Beauty2BattleText|1": "match, darling?",
"text/Route13.asm|_Route13Beauty2EndBattleText|0": "Done",
"text/Route13.asm|_Route13Beauty2EndBattleText|1": "so soon?",
"text/Route13.asm|_Route13Beauty2AfterBattleText|0": "Types and stats?",
"text/Route13.asm|_Route13Beauty2AfterBattleText|1": "No idea. I pick",
"text/Route13.asm|_Route13Beauty2AfterBattleText|2": "whichever kith",
"text/Route13.asm|_Route13Beauty2AfterBattleText|3": "look stylish!",
"text/Route13.asm|_Route13BikerBattleText|0": "Got a problem,",
"text/Route13.asm|_Route13BikerBattleText|1": "squirt?",
"text/Route13.asm|_Route13BikerEndBattleText|0": "Argh!",
"text/Route13.asm|_Route13BikerEndBattleText|1": "Blew a tire!",
"text/Route13.asm|_Route13BikerAfterBattleText|0": "Scram!",
"text/Route13.asm|_Route13CooltrainerM3BattleText|0": "Wings are all I",
"text/Route13.asm|_Route13CooltrainerM3BattleText|1": "ever train!",
"text/Route13.asm|_Route13CooltrainerM3EndBattleText|0": "Grounded",
"text/Route13.asm|_Route13CooltrainerM3EndBattleText|1": "for good!",
"text/Route13.asm|_Route13CooltrainerM3AfterBattleText|0": "If only I soared",
"text/Route13.asm|_Route13CooltrainerM3AfterBattleText|1": "like PIPWING or",
"text/Route13.asm|_Route13CooltrainerM3AfterBattleText|2": "GUSTJAY...",
"text/Route13.asm|_Route13TrainerTips1Text|0": "TAMER TIPS",
"text/Route13.asm|_Route13TrainerTips1Text|1": "Check left of",
"text/Route13.asm|_Route13TrainerTips1Text|2": "this signpost!",
"text/Route13.asm|_Route13TrainerTips2Text|0": "TAMER TIPS",
"text/Route13.asm|_Route13TrainerTips2Text|1": "In your bag, the",
"text/Route13.asm|_Route13TrainerTips2Text|2": "SELECT button",
"text/Route13.asm|_Route13TrainerTips2Text|3": "reorders items!",
"text/Route13.asm|_Route13SignText|0": "PATH 13",
"text/Route13.asm|_Route13SignText|1": "Northward: the",
"text/Route13.asm|_Route13SignText|2": "HUSHED BRIDGE"
}