{
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdBattleText|0": "Every hall loops",
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdBattleText|1": "back! This wreck",
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdBattleText|2": "is a maze of ash!",
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdEndBattleText|0": "Argh!",
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdEndBattleText|1": "My stolen haul!",
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdAfterBattleText|0": "Each lever swaps",
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdAfterBattleText|1": "which doors swing",
"text/PokemonMansion2F.asm|_PokemonMansion2FSuperNerdAfterBattleText|2": "shut, see?",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary1Text|0": "Journal: Day 61",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary1Text|1": "Far rainforest,",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary1Text|2": "past the cliffs",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary1Text|3": "We found a kith",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary1Text|4": "no book knew, in",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary1Text|5": "the thick canopy.",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary2Text|0": "Journal: Day 66",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary2Text|1": "We chose a name",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary2Text|2": "for our find. Our",
"text/PokemonMansion2F.asm|_PokemonMansion2FDiary2Text|3": "kith is PRIMORA.",
"text/PokemonMansion2F.asm|_PokemonMansion2FSwitchText|0": "A hidden lever!",
"text/PokemonMansion2F.asm|_PokemonMansion2FSwitchText|1": "Flip it?",
"text/PokemonMansion2F.asm|_PokemonMansion2FSwitchPressedText|0": "Click! Done.",
"text/PokemonMansion2F.asm|_PokemonMansion2FSwitchNotPressedText|0": "Better leave it."
}