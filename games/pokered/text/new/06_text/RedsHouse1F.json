{
"text/RedsHouse1F.asm|_RedsHouse1FMomWakeUpText|0": "MOM: Ah, today.",
"text/RedsHouse1F.asm|_RedsHouse1FMomWakeUpText|1": "I knew this day",
"text/RedsHouse1F.asm|_RedsHouse1FMomWakeUpText|2": "would come. I've",
"text/RedsHouse1F.asm|_RedsHouse1FMomWakeUpText|3": "packed you snacks.",
"text/RedsHouse1F.asm|_RedsHouse1FMomWakeUpText|4": "PROF.BRAMBLE just",
"text/RedsHouse1F.asm|_RedsHouse1FMomWakeUpText|5": "called. He wants",
"text/RedsHouse1F.asm|_RedsHouse1FMomWakeUpText|6": "you at the lab.",
"text/RedsHouse1F.asm|_RedsHouse1FMomYouShouldRestText|0": "MOM: <PLAYER>!",
"text/RedsHouse1F.asm|_RedsHouse1FMomYouShouldRestText|1": "Sit down a bit,",
"text/RedsHouse1F.asm|_RedsHouse1FMomYouShouldRestText|2": "sweetheart.",
"text/RedsHouse1F.asm|_RedsHouse1FMomLookingGreatText|0": "MOM: There!",
"text/RedsHouse1F.asm|_RedsHouse1FMomLookingGreatText|1": "Everyone looks",
"text/RedsHouse1F.asm|_RedsHouse1FMomLookingGreatText|2": "rested and",
"text/RedsHouse1F.asm|_RedsHouse1FMomLookingGreatText|3": "rosy-cheeked.",
"text/RedsHouse1F.asm|_RedsHouse1FMomLookingGreatText|4": "Off you go, dear!",
"text/RedsHouse1F.asm|_RedsHouse1FTVStandByMeMovieText|0": "A film is on.",
"text/RedsHouse1F.asm|_RedsHouse1FTVStandByMeMovieText|1": "A band of kids",
"text/RedsHouse1F.asm|_RedsHouse1FTVStandByMeMovieText|2": "follows a river",
"text/RedsHouse1F.asm|_RedsHouse1FTVStandByMeMovieText|3": "to its source.",
"text/RedsHouse1F.asm|_RedsHouse1FTVStandByMeMovieText|4": "Adventure calls.",
"text/RedsHouse1F.asm|_RedsHouse1FTVWrongSideText|0": "That's the back."
