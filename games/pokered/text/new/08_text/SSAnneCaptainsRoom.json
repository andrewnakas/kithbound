{
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|0": "CAPTAIN: Blurgh...",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|1": "The room spins...",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|2": "Hrk! My belly...",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|3": "<PLAYER> patted",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|4": "the CAPTAIN on",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|5": "the back.",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|6": "Pat, pat...",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomRubCaptainsBackText|7": "Pat, pat...@",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|0": "CAPTAIN: Ahh!",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|1": "Bless you! The",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|2": "sea's calm again!",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|3": "Care to see my",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|4": "famous blade art?",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|5": "Sadly, my arms",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|6": "are jelly still.",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|7": "Aha! Here, take",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|8": "this instead.",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|9": "A kith that learns",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|10": "it can swing a",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|11": "CHOP whenever",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainIFeelMuchBetterText|12": "you like!",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainReceivedHM01Text|0": "<PLAYER> took",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainNotSickAnymoreText|0": "CAPTAIN: Ahh!",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainNotSickAnymoreText|1": "My color's back.",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainNotSickAnymoreText|2": "Time we hoisted",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainNotSickAnymoreText|3": "anchor, I think.",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainHM01NoRoomText|0": "Oh dear, no space",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomCaptainHM01NoRoomText|1": "left in your bag!",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomTrashText|0": "Ew! Old fish",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomTrashText|1": "bones in there!",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomSeasickBookText|0": "Steady Belly: A",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomSeasickBookText|1": "Sailor's Guide.",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomSeasickBookText|2": "A bookmark sits",
 "text/SSAnneCaptainsRoom.asm|_SSAnneCaptainsRoomSeasickBookText|3": "in chapter one."
}