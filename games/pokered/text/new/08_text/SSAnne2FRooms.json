{
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman3Text|0": "I've crossed seven",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman3Text|1": "seas, yet no kith",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman3Text|2": "ever napped as",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman3Text|3": "oddly as that one.",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman3Text|4": "Picture it, curled",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman3Text|5": "up just so!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman4Text|0": "On one voyage, a",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman4Text|1": "kith swam beside",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman4Text|2": "us with children",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman4Text|3": "on its back!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGrampsText|0": "CHOP will clear",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGrampsText|1": "scrubby hedges.",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman5Text|0": "Ever toured the",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman5Text|1": "WILD PARK down",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman5Text|2": "by MARSHGATE?",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman5Text|3": "I saw kith there",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman5Text|4": "I'd never logged!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsLittleBoyText|0": "Papa says we can",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsLittleBoyText|1": "visit WILD PARK",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsLittleBoyText|2": "next summer! Yay!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsBrunetteGirlText|0": "Poor CAPTAIN. His",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsBrunetteGirlText|1": "face went green as",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsBrunetteGirlText|2": "seaweed!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsBeautyText|0": "Half the guests",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsBeautyText|1": "are queasy, dear.",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1BattleText|0": "A bout with the",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1BattleText|1": "young oils these",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1BattleText|2": "old joints!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1EndBattleText|0": "Splendid!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1EndBattleText|1": "My knees thank",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1EndBattleText|2": "you, child!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1AfterBattleText|0": "Had I your vim, it",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman1AfterBattleText|1": "might differ...",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsFisherBattleText|0": "Look at the catch",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsFisherBattleText|1": "I reeled in!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsFisherEndBattleText|1": "out of bait!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsFisherAfterBattleText|0": "The dance?",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsFisherAfterBattleText|1": "Oh, the grand",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsFisherAfterBattleText|2": "ball wrapped up",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsFisherAfterBattleText|3": "hours back.",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman2BattleText|0": "Power or rarity,",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman2BattleText|1": "which do you",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman2BattleText|2": "prize in a kith?",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman2EndBattleText|0": "Bravo,",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman2EndBattleText|1": "my young friend!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman2AfterBattleText|0": "Why choose? I want",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsGentleman2AfterBattleText|1": "both in one kith.",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsCooltrainerFBattleText|0": "Weren't you absent",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsCooltrainerFBattleText|1": "from the ball?",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsCooltrainerFEndBattleText|0": "Okay,",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsCooltrainerFEndBattleText|1": "you win!",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsCooltrainerFAfterBattleText|0": "Your team is so",
 "text/SSAnne2FRooms.asm|_SSAnne2FRoomsCooltrainerFAfterBattleText|1": "tough! I'm jealous!"
}