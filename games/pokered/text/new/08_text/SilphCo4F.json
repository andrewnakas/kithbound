{
 "text/SilphCo4F.asm|_SilphCo4FSilphWorkerMImHidingText|0": "Shh! I'm a potted",
 "text/SilphCo4F.asm|_SilphCo4FSilphWorkerMImHidingText|1": "plant right now!",
 "text/SilphCo4F.asm|_SilphCo4FSilphWorkerMTeamRocketIsGoneText|0": "Wait, GLOAM has",
 "text/SilphCo4F.asm|_SilphCo4FSilphWorkerMTeamRocketIsGoneText|1": "really left?",
 "text/SilphCo4F.asm|_SilphCo4FRocket1BattleText|0": "This building",
 "text/SilphCo4F.asm|_SilphCo4FRocket1BattleText|1": "answers to GLOAM",
 "text/SilphCo4F.asm|_SilphCo4FRocket1BattleText|2": "now!",
 "text/SilphCo4F.asm|_SilphCo4FRocket1EndBattleText|0": "Grr!",
 "text/SilphCo4F.asm|_SilphCo4FRocket1AfterBattleText|0": "Hah! The chief",
 "text/SilphCo4F.asm|_SilphCo4FRocket1AfterBattleText|1": "wanted VANTEC for",
 "text/SilphCo4F.asm|_SilphCo4FRocket1AfterBattleText|2": "years and years!",
 "text/SilphCo4F.asm|_SilphCo4FScientistBattleText|0": "My kith march",
 "text/SilphCo4F.asm|_SilphCo4FScientistBattleText|1": "when I say march!",
 "text/SilphCo4F.asm|_SilphCo4FScientistEndBattleText|0": "Useless!",
 "text/SilphCo4F.asm|_SilphCo4FScientistEndBattleText|1": "Pathetic kith!",
 "text/SilphCo4F.asm|_SilphCo4FScientistAfterBattleText|0": "Every door here",
 "text/SilphCo4F.asm|_SilphCo4FScientistAfterBattleText|1": "is sealed by a",
 "text/SilphCo4F.asm|_SilphCo4FScientistAfterBattleText|2": "lock pad. Only a",
 "text/SilphCo4F.asm|_SilphCo4FScientistAfterBattleText|3": "PASS CARD works!",
 "text/SilphCo4F.asm|_SilphCo4FRocket2BattleText|0": "Stop right there!",
 "text/SilphCo4F.asm|_SilphCo4FRocket2EndBattleText|0": "Just",
 "text/SilphCo4F.asm|_SilphCo4FRocket2EndBattleText|1": "who ARE you?",
 "text/SilphCo4F.asm|_SilphCo4FRocket2AfterBattleText|0": "The chief on 11F",
 "text/SilphCo4F.asm|_SilphCo4FRocket2AfterBattleText|1": "must hear of this!"
