{
 "text/SaffronGym.asm|_SaffronGymSabrinaText|0": "Each warp you took",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|1": "I saw coming.",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|2": "Since I was small,",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|3": "other minds have",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|4": "whispered to me.",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|5": "I heard my mother",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|6": "think my name",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|7": "before she said.",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|8": "Battles bore me.",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|9": "Still, if you ask",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|10": "it, I'll let you",
 "text/SaffronGym.asm|_SaffronGymSabrinaText|11": "feel what I feel!",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|1": "stunned.",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|2": "How strange. And",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|3": "humbling.",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|4": "My training was",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|5": "lazier than I",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|6": "believed.",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|7": "Take this, the",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedMarshBadgeText|8": "PRISM BADGE!@",
 "text/SaffronGym.asm|_SaffronGymSabrinaPostBattleAdviceText|0": "Each of us hears",
 "text/SaffronGym.asm|_SaffronGymSabrinaPostBattleAdviceText|1": "a little. Most",
 "text/SaffronGym.asm|_SaffronGymSabrinaPostBattleAdviceText|2": "call it a hunch",
 "text/SaffronGym.asm|_SaffronGymSabrinaPostBattleAdviceText|3": "and move on.",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|0": "With the PRISM",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|1": "BADGE, kith up",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|2": "to L70 heed you.",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|3": "Any kith above",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|4": "that may turn",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|5": "stubborn and skip",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|6": "your commands.",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|7": "Raise them with",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|8": "patience, not",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|9": "haste.",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|10": "One more gift.",
 "text/SaffronGym.asm|_SaffronGymSabrinaMarshBadgeInfoText|11": "Please take this.",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedTM46Text|0": "<PLAYER> now has",
 "text/SaffronGym.asm|_SaffronGymSabrinaReceivedTM46Text|1": "SC46!@",
 "text/SaffronGym.asm|_TM46ExplanationText|0": "SC46: MIND WAVE.",
 "text/SaffronGym.asm|_TM46ExplanationText|1": "A thought-ripple",
 "text/SaffronGym.asm|_TM46ExplanationText|2": "that strikes the",
 "text/SaffronGym.asm|_TM46ExplanationText|3": "foe from within.",
 "text/SaffronGym.asm|_SaffronGymSabrinaTM46NoRoomText|0": "Your bag has no",
 "text/SaffronGym.asm|_SaffronGymSabrinaTM46NoRoomText|1": "space for it.",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|0": "Hey hey, future",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|1": "CROWN winner!",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|2": "SIBYL's team hits",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|3": "with thought, not",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|4": "muscle!",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|5": "BRAWL kith have",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|6": "it rough against",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|7": "MIND types!",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|8": "They fold before",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|9": "landing a single",
 "text/SaffronGym.asm|_SaffronGymGuideChampInMakingText|10": "jab!",
 "text/SaffronGym.asm|_SaffronGymGuideBeatSabrinaText|0": "Reading minds,",
 "text/SaffronGym.asm|_SaffronGymGuideBeatSabrinaText|1": "eh?",
 "text/SaffronGym.asm|_SaffronGymGuideBeatSabrinaText|2": "I'd use it to win",
 "text/SaffronGym.asm|_SaffronGymGuideBeatSabrinaText|3": "every card game in",
 "text/SaffronGym.asm|_SaffronGymGuideBeatSabrinaText|4": "the PRIZE HALL!",
 "text/SaffronGym.asm|_SaffronGymChanneler1BattleText|0": "I'm twice her age,",
 "text/SaffronGym.asm|_SaffronGymChanneler1BattleText|1": "yet I bow to",
 "text/SaffronGym.asm|_SaffronGymChanneler1BattleText|2": "SIBYL gladly!",
 "text/SaffronGym.asm|_SaffronGymChanneler1EndBattleText|0": "Still",
 "text/SaffronGym.asm|_SaffronGymChanneler1EndBattleText|1": "too weak!",
 "text/SaffronGym.asm|_SaffronGymChanneler1AfterBattleText|0": "When two teams",
 "text/SaffronGym.asm|_SaffronGymChanneler1AfterBattleText|1": "match up evenly,",
 "text/SaffronGym.asm|_SaffronGymChanneler1AfterBattleText|2": "firm resolve",
 "text/SaffronGym.asm|_SaffronGymChanneler1AfterBattleText|3": "tips the scale!",
 "text/SaffronGym.asm|_SaffronGymChanneler1AfterBattleText|4": "To topple SIBYL,",
 "text/SaffronGym.asm|_SaffronGymChanneler1AfterBattleText|5": "want it more",
 "text/SaffronGym.asm|_SaffronGymChanneler1AfterBattleText|6": "than she does!",
 "text/SaffronGym.asm|_SaffronGymYoungster1BattleText|0": "Feel that chill?",
 "text/SaffronGym.asm|_SaffronGymYoungster1BattleText|1": "That's my mind!",
 "text/SaffronGym.asm|_SaffronGymYoungster1EndBattleText|0": "My crystal",
 "text/SaffronGym.asm|_SaffronGymYoungster1EndBattleText|1": "ball lied!",
 "text/SaffronGym.asm|_SaffronGymYoungster1AfterBattleText|0": "MIND kith dread",
 "text/SaffronGym.asm|_SaffronGymYoungster1AfterBattleText|1": "SHADE and HIVE",
 "text/SaffronGym.asm|_SaffronGymYoungster1AfterBattleText|2": "foes most of all!",
 "text/SaffronGym.asm|_SaffronGymChanneler2BattleText|0": "They say kith",
 "text/SaffronGym.asm|_SaffronGymChanneler2BattleText|1": "grow to mirror",
 "text/SaffronGym.asm|_SaffronGymChanneler2BattleText|2": "their TAMERS.",
 "text/SaffronGym.asm|_SaffronGymChanneler2BattleText|3": "So yours must be",
 "text/SaffronGym.asm|_SaffronGymChanneler2BattleText|4": "sturdy, hm?",
 "text/SaffronGym.asm|_SaffronGymChanneler2EndBattleText|0": "Just as",
 "text/SaffronGym.asm|_SaffronGymChanneler2EndBattleText|1": "I sensed!",
 "text/SaffronGym.asm|_SaffronGymChanneler2AfterBattleText|0": "My kith need",
 "text/SaffronGym.asm|_SaffronGymChanneler2AfterBattleText|1": "sharper skills",
 "text/SaffronGym.asm|_SaffronGymChanneler2AfterBattleText|2": "than these.",
 "text/SaffronGym.asm|_SaffronGymYoungster2BattleText|0": "Raw muscle won't",
 "text/SaffronGym.asm|_SaffronGymYoungster2BattleText|1": "get you far in",
 "text/SaffronGym.asm|_SaffronGymYoungster2BattleText|2": "here!",
 "text/SaffronGym.asm|_SaffronGymYoungster2EndBattleText|0": "No way!",
 "text/SaffronGym.asm|_SaffronGymYoungster2EndBattleText|1": "How?!",
 "text/SaffronGym.asm|_SaffronGymYoungster2AfterBattleText|0": "SIBYL flattened",
 "text/SaffronGym.asm|_SaffronGymYoungster2AfterBattleText|1": "the DOJO boss",
 "text/SaffronGym.asm|_SaffronGymYoungster2AfterBattleText|2": "on the next lot!",
 "text/SaffronGym.asm|_SaffronGymChanneler3BattleText|0": "Our kith meet,",
 "text/SaffronGym.asm|_SaffronGymChanneler3BattleText|1": "and fate will",
 "text/SaffronGym.asm|_SaffronGymChanneler3BattleText|2": "decide!",
 "text/SaffronGym.asm|_SaffronGymChanneler3EndBattleText|0": "Fate",
 "text/SaffronGym.asm|_SaffronGymChanneler3EndBattleText|1": "was cruel!",
 "text/SaffronGym.asm|_SaffronGymChanneler3AfterBattleText|0": "I dreamed of this",
 "text/SaffronGym.asm|_SaffronGymChanneler3AfterBattleText|1": "very bout last",
 "text/SaffronGym.asm|_SaffronGymChanneler3AfterBattleText|2": "night.",
 "text/SaffronGym.asm|_SaffronGymYoungster3BattleText|0": "SIBYL may be my",
 "text/SaffronGym.asm|_SaffronGymYoungster3BattleText|1": "age, but she's",
 "text/SaffronGym.asm|_SaffronGymYoungster3BattleText|2": "the boss here!",
 "text/SaffronGym.asm|_SaffronGymYoungster3BattleText|3": "The tiles won't",
 "text/SaffronGym.asm|_SaffronGymYoungster3BattleText|4": "make it simple!",
 "text/SaffronGym.asm|_SaffronGymYoungster3EndBattleText|0": "My focus",
 "text/SaffronGym.asm|_SaffronGymYoungster3EndBattleText|1": "just snapped!",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|0": "SPIREHOLM once",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|1": "had two GYMs, you",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|2": "know.",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|3": "Then the DOJO",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|4": "challenged us,",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|5": "lost big, and",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|6": "gave up its GYM",
 "text/SaffronGym.asm|_SaffronGymYoungster3AfterBattleText|7": "title for good!",
 "text/SaffronGym.asm|_SaffronGymYoungster4BattleText|0": "This GYM is known",
 "text/SaffronGym.asm|_SaffronGymYoungster4BattleText|1": "far and wide for",
 "text/SaffronGym.asm|_SaffronGymYoungster4BattleText|2": "its seers!",
 "text/SaffronGym.asm|_SaffronGymYoungster4BattleText|3": "You came here",
 "text/SaffronGym.asm|_SaffronGymYoungster4BattleText|4": "for SIBYL.",
 "text/SaffronGym.asm|_SaffronGymYoungster4BattleText|5": "I sense it!",
 "text/SaffronGym.asm|_SaffronGymYoungster4EndBattleText|0": "Nooo!",
 "text/SaffronGym.asm|_SaffronGymYoungster4AfterBattleText|0": "See? I peeked at",
 "text/SaffronGym.asm|_SaffronGymYoungster4AfterBattleText|1": "your thoughts. You",
 "text/SaffronGym.asm|_SaffronGymYoungster4AfterBattleText|2": "were thinking it!"
}