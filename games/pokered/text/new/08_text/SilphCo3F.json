 "text/SilphCo3F.asm|_SilphCo3FRocketEndBattleText|0": "Okay,",
 "text/SilphCo3F.asm|_SilphCo3FRocketEndBattleText|1": "okay!",
 "text/SilphCo3F.asm|_SilphCo3FRocketAfterBattleText|0": "Psst. Locked doors",
 "text/SilphCo3F.asm|_SilphCo3FRocketAfterBattleText|1": "pop right open",
 "text/SilphCo3F.asm|_SilphCo3FRocketAfterBattleText|2": "for a PASS CARD!",
 "text/SilphCo3F.asm|_SilphCo3FScientistBattleText|0": "GLOAM pays me far",
 "text/SilphCo3F.asm|_SilphCo3FScientistBattleText|1": "more than these",
 "text/SilphCo3F.asm|_SilphCo3FScientistBattleText|2": "cheapskates did!",
 "text/SilphCo3F.asm|_SilphCo3FScientistEndBattleText|0": "Ugh,",
 "text/SilphCo3F.asm|_SilphCo3FScientistEndBattleText|1": "you got me!",
 "text/SilphCo3F.asm|_SilphCo3FScientistAfterBattleText|0": "Hmph...",
 "text/SilphCo3F.asm|_SilphCo3FScientistAfterBattleText|1": "GLOAM swore they",
 "text/SilphCo3F.asm|_SilphCo3FScientistAfterBattleText|2": "would fund my",
 "text/SilphCo3F.asm|_SilphCo3FScientistAfterBattleText|3": "lab work on kith,",
 "text/SilphCo3F.asm|_SilphCo3FScientistAfterBattleText|4": "no questions!"
