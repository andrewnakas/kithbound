{
 "text/SilphCo3F.asm|_SilphCo3FSilphWorkerMWhatShouldIDoText|0": "I'm just a clerk!",
 "text/SilphCo3F.asm|_SilphCo3FSilphWorkerMWhatShouldIDoText|1": "Do I run? Hide?",
