{
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsMachokeText|0": "HEFTGRIP: Hrmf!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsMachokeText|1": "Hup hup!@",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor1BattleText|0": "Below decks we",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor1BattleText|1": "settle things the",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor1BattleText|2": "old way. Ready?",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor1EndBattleText|0": "Aye!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor1EndBattleText|1": "Fair and square!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor1AfterBattleText|0": "Ever think of",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor1AfterBattleText|1": "signing on, kid?",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor2BattleText|0": "No landlubber",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor2BattleText|1": "outdoes me!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor2EndBattleText|0": "I'm",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor2EndBattleText|1": "capsized!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor2AfterBattleText|0": "There's a famous",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor2AfterBattleText|1": "old angler living",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor2AfterBattleText|2": "in PORTSALT.",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor3BattleText|0": "Deckhands raise",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor3BattleText|1": "kith as well!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor3EndBattleText|0": "Huh,",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor3EndBattleText|1": "sharp work.",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor3AfterBattleText|0": "Every one of my",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor3AfterBattleText|1": "kith was hooked",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor3AfterBattleText|2": "off the rail!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor4BattleText|0": "You've got grit,",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor4BattleText|1": "I can tell!@",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor4EndBattleText|0": "Bah!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor4EndBattleText|1": "Sunk!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor4AfterBattleText|0": "The best sea kith",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor4AfterBattleText|1": "stay down deep.",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor4AfterBattleText|2": "Bring a fish rod!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5BattleText|0": "Lose to me and",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5BattleText|1": "you swab the hull",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5BattleText|2": "for a week!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5EndBattleText|0": "Blast!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5EndBattleText|1": "A pup beat me!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5AfterBattleText|0": "Jelly kith slip",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5AfterBattleText|1": "in through the",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSailor5AfterBattleText|2": "bilge pumps.",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherBattleText|0": "Ho there, friend!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherBattleText|1": "Got a minute?",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherBattleText|2": "Every kith I own",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherBattleText|3": "came out of salt!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherEndBattleText|0": "Rats!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherEndBattleText|1": "The big one",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherEndBattleText|2": "slipped my line!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherAfterBattleText|0": "I'd hoped you'd",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherAfterBattleText|1": "carry my tackle",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsFisherAfterBattleText|2": "box for me!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSuperNerdText|0": "See HEFTGRIP? He's",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSuperNerdText|1": "my pal. So strong!",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSuperNerdText|2": "With a HEAVE he",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSuperNerdText|3": "can shove giant",
 "text/SSAnneB1FRooms.asm|_SSAnneB1FRoomsSuperNerdText|4": "boulders aside!"
}