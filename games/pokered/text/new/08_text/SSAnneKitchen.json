{
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook1Text|0": "Shoo, little one!",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook1Text|1": "Hot pans coming",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook1Text|2": "through! Move!",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook2Text|0": "Somebody tossed a",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook2Text|1": "snare in the bin.",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook3Text|0": "So many orders!",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook3Text|1": "My head spins!",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook4Text|0": "La la loo, la la",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook4Text|1": "lee...",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook4Text|2": "Carrots, carrots,",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook4Text|3": "all day long!",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook4Text|4": "La la...",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook5Text|0": "Heard of",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook5Text|1": "SLUMBERUS?",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook5Text|2": "Snack, nap, snack,",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook5Text|3": "nap. Dream life!",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook6Text|0": "Sob...hic...",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook6Text|1": "They only let me",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook6Text|2": "chop shallots...",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook6Text|3": "Sob...",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook7MainCourseIsText|0": "Ahem! You address",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook7MainCourseIsText|1": "the head CHEF!",
 "text/SSAnneKitchen.asm|_SSAnneKitchenCook7MainCourseIsText|2": "Tonight we serve",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7SalmonDuSaladText|0": "Salmon Tartlets!",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7SalmonDuSaladText|1": "The diners will",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7SalmonDuSaladText|2": "moan about fish",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7SalmonDuSaladText|3": "yet again, alas!",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7EelsAuBarbecueText|0": "Grilled Eel Roll!",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7EelsAuBarbecueText|1": "A riot awaits",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7EelsAuBarbecueText|2": "me, I suspect.",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7PrimeBeefSteakText|0": "Roast Beef Royal!",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7PrimeBeefSteakText|1": "But is there beef",
 "text/SSAnneKitchen.asm|SSAnneKitchenCook7PrimeBeefSteakText|2": "enough for all?"
}