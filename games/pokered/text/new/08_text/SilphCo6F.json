{
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM1TookOverTheBuildingText|0": "Dark coats burst",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM1TookOverTheBuildingText|1": "in and seized",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM1TookOverTheBuildingText|2": "every floor!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM1BackToWorkText|0": "Right. Back to my",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM1BackToWorkText|1": "filing, I guess!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerMHelpMePleaseText|0": "Eep! Eep! Is it",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerMHelpMePleaseText|1": "over? Save me!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerMWeGotEngagedText|0": "She said yes!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerMWeGotEngagedText|1": "Can you believe?",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF1SuchACowardText|0": "He's been under",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF1SuchACowardText|1": "that desk all day!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF1HaveToMarryHimText|0": "Someone has to",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF1HaveToMarryHimText|1": "look after the",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF1HaveToMarryHimText|2": "big scaredy-cat!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF2TeamRocketConquerWorldText|0": "GLOAM wants to",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF2TeamRocketConquerWorldText|1": "rule every land",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF2TeamRocketConquerWorldText|2": "using stolen",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF2TeamRocketConquerWorldText|3": "kith!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF2TeamRocketRanText|0": "You sent GLOAM",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerF2TeamRocketRanText|1": "packing! Thanks!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM3TargetedSilphText|0": "I bet they came",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM3TargetedSilphText|1": "for our snares",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM3TargetedSilphText|2": "and other kith",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM3TargetedSilphText|3": "gadgets.",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM3WorkForSilphText|0": "Grow up and join",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM3WorkForSilphText|1": "our team someday!",
 "text/SilphCo6F.asm|_SilphCo6FSilphWorkerM3WorkForSilphText|2": "VANTEC hires kids!",
 "text/SilphCo6F.asm|_SilphCo6FRocket1BattleText|0": "Meet the first of",
 "text/SilphCo6F.asm|_SilphCo6FRocket1BattleText|1": "the GLOAM QUARTET!",
 "text/SilphCo6F.asm|_SilphCo6FRocket1EndBattleText|0": "Fizzled",
 "text/SilphCo6F.asm|_SilphCo6FRocket1EndBattleText|1": "out!",
 "text/SilphCo6F.asm|_SilphCo6FRocket1AfterBattleText|0": "Laugh now! The",
 "text/SilphCo6F.asm|_SilphCo6FRocket1AfterBattleText|1": "other three will",
 "text/SilphCo6F.asm|_SilphCo6FRocket1AfterBattleText|2": "settle this!",
 "text/SilphCo6F.asm|_SilphCo6FScientistBattleText|0": "That stingy",
 "text/SilphCo6F.asm|_SilphCo6FScientistBattleText|1": "CEO of ours!",
 "text/SilphCo6F.asm|_SilphCo6FScientistBattleText|2": "He shipped me off",
 "text/SilphCo6F.asm|_SilphCo6FScientistBattleText|3": "to the far north",
 "text/SilphCo6F.asm|_SilphCo6FScientistBattleText|4": "ice outpost!",
 "text/SilphCo6F.asm|_SilphCo6FScientistEndBattleText|0": "Blast!",
 "text/SilphCo6F.asm|_SilphCo6FScientistAfterBattleText|0": "The ice outpost?",
 "text/SilphCo6F.asm|_SilphCo6FScientistAfterBattleText|1": "Nothing but snow",
 "text/SilphCo6F.asm|_SilphCo6FScientistAfterBattleText|2": "and polar winds!",
 "text/SilphCo6F.asm|_SilphCo6FRocket2BattleText|0": "You'd cross GLOAM,",
 "text/SilphCo6F.asm|_SilphCo6FRocket2BattleText|1": "of all people?",
 "text/SilphCo6F.asm|_SilphCo6FRocket2EndBattleText|0": "Snake",
 "text/SilphCo6F.asm|_SilphCo6FRocket2EndBattleText|1": "in the grass!",
 "text/SilphCo6F.asm|_SilphCo6FRocket2AfterBattleText|0": "Pick the good guys",
 "text/SilphCo6F.asm|_SilphCo6FRocket2AfterBattleText|1": "and the bad guys",
 "text/SilphCo6F.asm|_SilphCo6FRocket2AfterBattleText|2": "call you a snake!"
}