{
 "text/SilphCo2F.asm|SilphCo2FSilphWorkerFPleaseTakeThisText|0": "Aaah!",
 "text/SilphCo2F.asm|SilphCo2FSilphWorkerFPleaseTakeThisText|1": "Get away! Please!",
 "text/SilphCo2F.asm|SilphCo2FSilphWorkerFPleaseTakeThisText|2": "Wait, no dark",
 "text/SilphCo2F.asm|SilphCo2FSilphWorkerFPleaseTakeThisText|3": "coat... You're",
 "text/SilphCo2F.asm|SilphCo2FSilphWorkerFPleaseTakeThisText|4": "not one of them.",
 "text/SilphCo2F.asm|SilphCo2FSilphWorkerFPleaseTakeThisText|5": "Forgive me. Take",
 "text/SilphCo2F.asm|SilphCo2FSilphWorkerFPleaseTakeThisText|6": "this, as thanks!",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFReceivedTM36Text|0": "<PLAYER> took",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36ExplanationText|0": "SC36 holds",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36ExplanationText|1": "BURST!",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36ExplanationText|2": "The blast is huge,",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36ExplanationText|3": "but the kith who",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36ExplanationText|4": "sets it off drops",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36ExplanationText|5": "too. Use wisely.",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36NoRoomText|0": "Oh, your bag is",
 "text/SilphCo2F.asm|_SilphCo2FSilphWorkerFTM36NoRoomText|1": "packed solid.",
 "text/SilphCo2F.asm|_SilphCo2FScientist1BattleText|0": "Eek! I just work",
 "text/SilphCo2F.asm|_SilphCo2FScientist1BattleText|1": "here, honest!",
 "text/SilphCo2F.asm|_SilphCo2FScientist1EndBattleText|0": "What",
 "text/SilphCo2F.asm|_SilphCo2FScientist1EndBattleText|1": "gave my GLOAM",
 "text/SilphCo2F.asm|_SilphCo2FScientist1EndBattleText|2": "side away?",
 "text/SilphCo2F.asm|_SilphCo2FScientist1AfterBattleText|0": "Two paychecks are",
 "text/SilphCo2F.asm|_SilphCo2FScientist1AfterBattleText|1": "better than one,",
 "text/SilphCo2F.asm|_SilphCo2FScientist1AfterBattleText|2": "right?",
 "text/SilphCo2F.asm|_SilphCo2FScientist2BattleText|0": "Staff only! Turn",
 "text/SilphCo2F.asm|_SilphCo2FScientist2BattleText|1": "around, kid!",
 "text/SilphCo2F.asm|_SilphCo2FScientist2EndBattleText|0": "Not",
 "text/SilphCo2F.asm|_SilphCo2FScientist2EndBattleText|1": "bad.",
 "text/SilphCo2F.asm|_SilphCo2FScientist2AfterBattleText|0": "Bet the warp pads",
 "text/SilphCo2F.asm|_SilphCo2FScientist2AfterBattleText|1": "here confuse you.",
 "text/SilphCo2F.asm|_SilphCo2FRocket1BattleText|0": "This floor's off",
 "text/SilphCo2F.asm|_SilphCo2FRocket1BattleText|1": "limits to brats!",
 "text/SilphCo2F.asm|_SilphCo2FRocket1EndBattleText|0": "Oof!",
 "text/SilphCo2F.asm|_SilphCo2FRocket1AfterBattleText|0": "See those glowing",
 "text/SilphCo2F.asm|_SilphCo2FRocket1AfterBattleText|1": "floor pads? Step",
 "text/SilphCo2F.asm|_SilphCo2FRocket1AfterBattleText|2": "on one to zip off",
 "text/SilphCo2F.asm|_SilphCo2FRocket1AfterBattleText|3": "somewhere else in",
 "text/SilphCo2F.asm|_SilphCo2FRocket1AfterBattleText|4": "the building!",
 "text/SilphCo2F.asm|_SilphCo2FRocket2BattleText|0": "Oi! Who let you",
 "text/SilphCo2F.asm|_SilphCo2FRocket2BattleText|1": "past the lobby?",
 "text/SilphCo2F.asm|_SilphCo2FRocket2EndBattleText|0": "Whoops!",
 "text/SilphCo2F.asm|_SilphCo2FRocket2AfterBattleText|0": "Soon VANTEC will",
 "text/SilphCo2F.asm|_SilphCo2FRocket2AfterBattleText|1": "just be a branch",
 "text/SilphCo2F.asm|_SilphCo2FRocket2AfterBattleText|2": "of GLOAM!"
