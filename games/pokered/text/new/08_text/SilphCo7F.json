{
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1HaveThisPokemonText|0": "Huh? No dark coat?",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1HaveThisPokemonText|1": "You're a rescuer?",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1HaveThisPokemonText|2": "Oh, bless you,",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1HaveThisPokemonText|3": "really!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1HaveThisPokemonText|4": "Please, take this",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1HaveThisPokemonText|5": "kith with you as",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1HaveThisPokemonText|6": "our thank-you.",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|0": "Meet SEAFERRY. A",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|1": "sharp mind, that.",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|2": "It's been stuck",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|3": "in a lab tank. It",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|4": "deserves open",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|5": "water and a pal.",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|6": "You seem like the",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|7": "TAMER it needs,",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|8": "I'd wager!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|9": "It glides over",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|10": "waves and can",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1LaprasDescriptionText|11": "carry a rider!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1IsOurPresidentOkText|0": "The GLOAM chief",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1IsOurPresidentOkText|1": "marched into the",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1IsOurPresidentOkText|2": "board room! Is",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1IsOurPresidentOkText|3": "the CEO safe?",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1SavedText|0": "We're free! You",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM1SavedText|1": "are a lifesaver!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2AfterTheMasterBallText|0": "GLOAM wanted our",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2AfterTheMasterBallText|1": "secret snare. No",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2AfterTheMasterBallText|2": "kith can escape",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2AfterTheMasterBallText|3": "from it at all!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2CancelledMasterBallText|0": "GLOAM's raid has",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2CancelledMasterBallText|1": "shut down the",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2CancelledMasterBallText|2": "SURE SNARE work",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM2CancelledMasterBallText|3": "for good.",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM3ItWouldBeBadText|0": "If GLOAM keeps",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM3ItWouldBeBadText|1": "VANTEC, kith all",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM3ItWouldBeBadText|2": "over the world",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM3ItWouldBeBadText|3": "will suffer!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM3YouChasedOffTeamRocketText|0": "No way! You ran",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM3YouChasedOffTeamRocketText|1": "GLOAM out solo?",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM3YouChasedOffTeamRocketText|2": "Incredible!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM4ItsReallyDangerousHereText|0": "Kid! Go back!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM4ItsReallyDangerousHereText|1": "Goons everywhere!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM4ItsReallyDangerousHereText|2": "You'll save me?",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM4ItsReallyDangerousHereText|3": "That's madness!",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM4SafeAtLastText|0": "It's over! I owe",
 "text/SilphCo7F.asm|_SilphCo7FSilphWorkerM4SafeAtLastText|1": "you big time!",
 "text/SilphCo7F.asm|_SilphCo7FRocket1BattleText|0": "Sniff sniff... I",
 "text/SilphCo7F.asm|_SilphCo7FRocket1BattleText|1": "smell a snoop!",
 "text/SilphCo7F.asm|_SilphCo7FRocket1EndBattleText|0": "Out",
 "text/SilphCo7F.asm|_SilphCo7FRocket1EndBattleText|1": "cold!",
 "text/SilphCo7F.asm|_SilphCo7FRocket1AfterBattleText|0": "Running in loops",
 "text/SilphCo7F.asm|_SilphCo7FRocket1AfterBattleText|1": "won't get you to",
 "text/SilphCo7F.asm|_SilphCo7FRocket1AfterBattleText|2": "the chief, kid!",
 "text/SilphCo7F.asm|_SilphCo7FScientistBattleText|0": "Hehehe!",
 "text/SilphCo7F.asm|_SilphCo7FScientistBattleText|1": "Fooled you! I'm",
 "text/SilphCo7F.asm|_SilphCo7FScientistBattleText|2": "no VANTEC nerd!",
 "text/SilphCo7F.asm|_SilphCo7FScientistEndBattleText|1": "beat!",
 "text/SilphCo7F.asm|_SilphCo7FScientistAfterBattleText|0": "So young, and yet",
 "text/SilphCo7F.asm|_SilphCo7FScientistAfterBattleText|1": "so sharp with",
 "text/SilphCo7F.asm|_SilphCo7FScientistAfterBattleText|2": "your team!",
 "text/SilphCo7F.asm|_SilphCo7FRocket2BattleText|0": "I'm number two of",
 "text/SilphCo7F.asm|_SilphCo7FRocket2BattleText|1": "the GLOAM QUARTET!",
 "text/SilphCo7F.asm|_SilphCo7FRocket2EndBattleText|0": "Argh!",
 "text/SilphCo7F.asm|_SilphCo7FRocket2EndBattleText|1": "Sorry, brothers!",
 "text/SilphCo7F.asm|_SilphCo7FRocket2AfterBattleText|0": "So what? My big",
 "text/SilphCo7F.asm|_SilphCo7FRocket2AfterBattleText|1": "brothers will",
 "text/SilphCo7F.asm|_SilphCo7FRocket2AfterBattleText|2": "get you back!",
 "text/SilphCo7F.asm|_SilphCo7FRocket3BattleText|0": "The kid prowling",
 "text/SilphCo7F.asm|_SilphCo7FRocket3BattleText|1": "the halls? You!",
 "text/SilphCo7F.asm|_SilphCo7FRocket3EndBattleText|0": "Okay!",
 "text/SilphCo7F.asm|_SilphCo7FRocket3EndBattleText|1": "You win!",
 "text/SilphCo7F.asm|_SilphCo7FRocket3AfterBattleText|0": "Scram while the",
 "text/SilphCo7F.asm|_SilphCo7FRocket3AfterBattleText|1": "chief's still in",
 "text/SilphCo7F.asm|_SilphCo7FRocket3AfterBattleText|2": "a good mood!",
 "text/SilphCo7F.asm|_SilphCo7FRivalText|0": "<RIVAL>: About",
 "text/SilphCo7F.asm|_SilphCo7FRivalText|1": "time, <PLAYER>!",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|0": "<RIVAL>: Ha! Knew",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|1": "it! Sit tight",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|2": "long enough and",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|3": "you show up!",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|4": "GLOAM goons kept",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|5": "you busy, huh?",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|6": "Not my problem,",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|7": "though!",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|8": "I spotted you in",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|9": "SPIREHOLM and",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|10": "had to check if",
 "text/SilphCo7F.asm|_SilphCo7FRivalWaitedHereText|11": "you'd improved!",
 "text/SilphCo7F.asm|_SilphCo7FRivalDefeatedText|0": "Hm!",
 "text/SilphCo7F.asm|_SilphCo7FRivalDefeatedText|1": "Guess you might",
 "text/SilphCo7F.asm|_SilphCo7FRivalDefeatedText|2": "handle their boss!",
 "text/SilphCo7F.asm|_SilphCo7FRivalVictoryText|0": "<RIVAL>: Hate to",
 "text/SilphCo7F.asm|_SilphCo7FRivalVictoryText|1": "say it...",
 "text/SilphCo7F.asm|_SilphCo7FRivalVictoryText|2": "You're still in",
 "text/SilphCo7F.asm|_SilphCo7FRivalVictoryText|3": "the kiddie pool,",
 "text/SilphCo7F.asm|_SilphCo7FRivalVictoryText|4": "pal. Stay there!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|0": "So, <PLAYER>!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|1": "My plan? Onward",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|2": "and upward!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|3": "My KITHLOG shows",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|4": "me which kith",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|5": "hit hardest and",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|6": "when they change.",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|7": "I've cracked it!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|8": "Next stop, the",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|9": "CROWN LEAGUE!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|10": "I'll knock its",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|11": "four elites off!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|12": "Then I'm the top",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|13": "TAMER of all,",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|14": "period!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|15": "<PLAYER>, hang in",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|16": "there, okay?",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|17": "Don't panic!",
 "text/SilphCo7F.asm|_SilphCo7FRivalGoodLuckToYouText|18": "Catch you later!"
}