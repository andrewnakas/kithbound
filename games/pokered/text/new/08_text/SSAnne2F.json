{
 "text/SSAnne2F.asm|_SSAnne2FWaiterText|0": "Welcome aboard the",
 "text/SSAnne2F.asm|_SSAnne2FWaiterText|1": "S.S.WREN, a ship",
 "text/SSAnne2F.asm|_SSAnne2FWaiterText|2": "built for TAMERS.",
 "text/SSAnne2F.asm|_SSAnne2FWaiterText|3": "Each harbor we",
 "text/SSAnne2F.asm|_SSAnne2FWaiterText|4": "dock in, the ball-",
 "text/SSAnne2F.asm|_SSAnne2FWaiterText|5": "room fills up!",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|0": "<RIVAL>: Ahoy,",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|2": "Of all the decks",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|3": "on all the boats!",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|4": "Who let you up",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|5": "the gangway, huh?",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|6": "Fine, tell me. How",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|7": "full is that log?",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|8": "Mine's packed. I",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|9": "have 40 entries!",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|10": "New kith hide in",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|11": "every hedge.",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|12": "Go roll around in",
 "text/SSAnne2F.asm|_SSAnne2FRivalText|13": "the tall weeds!",
 "text/SSAnne2F.asm|_SSAnne2FRivalDefeatedText|0": "Tch!",
 "text/SSAnne2F.asm|_SSAnne2FRivalDefeatedText|1": "Okay, your team",
 "text/SSAnne2F.asm|_SSAnne2FRivalDefeatedText|2": "is getting tough,",
 "text/SSAnne2F.asm|_SSAnne2FRivalDefeatedText|3": "I'll admit that.",
 "text/SSAnne2F.asm|_SSAnne2FRivalVictoryText|0": "<PLAYER>! Did the",
 "text/SSAnne2F.asm|_SSAnne2FRivalVictoryText|1": "waves get to you?",
 "text/SSAnne2F.asm|_SSAnne2FRivalVictoryText|2": "Find your legs",
 "text/SSAnne2F.asm|_SSAnne2FRivalVictoryText|3": "and try again!",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|0": "<RIVAL>: Word was",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|1": "some CHOP expert",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|2": "sails on this tub.",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|3": "Just a green-faced",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|4": "geezer in bed!",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|5": "Still, CHOP is a",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|6": "handy skill.",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|7": "Go see him. Bye,",
 "text/SSAnne2F.asm|_SSAnne2FRivalCutMasterText|8": "dawdler!"
}