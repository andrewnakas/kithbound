{
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|0": "CEO: You freed",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|1": "VANTEC from",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|2": "GLOAM's grip!",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|3": "This day goes",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|4": "down in company",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|5": "history, and so",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|6": "does your name!",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|7": "A reward is the",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|8": "least we can do.",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|9": "My fortune is",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|10": "large. Name it!",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|11": "I can afford it.",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|12": "Ah! I know. Take",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentText|13": "this!",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentReceivedMasterBallText|0": "<PLAYER> earned a",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|0": "CEO: No shop on",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|1": "earth sells one",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|2": "of those!",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|3": "It's the only",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|4": "SURE SNARE we",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|5": "ever finished.",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|6": "Whatever kith you",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|7": "throw it at, it",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|8": "holds. Always.",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|9": "Keep it hush-",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|10": "hush, though.",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentMasterBallDescriptionText|11": "Please!",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentNoRoomText|0": "Your bag's too",
 "text/SilphCo11F.asm|_SilphCo11FSilphPresidentNoRoomText|1": "full for it.",
 "text/SilphCo11F.asm|_SilphCo11FBeautyText|0": "AIDE: You came",
 "text/SilphCo11F.asm|_SilphCo11FBeautyText|1": "up all those",
 "text/SilphCo11F.asm|_SilphCo11FBeautyText|2": "floors for us!",
 "text/SilphCo11F.asm|_SilphCo11FBeautyText|3": "Such bravery.",
 "text/SilphCo11F.asm|_SilphCo11FBeautyText|4": "Truly!",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|0": "Well, <PLAYER>.",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|1": "You again.",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|2": "Our CEO and I",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|3": "were just about",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|4": "to sign a little",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|5": "deal.",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|6": "Children have no",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|7": "seat at this",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|8": "table...",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|9": "Leave, or learn",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniText|10": "what pain means!",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniILostAgainText|0": "Grr!!",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniILostAgainText|1": "Beaten twice!?",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|0": "Curse you, brat!",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|1": "VANTEC was all",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|2": "but ours!",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|3": "Yet GLOAM stands.",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|4": "It always will!",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|5": "<PLAYER>! Kith",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|6": "are tools, and",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|7": "GLOAM will own",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|8": "them all, mark me!",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|9": "I'll leave. For",
 "text/SilphCo11F.asm|_SilphCo11FGiovanniYouRuinedOurPlansText|10": "now.",
 "text/SilphCo11F.asm|_SilphCo11FRocket1BattleText|0": "Freeze, kid!",
 "text/SilphCo11F.asm|_SilphCo11FRocket1BattleText|1": "Not one step!",
 "text/SilphCo11F.asm|_SilphCo11FRocket1EndBattleText|0": "Mercy...",
 "text/SilphCo11F.asm|_SilphCo11FRocket1EndBattleText|1": "I beg you!",
 "text/SilphCo11F.asm|_SilphCo11FRocket1AfterBattleText|0": "Oh, you're after",
 "text/SilphCo11F.asm|_SilphCo11FRocket1AfterBattleText|1": "the chief, huh?",
 "text/SilphCo11F.asm|_SilphCo11FRocket2BattleText|0": "Hold it! Is your",
 "text/SilphCo11F.asm|_SilphCo11FRocket2BattleText|1": "name on the",
 "text/SilphCo11F.asm|_SilphCo11FRocket2BattleText|2": "chief's calendar?",
 "text/SilphCo11F.asm|_SilphCo11FRocket2EndBattleText|0": "Ugh!",
 "text/SilphCo11F.asm|_SilphCo11FRocket2EndBattleText|1": "Wrecked!",
 "text/SilphCo11F.asm|_SilphCo11FRocket2AfterBattleText|0": "Careful. The",
 "text/SilphCo11F.asm|_SilphCo11FRocket2AfterBattleText|1": "chief raises real",
 "text/SilphCo11F.asm|_SilphCo11FRocket2AfterBattleText|2": "bruisers!",
 "text/SilphCo11F.asm|_SilphCo11FPorygonText|0": "Kith data scrolls",
 "text/SilphCo11F.asm|_SilphCo11FPorygonText|1": "across the screen."
}