{
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|0": "Oho! At last!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|1": "Nobody else ever",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|2": "found their way",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|3": "to this hut!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|4": "I feared our big",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|5": "contest would end",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|6": "with nobody ever",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|7": "claiming it.",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|8": "Congrats, champ!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruYouHaveWonText|9": "It's all yours!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruReceivedHM03Text|0": "<PLAYER> won",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|0": "KS03: WAVE RIDE!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|1": "Kith who learn",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|2": "it carry you over",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|3": "lakes and seas!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|4": "Key scrolls never",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|5": "wear out, either.",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|6": "Teach it again",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|7": "and again!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|8": "Lucky you! Such",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|9": "a prize, all for",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03ExplanationText|10": "one sharp eye!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03NoRoomText|0": "Your bag can't",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03NoRoomText|1": "hold the prize!",
 "text/SafariZoneSecretHouse.asm|_SafariZoneSecretHouseFishingGuruHM03NoRoomText|2": "Make some space."
}