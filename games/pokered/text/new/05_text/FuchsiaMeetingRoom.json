{
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker1|0": "We call the boss",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker1|1": "DAWDLUG behind his",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker1|2": "back. Both of 'em",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker1|3": "stare into space!",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker2|0": "Still, old DAWDLUG",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker2|1": "knows tons about",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker2|2": "KITH!",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker2|3": "He keeps fossils",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker2|4": "of long-gone KITH",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker2|5": "in his house!",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker3|0": "DAWDLUG dropped by",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker3|1": "but mumbled so I",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker3|2": "caught nothing.",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker3|3": "Is he missing his",
"text/FuchsiaMeetingRoom.asm|_FuchsiaMeetingRoomSafariZoneWorker3|4": "teeth or what?"
}