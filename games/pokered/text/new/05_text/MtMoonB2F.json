"text/MtMoonB2F.asm|_MtMoonB2FRocket1EndBattleText|0": "Grr!",
"text/MtMoonB2F.asm|_MtMoonB2FRocket1EndBattleText|1": "That burns me!",
"text/MtMoonB2F.asm|_MtMoonB2FRocket1AfterBattleText|0": "You're on GLOAM's",
"text/MtMoonB2F.asm|_MtMoonB2FRocket1AfterBattleText|1": "list now, brat!",
"text/MtMoonB2F.asm|_MtMoonB2FRocket1AfterBattleText|2": "Watch yourself!",
