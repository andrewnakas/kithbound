"text/MtMoonB2F.asm|_MtMoonB2FRocket2EndBattleText|0": "Blast!",
"text/MtMoonB2F.asm|_MtMoonB2FRocket2EndBattleText|1": "Botched it!",
"text/MtMoonB2F.asm|_MtMoonB2FRocket2AfterBattleText|0": "Argh! The rest of",
