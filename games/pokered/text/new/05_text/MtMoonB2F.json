"text/MtMoonB2F.asm|_MtMoonB2fSuperNerdEachTakeOneText|0": "One for you, one",
"text/MtMoonB2F.asm|_MtMoonB2fSuperNerdEachTakeOneText|1": "for me!",
"text/MtMoonB2F.asm|_MtMoonB2fSuperNerdEachTakeOneText|2": "Fair is fair!",
"text/MtMoonB2F.asm|_MtMoonB2FSuperNerdTheresAPokemonLabText|0": "Way out on",
