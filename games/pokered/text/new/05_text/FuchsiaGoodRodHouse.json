{
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruText|0": "My kid brother",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruText|1": "fishes in PORTSALT",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruText|2": "but I'm better!",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruText|3": "Fishing is my",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruText|4": "whole life!",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruText|5": "Do you fish too,",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruText|6": "friend?",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruReceivedGoodRodText|0": "Splendid answer!",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruReceivedGoodRodText|1": "A kindred spirit!",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruReceivedGoodRodText|2": "Here, this rod",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruReceivedGoodRodText|3": "is yours now!",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruReceivedGoodRodText|4": "<PLAYER> got",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruThatsSoDisappointingText|0": "Oh. Well then...",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruThatsSoDisappointingText|1": "More fish for me.",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruHowAreTheFishText|0": "Ah, it's you,",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruHowAreTheFishText|2": "Landing any big",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruHowAreTheFishText|3": "ones lately?",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruNoRoomText|0": "Hm!",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruNoRoomText|1": "Your bag's too",
"text/FuchsiaGoodRodHouse.asm|_FuchsiaGoodRodHouseFishingGuruNoRoomText|2": "full for this rod!"
}