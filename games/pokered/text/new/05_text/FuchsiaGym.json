{
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|0": "HEMLOCK: Hush...",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|1": "You found me past",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|2": "my walls. Few do.",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|3": "Clever little one.",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|4": "But cleverness",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|5": "fades when venom",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|6": "creeps into the",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|7": "blood.",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|8": "Let toxin and",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|9": "slumber teach you",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|10": "what patience",
"text/FuchsiaGym.asm|_FuchsiaGymKogaBeforeBattleText|11": "truly means!",
"text/FuchsiaGym.asm|_FuchsiaGymKogaReceivedSoulBadgeText|0": "Hmm.",
"text/FuchsiaGym.asm|_FuchsiaGymKogaReceivedSoulBadgeText|1": "Your steps were",
"text/FuchsiaGym.asm|_FuchsiaGymKogaReceivedSoulBadgeText|2": "surer than mine.",
"text/FuchsiaGym.asm|_FuchsiaGymKogaReceivedSoulBadgeText|3": "Accept this,",
"text/FuchsiaGym.asm|_FuchsiaGymKogaReceivedSoulBadgeText|4": "the HUSH BADGE."
}