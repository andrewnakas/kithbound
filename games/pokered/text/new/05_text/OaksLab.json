{
"text/OaksLab.asm|_OaksLabRivalGrampsIsntAroundText|0": "<RIVAL>: Hey,",
"text/OaksLab.asm|_OaksLabRivalGrampsIsntAroundText|1": "<PLAYER>. Grandpa",
"text/OaksLab.asm|_OaksLabRivalGrampsIsntAroundText|2": "wandered off!",
"text/OaksLab.asm|_OaksLabRivalGoAheadAndChooseText|0": "<RIVAL>: Pfft. You",
"text/OaksLab.asm|_OaksLabRivalGoAheadAndChooseText|1": "pick first. I'm",
"text/OaksLab.asm|_OaksLabRivalGoAheadAndChooseText|2": "not desperate.",
"text/OaksLab.asm|_OaksLabRivalGoAheadAndChooseText|3": "Hurry up,",
"text/OaksLab.asm|_OaksLabRivalGoAheadAndChooseText|4": "<PLAYER>!",
"text/OaksLab.asm|_OaksLabRivalMyPokemonLooksStrongerText|0": "<RIVAL>: Ha! Mine",
"text/OaksLab.asm|_OaksLabRivalMyPokemonLooksStrongerText|1": "is way tougher",
"text/OaksLab.asm|_OaksLabRivalMyPokemonLooksStrongerText|2": "than yours.",
"text/OaksLab.asm|_OaksLabThoseArePokeBallsText|0": "Three SNAREs sit",
"text/OaksLab.asm|_OaksLabThoseArePokeBallsText|1": "on the bench, each",
"text/OaksLab.asm|_OaksLabThoseArePokeBallsText|2": "holding a KITH.",
"text/OaksLab.asm|_OaksLabYouWantCharmanderText|0": "The ember KITH,",
"text/OaksLab.asm|_OaksLabYouWantCharmanderText|1": "KINDLET. Take",
"text/OaksLab.asm|_OaksLabYouWantCharmanderText|2": "this one?",
"text/OaksLab.asm|_OaksLabYouWantSquirtleText|0": "The tide KITH,",
"text/OaksLab.asm|_OaksLabYouWantSquirtleText|1": "DRIPLET. Take",
"text/OaksLab.asm|_OaksLabYouWantSquirtleText|2": "this one?",
"text/OaksLab.asm|_OaksLabYouWantBulbasaurText|0": "The leaf KITH,",
"text/OaksLab.asm|_OaksLabYouWantBulbasaurText|1": "MOSSPUP. Take",
"text/OaksLab.asm|_OaksLabYouWantBulbasaurText|2": "this one?",
"text/OaksLab.asm|_OaksLabMonEnergeticText|0": "It's wriggling",
"text/OaksLab.asm|_OaksLabMonEnergeticText|1": "with excitement!",
"text/OaksLab.asm|_OaksLabReceivedMonText|0": "<PLAYER> got",
"text/OaksLab.asm|_OaksLabLastMonText|0": "The last SNARE on",
"text/OaksLab.asm|_OaksLabLastMonText|1": "the bench.",
"text/OaksLab.asm|_OaksLabOak1WhichPokemonDoYouWantText|0": "BRAMBLE: Go on,",
"text/OaksLab.asm|_OaksLabOak1WhichPokemonDoYouWantText|1": "<PLAYER>, pick",
"text/OaksLab.asm|_OaksLabOak1WhichPokemonDoYouWantText|2": "a partner!",
"text/OaksLab.asm|_OaksLabOak1YourPokemonCanFightText|0": "BRAMBLE: Out in",
"text/OaksLab.asm|_OaksLabOak1YourPokemonCanFightText|1": "the tall grass,",
"text/OaksLab.asm|_OaksLabOak1YourPokemonCanFightText|2": "your partner will",
"text/OaksLab.asm|_OaksLabOak1YourPokemonCanFightText|3": "defend you!",
"text/OaksLab.asm|_OaksLabOak1RaiseYourYoungPokemonText|0": "BRAMBLE: <PLAYER>,",
"text/OaksLab.asm|_OaksLabOak1RaiseYourYoungPokemonText|1": "battles help your",
"text/OaksLab.asm|_OaksLabOak1RaiseYourYoungPokemonText|2": "KITH grow. Get",
"text/OaksLab.asm|_OaksLabOak1RaiseYourYoungPokemonText|3": "out there!",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|0": "BRAMBLE: <PLAYER>!",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|1": "And your partner?",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|2": "Doing well?",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|3": "Ha! Look at it",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|4": "beam at you.",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|5": "You've a real",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|6": "knack for this,",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|7": "young TAMER!",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|8": "Oh? A package",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|9": "for me?",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|10": "<PLAYER> handed",
"text/OaksLab.asm|_OaksLabOak1DeliverParcelText|11": "over the PARCEL.@",
"text/OaksLab.asm|_OaksLabOak1ParcelThanksText|0": "At last! My new",
"text/OaksLab.asm|_OaksLabOak1ParcelThanksText|1": "SNARE prototype.",
"text/OaksLab.asm|_OaksLabOak1ParcelThanksText|2": "Splendid.",
"text/OaksLab.asm|_OaksLabOak1ParcelThanksText|3": "Many thanks!",
"text/OaksLab.asm|_OaksLabOak1PokemonAroundTheWorldText|0": "A whole world of",
"text/OaksLab.asm|_OaksLabOak1PokemonAroundTheWorldText|1": "KITH is out there,",
"text/OaksLab.asm|_OaksLabOak1PokemonAroundTheWorldText|2": "<PLAYER>!",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|0": "BRAMBLE: Spotting",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|1": "a KITH only fills",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|2": "half a page in",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|3": "the KITHLOG.",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|4": "Catch it to get",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|5": "the rest! Here,",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|6": "take some SNAREs",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|7": "for the road.",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|8": "<PLAYER> got five",
"text/OaksLab.asm|_OaksLabOak1ReceivedPokeballsText|9": "SNAREs!@",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|0": "Weaken a wild",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|1": "KITH first,",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|2": "then make your",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|3": "move. Toss a",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|4": "SNARE at it and",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|5": "hope it holds!",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|6": "Some will break",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|7": "free.",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|8": "A KITH at full",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|9": "strength fights",
"text/OaksLab.asm|_OaksLabGivePokeballsExplanationText|10": "the SNARE hardest.",
"text/OaksLab.asm|_OaksLabOak1ComeSeeMeSometimesText|0": "BRAMBLE: Drop in",
"text/OaksLab.asm|_OaksLabOak1ComeSeeMeSometimesText|1": "now and then.",
"text/OaksLab.asm|_OaksLabOak1ComeSeeMeSometimesText|2": "I'd love to see",
"text/OaksLab.asm|_OaksLabOak1ComeSeeMeSometimesText|3": "how your KITHLOG",
"text/OaksLab.asm|_OaksLabOak1ComeSeeMeSometimesText|4": "is filling up.",
"text/OaksLab.asm|_OaksLabOak1HowIsYourPokedexComingText|0": "BRAMBLE: Welcome",
"text/OaksLab.asm|_OaksLabOak1HowIsYourPokedexComingText|1": "back! Let's have",
"text/OaksLab.asm|_OaksLabOak1HowIsYourPokedexComingText|2": "a peek at your",
"text/OaksLab.asm|_OaksLabOak1HowIsYourPokedexComingText|3": "KITHLOG, shall",
"text/OaksLab.asm|_OaksLabOak1HowIsYourPokedexComingText|4": "we?",
"text/OaksLab.asm|_OaksLabPokedexText|0": "A thick catalog",
"text/OaksLab.asm|_OaksLabPokedexText|1": "of KITH... with",
"text/OaksLab.asm|_OaksLabPokedexText|2": "empty pages!",
"text/OaksLab.asm|_OaksLabGirlText|0": "PROF.BRAMBLE knows",
"text/OaksLab.asm|_OaksLabGirlText|1": "more about KITH",
"text/OaksLab.asm|_OaksLabGirlText|2": "than anyone!",
"text/OaksLab.asm|_OaksLabGirlText|3": "TAMERs everywhere",
"text/OaksLab.asm|_OaksLabGirlText|4": "write him letters",
"text/OaksLab.asm|_OaksLabGirlText|5": "for advice!",
"text/OaksLab.asm|_OaksLabRivalFedUpWithWaitingText|0": "<RIVAL>: Grandpa!",
"text/OaksLab.asm|_OaksLabRivalFedUpWithWaitingText|1": "How long do I",
"text/OaksLab.asm|_OaksLabRivalFedUpWithWaitingText|2": "have to wait?",
"text/OaksLab.asm|_OaksLabOakChooseMonText|0": "BRAMBLE: <RIVAL>?",
"text/OaksLab.asm|_OaksLabOakChooseMonText|1": "Ah... hmm.",
"text/OaksLab.asm|_OaksLabOakChooseMonText|2": "Yes, yes! I asked",
"text/OaksLab.asm|_OaksLabOakChooseMonText|3": "you to come by.",
"text/OaksLab.asm|_OaksLabOakChooseMonText|4": "One moment!",
"text/OaksLab.asm|_OaksLabOakChooseMonText|5": "<PLAYER>, come!",
"text/OaksLab.asm|_OaksLabOakChooseMonText|6": "Three young KITH",
"text/OaksLab.asm|_OaksLabOakChooseMonText|7": "wait on my bench.",
"text/OaksLab.asm|_OaksLabOakChooseMonText|8": "Ho ho!",
"text/OaksLab.asm|_OaksLabOakChooseMonText|9": "Each one rests in",
"text/OaksLab.asm|_OaksLabOakChooseMonText|10": "its own SNARE.",
"text/OaksLab.asm|_OaksLabOakChooseMonText|11": "Long ago, I roamed",
"text/OaksLab.asm|_OaksLabOakChooseMonText|12": "the wilds as a",
"text/OaksLab.asm|_OaksLabOakChooseMonText|13": "TAMER myself.",
"text/OaksLab.asm|_OaksLabOakChooseMonText|14": "These three are",
"text/OaksLab.asm|_OaksLabOakChooseMonText|15": "all I keep now,",
"text/OaksLab.asm|_OaksLabOakChooseMonText|16": "but one can be",
"text/OaksLab.asm|_OaksLabOakChooseMonText|17": "yours. Pick!",
"text/OaksLab.asm|_OaksLabRivalWhatAboutMeText|0": "<RIVAL>: Wait!",
"text/OaksLab.asm|_OaksLabRivalWhatAboutMeText|1": "Grandpa! Don't",
"text/OaksLab.asm|_OaksLabRivalWhatAboutMeText|2": "forget me!",
"text/OaksLab.asm|_OaksLabOakBePatientText|0": "BRAMBLE: Easy now!",
"text/OaksLab.asm|_OaksLabOakBePatientText|1": "<RIVAL>, you'll",
"text/OaksLab.asm|_OaksLabOakBePatientText|2": "get one too!",
"text/OaksLab.asm|_OaksLabOakDontGoAwayYetText|0": "BRAMBLE: Wait! Not",
"text/OaksLab.asm|_OaksLabOakDontGoAwayYetText|1": "so fast!",
"text/OaksLab.asm|_OaksLabRivalIllTakeThisOneText|0": "<RIVAL>: Then this",
"text/OaksLab.asm|_OaksLabRivalIllTakeThisOneText|1": "one's mine!",
"text/OaksLab.asm|_OaksLabRivalReceivedMonText|0": "<RIVAL> got",
"text/OaksLab.asm|_OaksLabRivalIllTakeYouOnText|0": "<RIVAL>: Hold up,",
"text/OaksLab.asm|_OaksLabRivalIllTakeYouOnText|2": "Let's see what",
"text/OaksLab.asm|_OaksLabRivalIllTakeYouOnText|3": "these can do!",
"text/OaksLab.asm|_OaksLabRivalIllTakeYouOnText|4": "Battle me, right",
"text/OaksLab.asm|_OaksLabRivalIllTakeYouOnText|5": "here!",
"text/OaksLab.asm|_OaksLabRivalIPickedTheWrongPokemonText|0": "NO WAY!",
"text/OaksLab.asm|_OaksLabRivalIPickedTheWrongPokemonText|1": "That's rigged!",
"text/OaksLab.asm|_OaksLabRivalIPickedTheWrongPokemonText|2": "I should've taken",
"text/OaksLab.asm|_OaksLabRivalIPickedTheWrongPokemonText|3": "the other one!",
"text/OaksLab.asm|_OaksLabRivalAmIGreatOrWhatText|0": "<RIVAL>: Ha! Who's",
"text/OaksLab.asm|_OaksLabRivalAmIGreatOrWhatText|1": "the best? Me!",
"text/OaksLab.asm|_OaksLabRivalSmellYouLaterText|0": "<RIVAL>: Fine!",
"text/OaksLab.asm|_OaksLabRivalSmellYouLaterText|1": "I'll train mine",
"text/OaksLab.asm|_OaksLabRivalSmellYouLaterText|2": "until it's a",
"text/OaksLab.asm|_OaksLabRivalSmellYouLaterText|3": "monster!",
"text/OaksLab.asm|_OaksLabRivalSmellYouLaterText|4": "<PLAYER>! Grandpa!",
"text/OaksLab.asm|_OaksLabRivalSmellYouLaterText|5": "Catch you never!",
"text/OaksLab.asm|_OaksLabRivalGrampsText|0": "<RIVAL>: Grandpa!",
"text/OaksLab.asm|_OaksLabRivalWhatDidYouCallMeForText|0": "<RIVAL>: So why'd",
"text/OaksLab.asm|_OaksLabRivalWhatDidYouCallMeForText|1": "you call me here?",
"text/OaksLab.asm|_OaksLabOakIHaveARequestText|0": "BRAMBLE: Ah, yes!",
"text/OaksLab.asm|_OaksLabOakIHaveARequestText|1": "I need a favor",
"text/OaksLab.asm|_OaksLabOakIHaveARequestText|2": "from you both.",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|0": "See those gadgets",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|1": "on my desk? I",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|2": "call them KITHLOG!",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|3": "They take notes",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|4": "by themselves on",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|5": "every KITH you",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|6": "meet or catch!",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|7": "A pocket field",
"text/OaksLab.asm|_OaksLabOakMyInventionPokedexText|8": "journal!",
"text/OaksLab.asm|_OaksLabOakGotPokedexText|0": "BRAMBLE: <PLAYER>,",
"text/OaksLab.asm|_OaksLabOakGotPokedexText|1": "<RIVAL>! One for",
"text/OaksLab.asm|_OaksLabOakGotPokedexText|2": "each of you!",
"text/OaksLab.asm|_OaksLabOakGotPokedexText|3": "<PLAYER> got a",
"text/OaksLab.asm|_OaksLabOakGotPokedexText|4": "KITHLOG!@",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|0": "For forty years",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|1": "I've tried to log",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|2": "every KITH alive.",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|3": "Every last one.",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|4": "A lifelong goal!",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|5": "But my knees say",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|6": "no more trips.",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|7": "So I pass the",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|8": "torch to you",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|9": "two!",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|10": "Off you go,",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|11": "both of you!",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|12": "Fill those pages",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|13": "and make KITH",
"text/OaksLab.asm|_OaksLabOakThatWasMyDreamText|14": "history!",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|0": "<RIVAL>: Easy!",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|1": "Grandpa, I've got",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|2": "this covered!",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|3": "<PLAYER>, honestly,",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|4": "you'll just slow",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|5": "me down!",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|6": "Oh! I'll grab an",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|7": "AREA CHART from",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|8": "my sister!",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|9": "And I'll make sure",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|10": "she won't give you",
"text/OaksLab.asm|_OaksLabRivalLeaveItAllToMeText|11": "one! Ha!",
"text/OaksLab.asm|_OaksLabScientistText|0": "I'm PROF.BRAMBLE's",
"text/OaksLab.asm|_OaksLabScientistText|1": "research helper."
}