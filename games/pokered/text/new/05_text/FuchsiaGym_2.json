{
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaPostBattleAdviceText|0": "BLIGHT is a slow",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaPostBattleAdviceText|1": "poison. Each turn",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaPostBattleAdviceText|2": "it bites deeper",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaPostBattleAdviceText|3": "than the last,",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaPostBattleAdviceText|4": "until foes fall.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaPostBattleAdviceText|5": "Patience wins",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaPostBattleAdviceText|6": "the war.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|0": "With the HUSH",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|1": "BADGE, your KITH",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|2": "gain sturdier",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|3": "DEFENSE in every",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|4": "fight.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|5": "You may also use",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|6": "WAVE RIDE beyond",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|7": "the battlefield.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|8": "One more thing.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaSoulBadgeInfoText|9": "Here.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaReceivedTM06Text|0": "<PLAYER> got",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaTM06ExplanationText|0": "That SC holds",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaTM06ExplanationText|1": "BLIGHT.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaTM06ExplanationText|2": "My clan guarded",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaTM06ExplanationText|3": "it for twenty",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaTM06ExplanationText|4": "generations.",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaTM06NoRoomText|0": "Your pack is too",
"text/FuchsiaGym_2.asm|_FuchsiaGymKogaTM06NoRoomText|1": "full. Return.",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1BattleText|0": "Muscle alone won't",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1BattleText|1": "win KITH bouts!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1BattleText|2": "Cunning will!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1BattleText|3": "Plan beats might!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1BattleText|4": "Watch my plan",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1BattleText|5": "crush your raw",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1BattleText|6": "power!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1EndBattleText|0": "No way!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1EndBattleText|1": "Brilliant play!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1AfterBattleText|0": "Brawn plus wits,",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1AfterBattleText|1": "huh? That's a",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker1AfterBattleText|2": "deadly combo.",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2BattleText|0": "I signed up here",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2BattleText|1": "to learn stealth",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2BattleText|2": "from the best!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2EndBattleText|0": "Out",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2EndBattleText|1": "like a candle!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2AfterBattleText|0": "Someday HEMLOCK",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2AfterBattleText|1": "will teach me the",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2AfterBattleText|2": "vanishing step.",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker2AfterBattleText|3": "Someday...",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3BattleText|0": "Try to see through",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3BattleText|1": "my secret moves!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3BattleText|2": "Bet you can't!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3EndBattleText|0": "Huh?",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3EndBattleText|1": "Saw right through!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3AfterBattleText|0": "Venom and dozing",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3AfterBattleText|1": "stick around even",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3AfterBattleText|2": "when the fight's",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker3AfterBattleText|3": "over. Sneaky!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4BattleText|0": "Halt!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4BattleText|1": "Bumping into walls",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4BattleText|2": "you can't see?",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4BattleText|3": "Hee hee!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4EndBattleText|0": "Whoa!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4EndBattleText|1": "Sharp kid!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4AfterBattleText|0": "Fine, you earned",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4AfterBattleText|1": "a tip.",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4AfterBattleText|2": "Some of the clear",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4AfterBattleText|3": "walls have spaces.",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker4AfterBattleText|4": "Feel your way!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5BattleText|0": "HEMLOCK teaches me",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5BattleText|1": "stealth arts too!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5BattleText|2": "Shadow folk have",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5BattleText|3": "always worked with",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5BattleText|4": "wild beasts!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5BattleText|5": "Grr!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5EndBattleText|0": "Yowl!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5AfterBattleText|0": "Plenty left to",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker5AfterBattleText|1": "master, it seems.",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6BattleText|0": "HEMLOCK's family",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6BattleText|1": "has been shadows",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6BattleText|2": "for ages!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6BattleText|3": "And what's your",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6BattleText|4": "family tree?",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6EndBattleText|0": "Tripped",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6EndBattleText|1": "on my own cape!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6AfterBattleText|0": "Every flame casts",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6AfterBattleText|1": "a shade behind",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6AfterBattleText|2": "it!",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6AfterBattleText|3": "Flame or shade,",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6AfterBattleText|4": "which are you",
"text/FuchsiaGym_2.asm|_FuchsiaGymRocker6AfterBattleText|5": "made of?",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|0": "Hey, future champ!",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|1": "Listen up!",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|2": "This GYM is full",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|3": "of see-through",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|4": "barriers!",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|5": "HEMLOCK seems near",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|6": "but you can't walk",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|7": "straight to him!",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|8": "Hunt for openings",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|9": "in the walls to",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideChampInMakingText|10": "get through!",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideBeatKogaText|0": "Shadow fighters",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideBeatKogaText|1": "still give me",
"text/FuchsiaGym_2.asm|_FuchsiaGymGymGuideBeatKogaText|2": "chills. Wow!"
}