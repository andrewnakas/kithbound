{
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|0": "<PLAYER>: Hey! Are",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|1": "you a KITH fan?",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|2": "<PLAYER>: No, I'm",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|3": "asking YOU.",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|4": "<PLAYER>: Stop it!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|5": "That's my line!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|6": "MIMI: Hee hee!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|7": "Copy you? Me?",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|8": "Echoing is what",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatDoYouLikePokemonText|9": "I do best!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31PreReceiveText|0": "No way!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31PreReceiveText|1": "A DECOY DOLL!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31PreReceiveText|2": "It's mine?",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31PreReceiveText|3": "Yay, yay!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31PreReceiveText|4": "Here, a swap for",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31PreReceiveText|5": "you!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatReceivedTM31Text|0": "<PLAYER> got",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation1Text|0": "That SC teaches",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation1Text|1": "ECHO. I love it!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation1Text|2": "Teach it to a KITH",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation1Text|3": "you adore!@",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|0": "<PLAYER>: Hey MIMI,",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|1": "thanks for the SC!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|2": "<PLAYER>: What?",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|3": "<PLAYER>: You're",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|4": "copying me again,",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|5": "aren't you?",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|6": "MIMI: Mm-hmm!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31Explanation2Text|7": "Best game ever!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31NoRoomText|0": "You'd turn down",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FCopycatTM31NoRoomText|1": "my gift?@",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FDoduoText|0": "BIRUNNER: Kwee!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FDoduoText|1": "PRETTY BIRD! WHO'S",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FDoduoText|2": "A PRETTY BIRD? ME!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FDoduoText|3": "ME! ME! BOTH OF",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FDoduoText|4": "MY HEADS!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FRareDollText|0": "Wow, a super rare",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FRareDollText|1": "KITH! ...Wait.",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FRareDollText|2": "It's stuffed!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FSNESText|0": "A cartridge game",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FSNESText|1": "about a knight who",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FSNESText|2": "fights with a mop!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FPCMySecretsText|1": "Private Diary!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FPCMySecretsText|2": "Talent: Copying!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FPCMySecretsText|3": "Loves: Stuffed",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FPCMySecretsText|4": "toys!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FPCMySecretsText|5": "Best KITH:",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FPCMySecretsText|6": "MOONDROP!",
"text/CopycatsHouse2F.asm|_CopycatsHouse2FPCCantSeeText|0": "It's facing away!"
}