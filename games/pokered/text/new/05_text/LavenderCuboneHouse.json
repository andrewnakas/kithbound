"text/LavenderCuboneHouse.asm|_LavenderCuboneHouseBrunetteGirlGhostIsGoneText|2": "gone quiet!",
"text/LavenderCuboneHouse.asm|_LavenderCuboneHouseBrunetteGirlGhostIsGoneText|3": "Somebody gave it",
