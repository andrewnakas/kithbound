{
"text/MtMoon1F.asm|_MtMoon1FHikerBattleText|0": "GAH! Don't creep",
"text/MtMoon1F.asm|_MtMoon1FHikerBattleText|1": "up like that! Oh,",
"text/MtMoon1F.asm|_MtMoon1FHikerBattleText|2": "a youngster!",
"text/MtMoon1F.asm|_MtMoon1FHikerEndBattleText|0": "Gah!",
"text/MtMoon1F.asm|_MtMoon1FHikerEndBattleText|1": "Spooked twice!",
"text/MtMoon1F.asm|_MtMoon1FHikerAfterBattleText|0": "This cave's no",
"text/MtMoon1F.asm|_MtMoon1FHikerAfterBattleText|1": "playground for",
"text/MtMoon1F.asm|_MtMoon1FHikerAfterBattleText|2": "kids!",
"text/MtMoon1F.asm|_MtMoon1FYoungster1BattleText|0": "You exploring",
"text/MtMoon1F.asm|_MtMoon1FYoungster1BattleText|1": "the caves too?",
"text/MtMoon1F.asm|_MtMoon1FYoungster1EndBattleText|0": "Aw,",
"text/MtMoon1F.asm|_MtMoon1FYoungster1EndBattleText|1": "rats!",
"text/MtMoon1F.asm|_MtMoon1FYoungster1AfterBattleText|0": "I only came to",
"text/MtMoon1F.asm|_MtMoon1FYoungster1AfterBattleText|1": "look cool. It's",
"text/MtMoon1F.asm|_MtMoon1FYoungster1AfterBattleText|2": "not working.",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF1BattleText|0": "Wow! This cave",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF1BattleText|1": "goes on forever!",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF1BattleText|2": "So many tunnels!",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF1EndBattleText|0": "Eek!",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF1EndBattleText|1": "Out of luck!",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF1AfterBattleText|0": "Which way leads",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF1AfterBattleText|1": "outside?",
"text/MtMoon1F.asm|_MtMoon1FSuperNerdBattleText|0": "Yikes! Announce",
"text/MtMoon1F.asm|_MtMoon1FSuperNerdBattleText|1": "yourself first!",
"text/MtMoon1F.asm|_MtMoon1FSuperNerdEndBattleText|0": "My",
"text/MtMoon1F.asm|_MtMoon1FSuperNerdEndBattleText|1": "team's too weak!",
"text/MtMoon1F.asm|_MtMoon1FSuperNerdAfterBattleText|0": "Time to train a",
"text/MtMoon1F.asm|_MtMoon1FSuperNerdAfterBattleText|1": "tougher bunch.",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF2BattleText|0": "Hm? My pals said",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF2BattleText|1": "they'd meet me",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF2BattleText|2": "here. Seen them?",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF2EndBattleText|0": "Beaten?",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF2AfterBattleText|0": "Rumor says rare",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF2AfterBattleText|1": "old fossils hide",
"text/MtMoon1F.asm|_MtMoon1FCooltrainerF2AfterBattleText|2": "in this mountain.",
"text/MtMoon1F.asm|_MtMoon1FYoungster2BattleText|0": "Shady types have",
"text/MtMoon1F.asm|_MtMoon1FYoungster2BattleText|1": "been sneaking",
"text/MtMoon1F.asm|_MtMoon1FYoungster2BattleText|2": "around. You one?",
"text/MtMoon1F.asm|_MtMoon1FYoungster2EndBattleText|0": "Ugh,",
"text/MtMoon1F.asm|_MtMoon1FYoungster2EndBattleText|1": "you win!",
"text/MtMoon1F.asm|_MtMoon1FYoungster2AfterBattleText|0": "Dark coats, mean",
"text/MtMoon1F.asm|_MtMoon1FYoungster2AfterBattleText|1": "faces. That's",
"text/MtMoon1F.asm|_MtMoon1FYoungster2AfterBattleText|2": "GLOAM for sure!",
"text/MtMoon1F.asm|_MtMoon1FYoungster3BattleText|0": "This cave leads",
"text/MtMoon1F.asm|_MtMoon1FYoungster3BattleText|1": "out toward",
"text/MtMoon1F.asm|_MtMoon1FYoungster3BattleText|2": "BRINEFORD!",
"text/MtMoon1F.asm|_MtMoon1FYoungster3EndBattleText|1": "lost it.",
"text/MtMoon1F.asm|_MtMoon1FYoungster3AfterBattleText|0": "DUSKBIT's a pest",
"text/MtMoon1F.asm|_MtMoon1FYoungster3AfterBattleText|1": "in caves, but",
"text/MtMoon1F.asm|_MtMoon1FYoungster3AfterBattleText|2": "catch one and it",
"text/MtMoon1F.asm|_MtMoon1FYoungster3AfterBattleText|3": "pays off.",
"text/MtMoon1F.asm|_MtMoon1FBewareZubatSign|0": "Watch out! DUSKBIT",
"text/MtMoon1F.asm|_MtMoon1FBewareZubatSign|1": "sips blood!"
}