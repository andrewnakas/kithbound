{
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1Text|0": "Heh-heh-heh!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1Text|1": "My new SC is done!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1Text|2": "Nobody knows what",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1Text|3": "it'll do. Fun!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1ReceivedTM35Text|0": "<PLAYER> got",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35ExplanationText|0": "Heh-heh! That SC",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35ExplanationText|1": "holds WILD CARD.",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35ExplanationText|2": "Pure chaos!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35ExplanationText|3": "Your KITH picks a",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35ExplanationText|4": "random skill from",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35ExplanationText|5": "anywhere at all,",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35ExplanationText|6": "even unknown ones!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35NoRoomText|0": "No space in your",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist1TM35NoRoomText|1": "bag? Tidy up!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist2Text|0": "A MORPHKIT can",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist2Text|1": "grow into three",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomScientist2Text|2": "different forms!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|0": "New mail on the",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|1": "screen!",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|3": "Subject: sky lords",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|4": "FLAREKITE,",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|5": "GLACIRAVEN and",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|6": "VOLTHAWK.",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|7": "No one knows where",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|8": "they roost.",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|9": "Next we search the",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|10": "deep cave near",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|11": "BRINEFORD.",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|12": "Signed: LAB FIELD",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomPCText|13": "CREW",
"text/CinnabarLabMetronomeRoom.asm|_CinnabarLabMetronomeRoomAmberPipeText|0": "Resin-colored pipe"
}