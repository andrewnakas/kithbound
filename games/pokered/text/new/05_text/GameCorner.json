{
"text/GameCorner.asm|_GameCornerBeauty1Text|0": "Hi there!",
"text/GameCorner.asm|_GameCornerBeauty1Text|1": "Swap your tokens",
"text/GameCorner.asm|_GameCornerBeauty1Text|2": "for prizes in the",
"text/GameCorner.asm|_GameCornerBeauty1Text|3": "shop right next",
"text/GameCorner.asm|_GameCornerBeauty1Text|4": "door. Fun, right?",
"text/GameCorner.asm|_GameCornerClerk1DoYouNeedSomeGameCoinsText|0": "This is the GLOAM",
"text/GameCorner.asm|_GameCornerClerk1DoYouNeedSomeGameCoinsText|1": "PRIZE HALL!",
"text/GameCorner.asm|_GameCornerClerk1DoYouNeedSomeGameCoinsText|2": "Care to buy some",
"text/GameCorner.asm|_GameCornerClerk1DoYouNeedSomeGameCoinsText|3": "tokens?",
"text/GameCorner.asm|_GameCornerClerk1DoYouNeedSomeGameCoinsText|4": "Fifty tokens cost",
"text/GameCorner.asm|_GameCornerClerk1DoYouNeedSomeGameCoinsText|5": "¥1000. Shall I",
"text/GameCorner.asm|_GameCornerClerk1DoYouNeedSomeGameCoinsText|6": "ring you up?",
"text/GameCorner.asm|_GameCornerClerk1ThanksHereAre50CoinsText|0": "Done! Fifty shiny",
"text/GameCorner.asm|_GameCornerClerk1ThanksHereAre50CoinsText|1": "tokens for you!",
"text/GameCorner.asm|_GameCornerClerk1PleaseComePlaySometimeText|0": "Not today? Maybe",
"text/GameCorner.asm|_GameCornerClerk1PleaseComePlaySometimeText|1": "next time, then!",
"text/GameCorner.asm|_GameCornerClerk1CantAffordTheCoinsText|0": "Short on coin for",
"text/GameCorner.asm|_GameCornerClerk1CantAffordTheCoinsText|1": "that, sorry!",
"text/GameCorner.asm|_GameCornerClerk1CoinCaseIsFullText|0": "Whoa, your TOKEN",
"text/GameCorner.asm|_GameCornerClerk1CoinCaseIsFullText|1": "PURSE is stuffed!",
"text/GameCorner.asm|_GameCornerClerk1DontHaveCoinCaseText|0": "No TOKEN PURSE?",
"text/GameCorner.asm|_GameCornerClerk1DontHaveCoinCaseText|1": "Then no tokens!",
"text/GameCorner.asm|_GameCornerMiddleAgedMan1Text|0": "Psst. Don't tell.",
"text/GameCorner.asm|_GameCornerMiddleAgedMan1Text|1": "Word is, GLOAM",
"text/GameCorner.asm|_GameCornerMiddleAgedMan1Text|2": "secretly owns this",
"text/GameCorner.asm|_GameCornerMiddleAgedMan1Text|3": "whole hall.",
"text/GameCorner.asm|_GameCornerBeauty2Text|0": "Each machine pays",
"text/GameCorner.asm|_GameCornerBeauty2Text|1": "out differently,",
"text/GameCorner.asm|_GameCornerBeauty2Text|2": "I swear!",
"text/GameCorner.asm|_GameCornerFishingGuruWantToPlayText|0": "Hey, kiddo! Fancy",
"text/GameCorner.asm|_GameCornerFishingGuruWantToPlayText|1": "a spin?",
"text/GameCorner.asm|_GameCornerFishingGuruReceived10CoinsText|0": "<PLAYER> got ten",
"text/GameCorner.asm|_GameCornerFishingGuruReceived10CoinsText|1": "tokens!@",
"text/GameCorner.asm|_GameCornerFishingGuruDontNeedMyCoinsText|0": "Got plenty, huh?",
"text/GameCorner.asm|_GameCornerFishingGuruDontNeedMyCoinsText|1": "Fine by me!",
"text/GameCorner.asm|_GameCornerFishingGuruWinsComeAndGoText|0": "Lucky streaks are",
"text/GameCorner.asm|_GameCornerFishingGuruWinsComeAndGoText|1": "like the tide.",
"text/GameCorner.asm|_GameCornerMiddleAgedWomanText|0": "Ooh, the lights!",
"text/GameCorner.asm|_GameCornerMiddleAgedWomanText|1": "I love it here!",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|0": "Whoa!",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|1": "Why waste time",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|2": "here, future",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|3": "champ?",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|4": "FLORA runs the",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|5": "BLOSSBURY GYM.",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|6": "Her team grows",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|7": "from LEAF KITH!",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|8": "She seems gentle",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|9": "but she's fierce,",
"text/GameCorner.asm|_GameCornerGymGuideChampInMakingText|10": "trust me!",
"text/GameCorner.asm|_GameCornerGymGuideTheyOfferRarePokemonText|0": "You can trade",
"text/GameCorner.asm|_GameCornerGymGuideTheyOfferRarePokemonText|1": "tokens next door",
"text/GameCorner.asm|_GameCornerGymGuideTheyOfferRarePokemonText|2": "for KITH you",
"text/GameCorner.asm|_GameCornerGymGuideTheyOfferRarePokemonText|3": "can't find around.",
"text/GameCorner.asm|_GameCornerGymGuideTheyOfferRarePokemonText|4": "Too bad I lose",
"text/GameCorner.asm|_GameCornerGymGuideTheyOfferRarePokemonText|5": "every single spin!",
"text/GameCorner.asm|_GameCornerGamblerText|0": "These games bite!",
"text/GameCorner.asm|_GameCornerGamblerText|1": "One more go turns",
"text/GameCorner.asm|_GameCornerGamblerText|2": "into a hundred!",
"text/GameCorner.asm|_GameCornerClerk2WantSomeCoinsText|0": "Psst! Free tokens,",
"text/GameCorner.asm|_GameCornerClerk2WantSomeCoinsText|1": "interested?",
"text/GameCorner.asm|_GameCornerClerk2Received20CoinsText|0": "<PLAYER> got",
"text/GameCorner.asm|_GameCornerClerk2Received20CoinsText|1": "twenty tokens!@",
"text/GameCorner.asm|_GameCornerClerk2YouHaveLotsOfCoinsText|0": "Your purse looks",
"text/GameCorner.asm|_GameCornerClerk2YouHaveLotsOfCoinsText|1": "heavy already!",
"text/GameCorner.asm|_GameCornerClerk2INeedMoreCoinsText|0": "Argh! Still short",
"text/GameCorner.asm|_GameCornerClerk2INeedMoreCoinsText|1": "for the prize KITH",
"text/GameCorner.asm|_GameCornerClerk2INeedMoreCoinsText|2": "I'm saving for!",
"text/GameCorner.asm|_GameCornerGentlemanThrowingMeOffText|0": "Gah! You're",
"text/GameCorner.asm|_GameCornerGentlemanThrowingMeOffText|1": "breathing on my",
"text/GameCorner.asm|_GameCornerGentlemanThrowingMeOffText|2": "reels! Here, take",
"text/GameCorner.asm|_GameCornerGentlemanThrowingMeOffText|3": "these and scram!",
"text/GameCorner.asm|_GameCornerGentlemanReceived20CoinsText|0": "<PLAYER> got",
"text/GameCorner.asm|_GameCornerGentlemanReceived20CoinsText|1": "twenty tokens!@",
"text/GameCorner.asm|_GameCornerGentlemanYouGotYourOwnCoinsText|0": "Oh, you have a",
"text/GameCorner.asm|_GameCornerGentlemanYouGotYourOwnCoinsText|1": "pile already.",
"text/GameCorner.asm|_GameCornerGentlemanCloselyWatchTheReelsText|0": "Stare hard at the",
"text/GameCorner.asm|_GameCornerGentlemanCloselyWatchTheReelsText|1": "spinning wheels.",
"text/GameCorner.asm|_GameCornerGentlemanCloselyWatchTheReelsText|2": "That's my secret!",
"text/GameCorner.asm|_GameCornerRocketImGuardingThisPosterText|0": "This poster? It's",
"text/GameCorner.asm|_GameCornerRocketImGuardingThisPosterText|1": "off limits!",
"text/GameCorner.asm|_GameCornerRocketImGuardingThisPosterText|2": "Scram, kid!",
"text/GameCorner.asm|_GameCornerRocketBattleEndText|0": "Rats!",
"text/GameCorner.asm|_GameCornerRocketAfterBattleText|0": "Uh-oh, if they",
"text/GameCorner.asm|_GameCornerRocketAfterBattleText|1": "find our base, the",
"text/GameCorner.asm|_GameCornerRocketAfterBattleText|2": "boss will fry me!",
"text/GameCorner.asm|_GameCornerPosterSwitchBehindPosterText|0": "Huh?",
"text/GameCorner.asm|_GameCornerPosterSwitchBehindPosterText|1": "There's a button",
"text/GameCorner.asm|_GameCornerPosterSwitchBehindPosterText|2": "under the poster!",
"text/GameCorner.asm|_GameCornerPosterSwitchBehindPosterText|3": "Press it!@",
"text/GameCorner.asm|_GameCornerOopsForgotCoinCaseText|0": "Oh! No TOKEN PURSE",
"text/GameCorner.asm|_GameCornerOopsForgotCoinCaseText|1": "on me..."
}