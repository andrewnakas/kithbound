{
"text/HallOfFame.asm|_HallOfFameOakText|0": "BRAMBLE: Ahem!",
"text/HallOfFame.asm|_HallOfFameOakText|1": "Well done indeed,",
"text/HallOfFame.asm|_HallOfFameOakText|3": "Welcome to the",
"text/HallOfFame.asm|_HallOfFameOakText|4": "CROWN LEAGUE's",
"text/HallOfFame.asm|_HallOfFameOakText|5": "HALL OF FAME!",
"text/HallOfFame.asm|_HallOfFameOakText|6": "Every champion",
"text/HallOfFame.asm|_HallOfFameOakText|7": "who conquers the",
"text/HallOfFame.asm|_HallOfFameOakText|8": "LEAGUE is carved",
"text/HallOfFame.asm|_HallOfFameOakText|9": "into its records.",
"text/HallOfFame.asm|_HallOfFameOakText|10": "Their KITH, too,",
"text/HallOfFame.asm|_HallOfFameOakText|11": "are remembered",
"text/HallOfFame.asm|_HallOfFameOakText|12": "here forever.",
"text/HallOfFame.asm|_HallOfFameOakText|13": "<PLAYER>, the road",
"text/HallOfFame.asm|_HallOfFameOakText|14": "here was long and",
"text/HallOfFame.asm|_HallOfFameOakText|15": "you never quit",
"text/HallOfFame.asm|_HallOfFameOakText|16": "once!",
"text/HallOfFame.asm|_HallOfFameOakText|17": "So it's official,",
"text/HallOfFame.asm|_HallOfFameOakText|18": "<PLAYER>: you and",
"text/HallOfFame.asm|_HallOfFameOakText|19": "your partners are",
"text/HallOfFame.asm|_HallOfFameOakText|20": "legends now!"
}