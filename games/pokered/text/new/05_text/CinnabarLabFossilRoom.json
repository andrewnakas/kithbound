{
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1Text|0": "Ah! A visitor!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1Text|1": "I am DR.QUILL,",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1Text|2": "keeper of the",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1Text|3": "Revival Engine!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1Text|4": "Old bones in, live",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1Text|5": "KITH out! Got a",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1Text|6": "fossil for me?",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1NoFossilsText|0": "Empty hands? Pity!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText|0": "The Engine needs",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText|1": "time to hum.",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText|2": "Stretch your legs",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText|3": "and come back!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1FossilIsBackToLifeText|0": "There you are!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1FossilIsBackToLifeText|1": "The Engine went",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1FossilIsBackToLifeText|2": "ding! Success!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1FossilIsBackToLifeText|3": "Behold, @",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1FossilIsBackToLifeText|4": "breathing again!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|0": "Ooh! Is that",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|3": "Inside rests a",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|6": "KITH gone from the",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|7": "world for ages!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|8": "My Revival Engine",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|9": "can wake it from",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|10": "its long, long",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1SeesFossilText|11": "slumber!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1TakesFossilText|0": "Splendid! Hand it",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1TakesFossilText|1": "here, carefully!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1TakesFossilText|2": "<PLAYER> gave up",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1TakesFossilText|3": "the @",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText2|0": "Revival underway!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText2|1": "Whirr, whirr!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText2|2": "Go wander a bit,",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1GoForAWalkText2|3": "then return!",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1ComeAgainText|0": "Bring me more old",
"text/CinnabarLabFossilRoom.asm|_CinnabarLabFossilRoomScientist1ComeAgainText|1": "bones anytime!"
}