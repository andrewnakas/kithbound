{
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|0": "So you're the one,",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|1": "<PLAYER>.",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|2": "I am ORRIN, last",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|3": "of the TOP FOUR,",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|4": "rider of storms",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|5": "and WYRM KITH.",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|6": "WYRM KITH are",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|7": "older than any",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|8": "map or kingdom.",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|9": "They answer only",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|10": "to patient hands,",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|11": "and they strike",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|12": "like lightning!",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|13": "Scales like iron,",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|14": "hearts like fire!",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|15": "Tell me, are you",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|16": "prepared to fall?",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|17": "Here the climb",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|18": "stops for good,",
"text/LancesRoom.asm|_LancesRoomLanceBeforeBattleText|19": "<PLAYER>!",
"text/LancesRoom.asm|_LancesRoomLanceEndBattleText|0": "Enough!",
"text/LancesRoom.asm|_LancesRoomLanceEndBattleText|1": "I must say it:",
"text/LancesRoom.asm|_LancesRoomLanceEndBattleText|2": "you have earned a",
"text/LancesRoom.asm|_LancesRoomLanceEndBattleText|3": "master's title!",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|0": "My WYRM KITH,",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|1": "grounded at last,",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|2": "and by you,",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|3": "<PLAYER>!",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|4": "By rights you'd be",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|5": "the CROWN LEAGUE",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|6": "champion now...",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|7": "...except there",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|8": "is one final",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|9": "battle still",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|10": "ahead.",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|11": "One TAMER stands",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|12": "beyond this door.",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|13": "You know him...",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|15": "He swept the TOP",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|16": "FOUR before you!",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|17": "He holds the",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|18": "CROWN LEAGUE",
"text/LancesRoom.asm|_LancesRoomLanceAfterBattleText|19": "title!@"
}