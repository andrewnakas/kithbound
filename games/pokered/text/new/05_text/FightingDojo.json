{
"text/FightingDojo.asm|_FightingDojoKarateMasterText|0": "HUP!",
"text/FightingDojo.asm|_FightingDojoKarateMasterText|1": "I am GRANDMASTER",
"text/FightingDojo.asm|_FightingDojoKarateMasterText|2": "of the SPIRE DOJO,",
"text/FightingDojo.asm|_FightingDojoKarateMasterText|3": "first fist here!",
"text/FightingDojo.asm|_FightingDojoKarateMasterText|4": "A challenger? Then",
"text/FightingDojo.asm|_FightingDojoKarateMasterText|5": "brace yourself.",
"text/FightingDojo.asm|_FightingDojoKarateMasterText|6": "I pull no punches!",
"text/FightingDojo.asm|_FightingDojoKarateMasterText|7": "KIAAA!",
"text/FightingDojo.asm|_FightingDojoKarateMasterDefeatedText|0": "Ugh!",
"text/FightingDojo.asm|_FightingDojoKarateMasterDefeatedText|1": "My stance broke!",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|0": "So be it. You",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|1": "won fairly.",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|2": "Yet please leave",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|3": "our dojo sign on",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|4": "its wall. It is",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|5": "our pride!",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|6": "Take one of our",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|7": "finest BRAWL KITH",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|8": "instead.",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|9": "Pick the one that",
"text/FightingDojo.asm|_FightingDojoKarateMasterIWillGiveYouAPokemonText|10": "suits you!",
"text/FightingDojo.asm|_FightingDojoKarateMasterStayAndTrainWithUsText|0": "Hah!",
"text/FightingDojo.asm|_FightingDojoKarateMasterStayAndTrainWithUsText|1": "Train with us and",
"text/FightingDojo.asm|_FightingDojoKarateMasterStayAndTrainWithUsText|2": "harden that spirit",
"text/FightingDojo.asm|_FightingDojoBlackbelt1BattleText|0": "HAA! Mind the mats",
"text/FightingDojo.asm|_FightingDojoBlackbelt1BattleText|1": "with those boots!",
"text/FightingDojo.asm|_FightingDojoBlackbelt1EndBattleText|0": "Enough,",
"text/FightingDojo.asm|_FightingDojoBlackbelt1EndBattleText|1": "enough!",
"text/FightingDojo.asm|_FightingDojoBlackbelt1AfterBattleText|0": "Our GRANDMASTER",
"text/FightingDojo.asm|_FightingDojoBlackbelt1AfterBattleText|1": "is another level.",
"text/FightingDojo.asm|_FightingDojoBlackbelt1AfterBattleText|2": "Next to him, I'm a",
"text/FightingDojo.asm|_FightingDojoBlackbelt1AfterBattleText|3": "mere pebble!",
"text/FightingDojo.asm|_FightingDojoBlackbelt2BattleText|0": "Word says you're",
"text/FightingDojo.asm|_FightingDojoBlackbelt2BattleText|1": "tough. Prove it!",
"text/FightingDojo.asm|_FightingDojoBlackbelt2EndBattleText|0": "Point to",
"text/FightingDojo.asm|_FightingDojoBlackbelt2EndBattleText|1": "you!",
"text/FightingDojo.asm|_FightingDojoBlackbelt2AfterBattleText|0": "GRANDMASTER beat",
"text/FightingDojo.asm|_FightingDojoBlackbelt2AfterBattleText|1": "a bear once. True!",
"text/FightingDojo.asm|_FightingDojoBlackbelt3BattleText|0": "No foe scares me!",
"text/FightingDojo.asm|_FightingDojoBlackbelt3BattleText|1": "Pain is nothing!",
"text/FightingDojo.asm|_FightingDojoBlackbelt3BattleText|2": "I punch logs every",
"text/FightingDojo.asm|_FightingDojoBlackbelt3BattleText|3": "morning!",
"text/FightingDojo.asm|_FightingDojoBlackbelt3EndBattleText|0": "Ow!",
"text/FightingDojo.asm|_FightingDojoBlackbelt3EndBattleText|1": "My knuckles!",
"text/FightingDojo.asm|_FightingDojoBlackbelt3AfterBattleText|0": "Truth be told,",
"text/FightingDojo.asm|_FightingDojoBlackbelt3AfterBattleText|1": "mind-bending KITH",
"text/FightingDojo.asm|_FightingDojoBlackbelt3AfterBattleText|2": "spook us silly.",
"text/FightingDojo.asm|_FightingDojoBlackbelt4BattleText|0": "HYAAH!",
"text/FightingDojo.asm|_FightingDojoBlackbelt4BattleText|1": "Who said you could",
"text/FightingDojo.asm|_FightingDojoBlackbelt4BattleText|2": "set foot in this",
"text/FightingDojo.asm|_FightingDojoBlackbelt4BattleText|3": "DOJO?",
"text/FightingDojo.asm|_FightingDojoBlackbelt4EndBattleText|0": "Gah!",
"text/FightingDojo.asm|_FightingDojoBlackbelt4EndBattleText|1": "Mercy!",
"text/FightingDojo.asm|_FightingDojoBlackbelt4AfterBattleText|0": "Fighters from all",
"text/FightingDojo.asm|_FightingDojoBlackbelt4AfterBattleText|1": "over come to",
"text/FightingDojo.asm|_FightingDojoBlackbelt4AfterBattleText|2": "sweat here.",
"text/FightingDojo.asm|_FightingDojoHitmonleePokeBallText|0": "Take KICKSTER, the",
"text/FightingDojo.asm|_FightingDojoHitmonleePokeBallText|1": "one with legs like",
"text/FightingDojo.asm|_FightingDojoHitmonleePokeBallText|2": "springs?",
"text/FightingDojo.asm|_FightingDojoHitmonchanPokeBallText|0": "Take JABBERFIST,",
"text/FightingDojo.asm|_FightingDojoHitmonchanPokeBallText|1": "the rapid-fire",
"text/FightingDojo.asm|_FightingDojoHitmonchanPokeBallText|2": "boxer?",
"text/FightingDojo.asm|_FightingDojoBetterNotGetGreedyText|0": "One is plenty.",
"text/FightingDojo.asm|_FightingDojoBetterNotGetGreedyText|1": "Just one, please!"
}