{
"text/Museum1F.asm|_Museum1FScientist1ComeAgainText|0": "Do visit again!",
"text/Museum1F.asm|_Museum1FScientist1WouldYouLikeToComeInText|0": "Kids get in for",
"text/Museum1F.asm|_Museum1FScientist1WouldYouLikeToComeInText|1": "just ¥50.",
"text/Museum1F.asm|_Museum1FScientist1WouldYouLikeToComeInText|2": "Want a ticket for",
"text/Museum1F.asm|_Museum1FScientist1WouldYouLikeToComeInText|3": "the halls?",
"text/Museum1F.asm|_Museum1FScientist1ThankYouText|0": "¥50, lovely.",
"text/Museum1F.asm|_Museum1FScientist1ThankYouText|1": "Enjoy the show!",
"text/Museum1F.asm|_Museum1FScientist1DontHaveEnoughMoneyText|0": "Oh, your purse is",
"text/Museum1F.asm|_Museum1FScientist1DontHaveEnoughMoneyText|1": "a bit light.",
"text/Museum1F.asm|_Museum1FScientist1DoYouKnowWhatAmberIsText|0": "Hey! That's the",
"text/Museum1F.asm|_Museum1FScientist1DoYouKnowWhatAmberIsText|1": "staff door!",
"text/Museum1F.asm|_Museum1FScientist1DoYouKnowWhatAmberIsText|2": "Ah, never mind.",
"text/Museum1F.asm|_Museum1FScientist1DoYouKnowWhatAmberIsText|3": "Say, ever heard",
"text/Museum1F.asm|_Museum1FScientist1DoYouKnowWhatAmberIsText|4": "of RESIN?",
"text/Museum1F.asm|_Museum1FScientist1TheresALabSomewhereText|0": "Rumor has it a",
"text/Museum1F.asm|_Museum1FScientist1TheresALabSomewhereText|1": "lab is reviving",
"text/Museum1F.asm|_Museum1FScientist1TheresALabSomewhereText|2": "long-lost KITH",
"text/Museum1F.asm|_Museum1FScientist1TheresALabSomewhereText|3": "trapped inside",
"text/Museum1F.asm|_Museum1FScientist1TheresALabSomewhereText|4": "old RESIN.",
"text/Museum1F.asm|_Museum1FScientist1AmberIsFossilizedTreeSapText|0": "RESIN is tree sap",
"text/Museum1F.asm|_Museum1FScientist1AmberIsFossilizedTreeSapText|1": "turned to stone.",
"text/Museum1F.asm|_Museum1FScientist1GoToOtherSideText|0": "Use the main door,",
"text/Museum1F.asm|_Museum1FScientist1GoToOtherSideText|1": "please!",
"text/Museum1F.asm|_Museum1FScientist1TakePlentyOfTimeText|0": "No rush. Enjoy",
"text/Museum1F.asm|_Museum1FScientist1TakePlentyOfTimeText|1": "every exhibit!",
"text/Museum1F.asm|_Museum1FGamblerText|0": "Look at the size",
"text/Museum1F.asm|_Museum1FGamblerText|1": "of those bones!",
"text/Museum1F.asm|_Museum1FGamblerText|2": "Wow!",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|0": "Psst! I'm sure",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|1": "this lump of",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|2": "RESIN holds some",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|3": "ancient KITH!",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|4": "Imagine if we",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|5": "could bring it",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|6": "back to life!",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|7": "Incredible!",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|8": "Nobody else here",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|9": "listens to me.",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|10": "So, a favor,",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|11": "please!",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|12": "Carry this to a",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|13": "KITH lab and have",
"text/Museum1F.asm|_Museum1FScientist2TakeThisToAPokemonLabText|14": "them study it!",
"text/Museum1F.asm|_Museum1FScientist2ReceivedOldAmberText|0": "<PLAYER> got the",
"text/Museum1F.asm|_Museum1FScientist2ReceivedOldAmberText|1": "OLD RESIN!@",
"text/Museum1F.asm|_Museum1FScientist2GetTheOldAmberCheckText|0": "Psst! Did a lab",
"text/Museum1F.asm|_Museum1FScientist2GetTheOldAmberCheckText|1": "see the RESIN yet?",
"text/Museum1F.asm|_Museum1FScientist2YouDontHaveSpaceText|0": "Your bag can't fit",
"text/Museum1F.asm|_Museum1FScientist2YouDontHaveSpaceText|1": "it, I'm afraid.",
"text/Museum1F.asm|_Museum1FScientist3Text|0": "Our pride: two",
"text/Museum1F.asm|_Museum1FScientist3Text|1": "skeletons of KITH",
"text/Museum1F.asm|_Museum1FScientist3Text|2": "from the dawn of",
"text/Museum1F.asm|_Museum1FScientist3Text|3": "time!",
"text/Museum1F.asm|_Museum1FOldAmberText|0": "A honey-gold lump",
"text/Museum1F.asm|_Museum1FOldAmberText|1": "of RESIN. Pretty!"
}