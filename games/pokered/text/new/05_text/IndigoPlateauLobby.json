{
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|0": "Hey! Almost-champ!",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|1": "Listen close!",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|2": "Inside, the TOP",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|3": "FOUR wait. You",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|4": "fight all four,",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|5": "back to back.",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|6": "Lose once and it's",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|7": "back to the start!",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|8": "Deep breath now.",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyGymGuideText|9": "You've got this!",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyCooltrainerFText|0": "Past this hall,",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyCooltrainerFText|1": "the TOP FOUR wait",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyCooltrainerFText|2": "in a row of rooms.",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyCooltrainerFText|3": "Beat each one and",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyCooltrainerFText|4": "the next door",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyCooltrainerFText|5": "unlocks!",
"text/IndigoPlateauLobby.asm|_IndigoPlateauLobbyCooltrainerFText|6": "Stay strong!"
}