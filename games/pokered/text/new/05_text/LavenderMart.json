{
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|0": "I'm hunting for",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|1": "boosters that work",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|2": "for one battle",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|3": "only. Handy little",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|4": "battle tonics.",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|5": "SPARK SHOT, QUICK",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|6": "SHOT, POWER SHOT,",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|7": "and SHELL SHOT!",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|8": "I want them all.",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|9": "Any idea who",
"text/LavenderMart.asm|_LavenderMartBaldingGuyText|10": "sells them?",
"text/LavenderMart.asm|_LavenderMartCooltrainerMReviveText|0": "Carry ROUSERs!",
"text/LavenderMart.asm|_LavenderMartCooltrainerMReviveText|1": "They wake a KITH",
"text/LavenderMart.asm|_LavenderMartCooltrainerMReviveText|2": "that has fainted.",
"text/LavenderMart.asm|_LavenderMartCooltrainerMNuggetText|0": "Dug up a GOLD LUMP",
"text/LavenderMart.asm|_LavenderMartCooltrainerMNuggetText|1": "on a hike once.",
"text/LavenderMart.asm|_LavenderMartCooltrainerMNuggetText|2": "Thought it was",
"text/LavenderMart.asm|_LavenderMartCooltrainerMNuggetText|3": "junk, but a shop",
"text/LavenderMart.asm|_LavenderMartCooltrainerMNuggetText|4": "paid ¥5000!"
}