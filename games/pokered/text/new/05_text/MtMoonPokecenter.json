{
"text/MtMoonPokecenter.asm|_MtMoonPokecenterYoungsterText|0": "My belt has room",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterYoungsterText|1": "for six SNAREs.",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterYoungsterText|2": "A TAMER can only",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterYoungsterText|3": "bring six KITH.",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterGentlemanText|0": "GLOAM agents keep",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterGentlemanText|1": "bullying BRINEFORD",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterGentlemanText|2": "folks...",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterGentlemanText|3": "They're in the",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterGentlemanText|4": "paper every",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterGentlemanText|5": "single day!",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanIGotADealText|0": "MAN: Psst, friend!",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanIGotADealText|1": "A one-time offer,",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanIGotADealText|2": "only for you!",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanIGotADealText|3": "This magnificent",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanIGotADealText|4": "SPLASHLING can be",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanIGotADealText|5": "yours for ¥500!",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanIGotADealText|6": "Deal or no deal?",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanNoText|0": "No? But I'm being",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanNoText|1": "SO generous here!",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanNoText|2": "Your loss!",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanNoMoneyText|0": "Ha! Your wallet's",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanNoMoneyText|1": "too light, pal!",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanNoRefundsText|0": "MAN: All sales",
"text/MtMoonPokecenter.asm|_MtMoonPokecenterMagikarpSalesmanNoRefundsText|1": "are final, pal!"
}