{
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|0": "So. The doors",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|1": "opened for you.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|2": "I am NEVE, first",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|3": "of the TOP FOUR.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|4": "My KITH were born",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|5": "where winter never",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|6": "lets go.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|7": "Frost is patient.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|8": "It always wins.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|9": "Once your KITH",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|10": "are locked in ice,",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|11": "they will move",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|12": "for no one.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|13": "Now then.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiBeforeBattleText|14": "Shall we begin?",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiEndBattleText|0": "Thawed...",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiEndBattleText|1": "by a child?",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiAfterBattleText|0": "Hm. Warmer than",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiAfterBattleText|1": "you look.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiAfterBattleText|2": "Go on, then.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiAfterBattleText|3": "But that chill",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiAfterBattleText|4": "was only the first",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiAfterBattleText|5": "of four storms.",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiDontRunAwayText|0": "A cold voice:",
"text/LoreleisRoom.asm|_LoreleisRoomLoreleiDontRunAwayText|1": "Leaving so soon?"
}