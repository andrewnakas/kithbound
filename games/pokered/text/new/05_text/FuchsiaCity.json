{
"text/FuchsiaCity.asm|_FuchsiaCityYoungster1Text|0": "Played the WILD",
"text/FuchsiaCity.asm|_FuchsiaCityYoungster1Text|1": "PARK GAME yet? It",
"text/FuchsiaCity.asm|_FuchsiaCityYoungster1Text|2": "has KITH you won't",
"text/FuchsiaCity.asm|_FuchsiaCityYoungster1Text|3": "see anywhere else.",
"text/FuchsiaCity.asm|_FuchsiaCityGamblerText|0": "Front of WILD PARK",
"text/FuchsiaCity.asm|_FuchsiaCityGamblerText|1": "is a little zoo.",
"text/FuchsiaCity.asm|_FuchsiaCityGamblerText|2": "Look but no touch!",
"text/FuchsiaCity.asm|_FuchsiaCityGamblerText|3": "Behind it's the",
"text/FuchsiaCity.asm|_FuchsiaCityGamblerText|4": "real deal: catch",
"text/FuchsiaCity.asm|_FuchsiaCityGamblerText|5": "KITH in the wild!",
"text/FuchsiaCity.asm|_FuchsiaCityErikText|0": "COLE: NELL's late.",
"text/FuchsiaCity.asm|_FuchsiaCityErikText|1": "We were going to",
"text/FuchsiaCity.asm|_FuchsiaCityErikText|2": "meet up here.",
"text/FuchsiaCity.asm|_FuchsiaCityYoungster2Text|0": "That ball on the",
"text/FuchsiaCity.asm|_FuchsiaCityYoungster2Text|1": "ground there? It's",
"text/FuchsiaCity.asm|_FuchsiaCityYoungster2Text|2": "a KITH, asleep!",
"text/FuchsiaCity.asm|_FuchsiaCitySignText|0": "MARSHGATE",
"text/FuchsiaCity.asm|_FuchsiaCitySignText|1": "Reeds, Mist and",
"text/FuchsiaCity.asm|_FuchsiaCitySignText|2": "Quiet Footsteps",
"text/FuchsiaCity.asm|_FuchsiaCitySafariGameSignText|0": "THE PARK HUNT",
"text/FuchsiaCity.asm|_FuchsiaCitySafariGameSignText|1": "Snare What You See",
"text/FuchsiaCity.asm|_FuchsiaCityWardensHomeSignText|0": "Home of the",
"text/FuchsiaCity.asm|_FuchsiaCityWardensHomeSignText|1": "PARK WARDEN",
"text/FuchsiaCity.asm|_FuchsiaCitySafariZoneSignText|0": "WILD PARK",
"text/FuchsiaCity.asm|_FuchsiaCitySafariZoneSignText|1": "Where KITH Roam",
"text/FuchsiaCity.asm|_FuchsiaCityGymSignText|0": "MARSHGATE GYM",
"text/FuchsiaCity.asm|_FuchsiaCityGymSignText|1": "Keeper: HEMLOCK",
"text/FuchsiaCity.asm|_FuchsiaCityGymSignText|2": "Master of the",
"text/FuchsiaCity.asm|_FuchsiaCityGymSignText|3": "Unseen Sting",
"text/FuchsiaCity.asm|_FuchsiaCityGymSignText|4": "and Silent Step",
"text/FuchsiaCity.asm|_FuchsiaCityChanseySignText|0": "Zoo: MEDIEGG",
"text/FuchsiaCity.asm|_FuchsiaCityChanseySignText|1": "Rare and kind.",
"text/FuchsiaCity.asm|_FuchsiaCityChanseySignText|2": "Lucky if you see!",
"text/FuchsiaCity.asm|_FuchsiaCityVoltorbSignText|0": "Zoo: FUSEBALL",
"text/FuchsiaCity.asm|_FuchsiaCityVoltorbSignText|1": "Looks like a SNARE",
"text/FuchsiaCity.asm|_FuchsiaCityVoltorbSignText|2": "with a fuse. Ha!",
"text/FuchsiaCity.asm|_FuchsiaCityKangaskhanSignText|0": "Zoo: MARSUPRIME",
"text/FuchsiaCity.asm|_FuchsiaCityKangaskhanSignText|1": "A doting mother,",
"text/FuchsiaCity.asm|_FuchsiaCityKangaskhanSignText|2": "she carries her",
"text/FuchsiaCity.asm|_FuchsiaCityKangaskhanSignText|3": "baby everywhere",
"text/FuchsiaCity.asm|_FuchsiaCityKangaskhanSignText|4": "in her pouch.",
"text/FuchsiaCity.asm|_FuchsiaCitySlowpokeSignText|0": "Zoo: DAWDLUG",
"text/FuchsiaCity.asm|_FuchsiaCitySlowpokeSignText|1": "Gentle. Takes all",
"text/FuchsiaCity.asm|_FuchsiaCitySlowpokeSignText|2": "day to blink.",
"text/FuchsiaCity.asm|_FuchsiaCityLaprasSignText|0": "Zoo: SEAFERRY",
"text/FuchsiaCity.asm|_FuchsiaCityLaprasSignText|1": "Carries travelers",
"text/FuchsiaCity.asm|_FuchsiaCityLaprasSignText|2": "over the waves.",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignOmanyteText|0": "Zoo: AMMONIX",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignOmanyteText|1": "Extinct, then",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignOmanyteText|2": "revived from an",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignOmanyteText|3": "old stone fossil.",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignKabutoText|0": "Zoo: TRILOBYTE",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignKabutoText|1": "Once lost to time,",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignKabutoText|2": "now brought back",
"text/FuchsiaCity.asm|_FuchsiaCityFossilSignKabutoText|3": "by lab science."
