{
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseMiddleAgedWomanText|0": "The WILD PARK's",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseMiddleAgedWomanText|1": "WARDEN is ancient,",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseMiddleAgedWomanText|2": "yet still spry.",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseMiddleAgedWomanText|3": "Mind you, he lost",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseMiddleAgedWomanText|4": "his real teeth.",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseBillsGrandpaText|0": "Eh? You know my",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseBillsGrandpaText|1": "PIP?",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseBillsGrandpaText|2": "My grandson, yes!",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseBillsGrandpaText|3": "As a tot he'd",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseBillsGrandpaText|4": "hoard bottle caps,",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseBillsGrandpaText|5": "shells, anything!",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseYoungsterText|0": "PIP keeps notes on",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseYoungsterText|1": "every KITH on his",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseYoungsterText|2": "computer!",
"text/FuchsiaBillsGrandpasHouse.asm|_FuchsiaBillsGrandpasHouseYoungsterText|3": "Seen them yet?"
}